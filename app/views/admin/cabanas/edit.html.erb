<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4">Editar Cabana</h1>

  <%= form_with model: [:admin, @cabana], method: :patch, local: true do |form| %>
    <div class="mb-3">
      <%= form.label :name, 'Nome', class: 'form-label' %>
      <%= form.text_field :name, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :price, 'Preço', class: 'form-label' %>
      <%= form.number_field :price, step: 0.01, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :filial_id, 'Filial', class: 'form-label' %>
      <%= form.collection_select :filial_id, Filial.all, :id, :name, {}, { class: 'form-select' } %>
    </div>

    <div class="mb-3">
      <%= form.label :images, 'Adicionar Novas Imagens', class: 'form-label' %>
      <%= form.file_field :images, multiple: true, class: 'form-control' %>
    </div>

    <% if @cabana.images.attached? %>
      <p class="mt-2">Imagens Existentes:</p>
      <ul class="list-unstyled d-flex gap-2">
        <% @cabana.images.each do |image| %>
          <li class="position-relative">
            <img src="<%= image.url %>" alt="<%= @cabana.name %> Image" class="rounded-md">
            <%= button_to 'Remover', remove_image_admin_cabana_path(@cabana, image.id), method: :delete, data: { confirm: 'Tem certeza que deseja remover esta imagem?' }, class: 'btn btn-sm btn-danger position-absolute top-0 end-0' %>
          </li>
        <% end %>
      </ul>
    <% end %>


    <div class="d-flex gap-2 mt-4">
      <%= form.submit 'Salvar', class: 'btn btn-primary' %>
      <%= link_to 'Cancelar', admin_cabanas_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
