<% content_for :title, "Serviços comprados - Villaggio Girotto" %>
<% grouped_services = @purchased_services.group_by { |item| [item.service_id, item.service_date, item.observation.to_s.strip, item.unit_price_paid] } %>

<div class="min-h-screen bg-[#f7f5f0]">
  <header class="bg-[#1a2e1a] text-white px-4 py-5 shadow-lg">
    <div class="max-w-3xl mx-auto flex items-center justify-between gap-4">
      <%= link_to portal_reserva_inicio_path, class: "text-white/70 hover:text-white text-sm" do %>← Voltar<% end %>
      <div class="text-right">
        <p class="text-white/50 text-xs uppercase tracking-widest">Reserva #<%= @reserva.id %></p>
        <h1 class="text-lg font-bold">Serviços comprados</h1>
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <% if grouped_services.any? || @operational_services.any? %>
      <div class="bg-white border border-gray-200 rounded-lg shadow-sm divide-y divide-gray-100">
        <% grouped_services.each_value do |items| %>
          <% first_item = items.first %>
          <% quantity = items.sum { |item| item.quantity.to_i } %>
          <% unit_price = first_item.unit_price_paid || first_item.service.price_for(@reserva) || 0 %>
          <div class="p-5 flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="font-semibold text-[#1a2e1a]"><%= first_item.service.name %></h2>
              <p class="text-sm text-gray-500 mt-1">
                <%= quantity %> <%= quantity == 1 ? "unidade" : "unidades" %>
                <% if first_item.service_date.present? %> · <%= first_item.service_date.strftime("%d/%m/%Y") %><% end %>
              </p>
              <% if first_item.observation.present? %>
                <p class="text-sm text-gray-600 mt-2">Observação: <%= first_item.observation %></p>
              <% end %>
            </div>
            <div class="text-right shrink-0">
              <% if first_item.cancelled? %>
                <span class="inline-block text-xs font-semibold bg-red-50 text-red-700 rounded px-2 py-1">Cancelado</span>
              <% elsif first_item.payment_status == "paid" %>
                <span class="inline-block text-xs font-semibold bg-green-50 text-green-700 rounded px-2 py-1">Pago</span>
              <% else %>
                <span class="inline-block text-xs font-semibold bg-blue-50 text-blue-700 rounded px-2 py-1">Confirmado</span>
              <% end %>
              <p class="font-semibold text-[#1a2e1a] mt-2"><%= number_to_currency(unit_price * quantity) %></p>
            </div>
          </div>
        <% end %>

        <% @operational_services.each do |service| %>
          <div class="p-5 flex items-start justify-between gap-4">
            <div>
              <h2 class="font-semibold text-[#1a2e1a]"><%= service[:name] %></h2>
              <p class="text-sm text-gray-500 mt-1"><%= service[:date]&.strftime("%d/%m/%Y") %></p>
            </div>
            <span class="inline-block text-xs font-semibold bg-blue-50 text-blue-700 rounded px-2 py-1">Confirmado</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white border border-dashed border-gray-300 rounded-lg py-14 px-5 text-center">
        <h2 class="font-semibold text-[#1a2e1a]">Nenhum serviço comprado</h2>
        <p class="text-sm text-gray-500 mt-1">Os serviços vinculados à reserva aparecerão aqui.</p>
      </div>
    <% end %>
  </main>
</div>
