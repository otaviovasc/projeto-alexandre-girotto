<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <style>
      .shadow-on-scroll {
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
      }

      /* Menu para mobile */
      #menu-container {
        transition: transform 0.5s ease-in-out;
      }

      .menu-mobile-open {
        transform: translateX(0);
      }

      .menu-mobile-close {
        transform: translateX(-100%);
      }

      /* Overlay para mobile */
      #menu-overlay.active {
        opacity: 0.5;
        pointer-events: auto;
      }

      /* Submenu */
      .submenu-cabanas {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-in-out;
      }

      .submenu-cabanas.open {
        max-height: 200px;
      }
    </style>

</head>

<body>
    <div id="menu-overlay"
        class="fixed inset-0 z-10 bg-black opacity-0 pointer-events-none transition-opacity duration-1000 sm:hidden">
    </div>

    <div id="menu-container"
        class="h-screen px-8 pt-32 pb-8 font-dm font-normal text-gray-500 fixed top-0 left-0 w-full bg-white z-50 transform -translate-x-full menu-desktop-close transition-transform duration-700 ease-in-out flex flex-col justify-between">
        <div class="fixed top-4 left-4">
            <button id="close-menu">
                <i class="bi bi-x text-preto-fill text-5xl block"></i>
            </button>
        </div>
        <div class="text-lg flex flex-col gap-4 leading-8">
            <!-- Links do menu -->
            <div>
                <div class="flex gap-2 items-center">
                    <button class="hover:text-terracota">
                        <%= link_to "Ver Cabanas" , cabanas_path %>
                    </button>
                </div>
            </div>
            <p class="hover:text-terracota botao-home">
                <%= link_to "Home" , "/" %>
            </p>
            <p class="hover:text-terracota">
                <%= link_to "Sustentabilidade" , "/sustentabilidade" %>
            </p>
            <p class="hover:text-terracota">
                <%= link_to "Experiências" , "/experiencias" %>
            </p>
            <p class="hover:text-terracota">
                <%= link_to "Sobre Nós" , "/about" %>
            </p>
        </div>
        <div class="flex items-center gap-4">
            <a href="#">
                <%= link_to "Login" , new_user_session_path, class: "font-alice text-lg hover:text-terracota font-bold"
                    %>
            </a>
        </div>
    </div>

    <div class="z-10 fixed top-0 left-0 py-2 px-4 w-full header-bg bg-creme flex items-center justify-between">
        <i class="bi bi-list-nested text-3xl icon-color z-10" id="open-menu"></i>
        <div class="ml-auto fixed top-0 right-0 p-4 header-bg bg-transparent flex items-center justify-between gap-2"
            id="open-reserva">
            <p class="font-dm uppercase text-base">
                <%= link_to "Reservar" , cabanas_path %>
            </p>
            <i class="fa-solid fa-chevron-right text-xs" id="setinha"></i>
        </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const openMenuButton = document.getElementById('open-menu');
        const closeMenuButton = document.getElementById('close-menu');
        const menuContainer = document.getElementById('menu-container');
        const menuOverlay = document.getElementById('menu-overlay');

        // Verifica se é mobile
        const isMobile = () => window.innerWidth < 768;

        // Função para abrir o menu
        const openMenu = () => {
          if (isMobile()) {
            menuContainer.classList.remove('menu-mobile-close');
            menuContainer.classList.add('menu-mobile-open');
            menuOverlay.classList.add('active');
            document.body.classList.add('overflow-hidden');
          } else {
            menuContainer.classList.remove('menu-desktop-close');
            menuContainer.classList.add('menu-desktop-open');
          }
        };

        // Função para fechar o menu
        const closeMenu = () => {
          if (isMobile()) {
            menuContainer.classList.remove('menu-mobile-open');
            menuContainer.classList.add('menu-mobile-close');
            menuOverlay.classList.remove('active');
            document.body.classList.remove('overflow-hidden');
          } else {
            menuContainer.classList.remove('menu-desktop-open');
            menuContainer.classList.add('menu-desktop-close');
          }
        };

        // Eventos de clique
        openMenuButton.addEventListener('click', openMenu);
        closeMenuButton.addEventListener('click', closeMenu);
        menuOverlay.addEventListener('click', closeMenu);

        // Responsividade ao redimensionar tela
        window.addEventListener('resize', () => {
          if (!isMobile()) {
            menuContainer.classList.add('menu-desktop-close');
            menuContainer.classList.remove('menu-mobile-open', 'menu-mobile-close');
            menuOverlay.classList.remove('active');
          }
        });

        // Efeito do Header ao Rolar
        const header = document.querySelector('.header-bg');
        const menuIcon = document.querySelector('.icon-color');
        const reservar = document.getElementById('open-reserva');
        const setinha = document.getElementById('setinha');
        const botaoHome = document.querySelector('.botao-home');

        if (window.location.pathname === '/') {
          botaoHome.classList.add('hidden');
        }

        if (window.location.pathname === '/' || window.location.pathname === '/sustentabilidade') {
          header.classList.add('bg-transparent');
          menuIcon.classList.add('text-creme');
          reservar.classList.add('text-creme');
          setinha.classList.add('text-creme');

          window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
              header.classList.add('bg-creme', 'shadow-on-scroll');
              header.classList.remove('bg-transparent');
              menuIcon.classList.add('text-terracota');
              menuIcon.classList.remove('text-creme');
              reservar.classList.add('text-terracota');
              reservar.classList.remove('text-creme');
              setinha.classList.add('text-terracota');
            } else {
              header.classList.remove('bg-creme', 'shadow-on-scroll');
              header.classList.add('bg-transparent');
              menuIcon.classList.add('text-creme');
              menuIcon.classList.remove('text-terracota');
              reservar.classList.add('text-creme');
              reservar.classList.remove('text-terracota');
              setinha.classList.remove('text-terracota');
            }
          });
        } else {
          header.classList.add('bg-creme', 'shadow-on-scroll');
          header.classList.remove('bg-transparent');
          menuIcon.classList.add('text-terracota');
          menuIcon.classList.remove('text-creme');
          reservar.classList.add('text-terracota');
          reservar.classList.remove('text-creme');
        }
      });
    </script>

</body>
