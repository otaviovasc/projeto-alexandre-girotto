<div class="bg-white rounded-md w-full max-w-4xl mx-auto p-6 flex flex-col gap-6 shadow-md">

  <!-- Status de pagamento -->
  <div class="flex flex-col items-center text-center gap-4 p-6">
    <% if @reserva.payment_status == "paid" %>
      <h1 class="text-2xl font-semibold text-green-600 flex items-center gap-2">
        <i class="bi bi-check-circle-fill"></i> Pagamento confirmado! Obrigado 🎉
      </h1>

      <% if @reserva.cabana.link_guia.present? %>
        <div class="bg-gray-100 p-4 rounded-lg shadow-md w-full max-w-lg text-center">
          <h2 class="text-xl font-semibold text-gray-800 mb-2">
            📖 Guia da Cabana: Sua experiência começa agora!
          </h2>
          <p class="text-gray-600 text-sm mb-4">
            Explore tudo o que sua hospedagem tem a oferecer. Clique no botão abaixo para acessar o guia completo!
          </p>
          <a href="<%= @reserva.cabana.link_guia %>" target="_blank"
             class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-full transition-all flex items-center justify-center gap-2">
            <i class="bi bi-file-earmark-pdf-fill"></i> Acessar Guia da Cabana
          </a>
        </div>
      <% end %>

    <% else %>
      <h1 class="text-2xl font-semibold text-orange-500 flex items-center gap-2">
        <i class="bi bi-exclamation-circle-fill"></i> Reservado! Aguardando pagamento.
      </h1>
      <p class="text-gray-700 font-medium">
        <strong>Status do pagamento:</strong>
        <%= @reserva.payment_status.present? ? @reserva.payment_status.humanize : 'Indefinido' %>
      </p>
    <% end %>
  </div>

  <!-- Botão de Pagamento ou Slider -->
  <% if @reserva.payment_status.in?(["pending", "refused", "waiting_payment"]) %>
    <div class="flex justify-center">
      <%= link_to '<i class="bi bi-credit-card-fill"></i> &nbsp Pagar Reserva'.html_safe, pay_reserva_path(@reserva),
          class: 'bg-verde-escuro text-white px-4 py-2 rounded-md text-sm font-dm hover:bg-verde-escuro-hover transition d-flex align-items-center gap-2' %>
    </div>
  <% else %>
    <div class="flex flex-col items-center m-8">
      <%= render partial: "shared/cabana_show_slider", locals: { cabana: @reserva.cabana, images: @reserva.cabana.images } %>
    </div>
  <% end %>

  <!-- Detalhes da Reserva -->
  <div class="flex flex-col gap-4 border-t border-gray-300 pt-4">
    <h2 class="font-alice text-lg text-verde-escuro">
      <i class="bi bi-info-circle-fill"></i> Detalhes da Reserva
    </h2>
    <p><strong>🏡 Cabana:</strong> <%= @reserva.cabana.name %></p>
    <p><strong>📅 Data de Início:</strong> <%= @reserva.start_date.strftime("%d/%m/%Y") %></p>
    <p><strong>📅 Data de Fim:</strong> <%= @reserva.end_date.strftime("%d/%m/%Y") %></p>
    <p><strong>💰 Preço Total:</strong> <%= number_to_currency(@reserva.total_price) %></p>
  </div>

  <!-- Serviços da Reserva -->
  <div class="flex flex-col gap-6 border-t border-gray-300 pt-4">
    <!-- Serviços Adicionais -->
    <h2 class="font-alice text-lg text-verde-escuro flex items-center gap-2">
      <i class="bi bi-tools"></i> Serviços Adicionais
    </h2>

    <% if @reserva_services.any? %>
      <div class="space-y-4">
        <% @reserva_services.each do |reserva_service| %>
          <div class="bg-white border border-gray-200 p-4 rounded-lg shadow-sm">
            <div class="flex justify-between items-center">
              <div>
                <strong class="text-gray-800">Serviço:</strong> <%= reserva_service.service.name %>
              </div>
              <div class="text-sm text-gray-500">
                <strong>Data:</strong>
                <% service_date = reserva_service.service_date || reserva_service.created_at.to_date %>
                <p><%= service_date.strftime("%d/%m/%Y") %></p>
              </div>
            </div>
            <div class="mt-2">
              <strong class="text-gray-800">Preço:</strong> <%= number_to_currency(reserva_service.unit_price_paid || reserva_service.service.price_for(@reserva)) %>
            </div>
            <div>
              <strong class="text-gray-800">Quantidade:</strong> <%= reserva_service.quantity %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-600">Nenhum serviço adicional adquirido.</p>
    <% end %>

    <div class="flex justify-center">
      <%= link_to '<i class="bi bi-basket2"></i> &nbsp Ver serviços disponíveis'.html_safe, services_marketplace_index_path,
          class: 'bg-verde-escuro text-white px-4 py-2 rounded-md text-sm font-dm hover:bg-verde-escuro-hover transition d-flex align-items-center gap-2' %>
    </div>
  </div>

  <!-- Itens Adquiridos -->
  <div class="flex flex-col gap-6 border-t border-gray-300 pt-4">
    <h2 class="font-alice text-lg text-verde-escuro flex items-center gap-2">
      <i class="bi bi-box"></i> Itens Adquiridos
    </h2>

    <% if @reserva_items.any? %>
      <div class="space-y-4">
        <% @reserva_items.each do |reserva_item| %>
          <div class="bg-white border border-gray-200 p-4 rounded-lg shadow-sm">
            <div class="flex justify-between items-center">
              <div>
                <strong class="text-gray-800">Item:</strong> <%= reserva_item.item.name %>
              </div>
              <div class="text-sm text-gray-500">
                <strong>Data:</strong> <p id="created_at"><%= reserva_item.created_at.strftime("%H:%M %d/%m/%Y") %></p>
              </div>
            </div>
            <div class="mt-2">
              <strong class="text-gray-800">Preço:</strong> <%= number_to_currency(reserva_item.item.price) %>
            </div>
            <div class="mt-2">
              <strong class="text-gray-800">Quantidade:</strong> <%= reserva_item.quantity %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-600">Nenhum item adquirido para esta reserva.</p>
    <% end %>

    <div class="flex justify-center">
      <%= link_to '<i class="bi bi-bag-check"></i> &nbsp Ver itens disponíveis'.html_safe, items_marketplace_index_path,
          class: 'bg-verde-escuro text-white px-4 py-2 rounded-md text-sm font-dm hover:bg-verde-escuro-hover transition d-flex align-items-center gap-2' %>
    </div>
  </div>

  <!-- Como Chegar -->
  <div class="flex flex-col gap-4 border-t border-gray-300 pt-4">
    <h2 class="font-alice text-lg text-verde-escuro">
      <i class="bi bi-geo-alt-fill"></i> Como Chegar
    </h2>
    <p>
      <strong>🏢 Endereço da Filial:</strong>
      <a href="https://www.google.com/maps/search/?api=1&query=<%= URI.encode_www_form_component(@reserva.cabana.filial.address) %>"
         target="_blank"
         rel="noopener noreferrer"
         class="text-gray-700 hover:text-verde-escuro transition">
        <%= @reserva.cabana.filial.address %>
      </a>
    </p>
    <p class="text-gray-600">Clique no endereço acima para abrir no Google Maps.</p>
  </div>

  <!-- Botão de Voltar -->
  <div class="flex justify-start mt-4">
    <%= link_to '<i class="bi bi-arrow-left"></i> Voltar para Reservas'.html_safe, reservas_path,
        class: 'text-verde-escuro underline hover:text-verde-escuro-hover font-dm text-sm d-flex align-items-center gap-2' %>
  </div>

  <!-- Botão WhatsApp -->
  <%= render 'shared/wppButton' %>
</div>
