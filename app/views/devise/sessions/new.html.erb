<div class="bg-white rounded-md flex flex-col w-full mx-auto max-w-9/10 p-2 gap-6">
  <p class="text-center !font-alice text-3xl text-verde-escuro">Entrar</p>
  
  <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'flex flex-col gap-6' }) do |f| %>
    <div class="flex flex-col w-full gap-4">
      <div class="flex flex-col gap-2">
        <%= f.label :email, class: 'font-dm text-lg text-terracota' %>
        <%= f.input_field :email, autofocus: true, autocomplete: "email",
          class: 'font-dm w-full bg-transparent border border-terracota rounded-md px-4 py-2 text-terracota' %>
      </div>

      <div class="flex flex-col gap-2">
        <%= f.label :password, 'Senha', class: 'font-dm text-lg text-terracota' %>
        <%= f.input_field :password, autocomplete: "current-password",
          class: 'font-dm w-full bg-transparent border border-terracota rounded-md px-4 py-2 text-terracota' %>
      </div>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: 'w-5 h-5 text-verde-escuro border-gray-300 rounded focus:ring focus:ring-verde-escuro' %>
        <%= f.label :remember_me, 'Manter logado', class: 'font-dm text-terracota text-md' %>
      </div>
    <% end %>

    <hr class="w-full my-4">

    <div class="font-dm bg-botao-verde rounded-3xl flex justify-center items-center gap-4 p-3">
      <div class="w-full text-center">
        <%= f.submit "Entrar", class: 'uppercase font-light text-white w-full bg-transparent' %>
      </div>
    </div>
  <% end %>

  <div class="flex justify-center mt-4">
    <%= link_to "Não tem uma conta? Cadastre-se", new_registration_path(resource_name),
      class: 'font-dm text-sm text-verde-escuro underline hover:text-verde-escuro-hover' %>
  </div>
</div>