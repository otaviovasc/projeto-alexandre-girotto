<style>
  .services-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 2rem;
    border-radius: 16px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
  }
  .services-header h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .services-header p {
    opacity: 0.9;
    margin-bottom: 1rem;
  }
  .filter-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    margin-bottom: 2rem;
  }
  .filter-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: end;
  }
  .filter-group {
    flex: 1;
    min-width: 200px;
  }
  .filter-group label {
    display: block;
    font-weight: 500;
    color: #374151;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }
  .filter-group input, .filter-group select {
    width: 100%;
    padding: 0.65rem 1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.95rem;
    transition: all 0.2s;
  }
  .filter-group input:focus, .filter-group select:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    outline: none;
  }
  .filter-actions {
    display: flex;
    gap: 0.5rem;
  }
  .btn-filter {
    padding: 0.65rem 1.5rem;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
  }
  .btn-filter-primary {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
  }
  .btn-filter-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
  }
  .btn-filter-secondary {
    background: #f1f5f9;
    color: #475569;
  }
  .btn-filter-secondary:hover {
    background: #e2e8f0;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .service-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
  }
  .service-image {
    height: 180px;
    background: linear-gradient(135deg, #f0f4f8, #e2e8f0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    font-size: 3rem;
    position: relative;
  }
  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .region-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .region-sp {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #78350f;
  }
  .region-mg {
    background: linear-gradient(135deg, #34d399, #10b981);
    color: #064e3b;
  }
  .service-body {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .service-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 0.5rem;
  }
  .service-description {
    color: #6b7280;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    flex: 1;
  }
  .service-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: #6b7280;
    background: #f8fafc;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
  }
  .service-price {
    font-size: 1.5rem;
    font-weight: 700;
    color: #667eea;
    margin-bottom: 1rem;
  }
  .service-actions {
    display: flex;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
  }
  .btn-action {
    flex: 1;
    padding: 0.6rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
  }
  .btn-edit {
    background: #f1f5f9;
    color: #475569;
  }
  .btn-edit:hover {
    background: #e2e8f0;
    color: #1f2937;
  }
  .btn-delete {
    background: #fef2f2;
    color: #dc2626;
  }
  .btn-delete:hover {
    background: #fee2e2;
  }
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  .empty-state-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }
  .empty-state h3 {
    color: #374151;
    margin-bottom: 0.5rem;
  }
  .empty-state p {
    color: #6b7280;
  }
</style>

<div class="container py-4">
  <!-- Header -->
  <div class="services-header">
    <h1>🛎️ Serviços</h1>
    <p>Gerencie os serviços oferecidos nas suas filiais</p>
    <%= link_to new_admin_service_path, class: 'btn btn-light' do %>
      <i class="bi bi-plus-lg me-1"></i> Novo Serviço
    <% end %>
  </div>

  <!-- Filtros -->
  <div class="filter-card">
    <%= search_form_for @q, url: admin_services_path, method: :get, html: { class: "filter-row" } do |f| %>
      <div class="filter-group">
        <%= f.label :name_cont, "Buscar por nome" %>
        <%= f.search_field :name_cont, class: "form-control", placeholder: "Digite o nome do serviço..." %>
      </div>
      <div class="filter-group">
        <%= f.label :region_eq, "Região" %>
        <%= f.select :region_eq, Service::REGIONS, { prompt: "Todas as regiões" }, class: "form-select" %>
      </div>
      <div class="filter-group">
        <%= f.label :filial_id_eq, "Filial" %>
        <%= f.collection_select :filial_id_eq, Filial.all, :id, :name, { prompt: "Todas as filiais" }, class: "form-select" %>
      </div>
      <div class="filter-actions">
        <%= f.submit "Filtrar", class: "btn-filter btn-filter-primary" %>
        <%= link_to "Limpar", admin_services_path, class: "btn-filter btn-filter-secondary" %>
      </div>
    <% end %>
  </div>

  <!-- Grid de Serviços -->
  <% if @services.any? %>
    <div class="services-grid">
      <% @services.each do |service| %>
        <div class="service-card">
          <div class="service-image">
            <% if service.images.attached? %>
              <%= image_tag service.images.first.url %>
            <% else %>
              🖼️
            <% end %>
            <span class="region-badge region-<%= service.region&.downcase || 'sp' %>">
              <%= service.region || 'SP' %>
            </span>
          </div>
          <div class="service-body">
            <h3 class="service-title"><%= service.name %></h3>
            <p class="service-description"><%= truncate(service.description, length: 80) %></p>
            <div class="service-meta">
              <span class="meta-item">
                🏠 <%= service.filial&.name || 'Sem filial' %>
              </span>
              <% if service.show_in_marketplace %>
                <span class="meta-item">✅ Marketplace</span>
              <% end %>
            </div>
            <div class="service-price">
              <div>Hóspede: <%= number_to_currency(service.price, unit: "R$") %></div>
              <div>Parceria: <%= number_to_currency(service.partner_price, unit: "R$") %></div>
            </div>
            <div class="service-actions">
              <%= link_to edit_admin_service_path(service), class: 'btn-action btn-edit' do %>
                ✏️ Editar
              <% end %>
              <%= link_to admin_service_path(service), method: :delete, data: { turbo_method: :delete, turbo_confirm: 'Tem certeza que deseja excluir este serviço?' }, class: 'btn-action btn-delete' do %>
                🗑️ Excluir
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">📭</div>
      <h3>Nenhum serviço encontrado</h3>
      <p>Tente ajustar os filtros ou crie um novo serviço.</p>
    </div>
  <% end %>
</div>
