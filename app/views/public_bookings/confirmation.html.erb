<% content_for :title, "#{@payment_paid ? 'Reserva confirmada' : 'Pagamento da reserva'} - Villaggio Girotto" %>

<main class="vg-public-page">
  <div class="vg-public-shell">
    <div class="vg-topline">
      <span class="vg-brand-name">Villaggio Girotto</span>
      <span class="vg-page-status">Reserva #<%= @reserva.id %></span>
    </div>

    <header class="vg-hero">
      <div>
        <p class="vg-kicker"><%= @payment_paid ? "Pagamento confirmado" : "Checkout seguro" %></p>
        <h1 class="vg-title">
          <%= @payment_paid ? "Sua reserva está confirmada." : "Finalize o pagamento." %>
        </h1>
        <p class="vg-lead">
          <%= @reserva.cabana.name %> · <%= @reserva.start_date.strftime('%d/%m/%Y') %> a <%= @reserva.end_date.strftime('%d/%m/%Y') %>
        </p>
      </div>
      <div class="vg-note">
        Esta página acompanha a confirmação da Cielo. Depois do pagamento, enviamos o resumo por e-mail e liberamos o contato pelo WhatsApp.
      </div>
    </header>

    <section class="vg-card">
      <% if @payment_paid %>
        <div class="vg-alert success">
          <strong>Pagamento confirmado.</strong> Sua reserva foi registrada com sucesso.
        </div>
      <% elsif @payment_open %>
        <div class="vg-alert warning">
          <strong>Aguardando pagamento.</strong> As datas ficam pré-reservadas até
          <%= @reserva_payment.due_at.in_time_zone('America/Sao_Paulo').strftime('%d/%m/%Y às %H:%M') %>.
        </div>
      <% else %>
        <div class="vg-alert error">
          <strong><%= @payment_status_label %>.</strong> Esta tentativa não pode mais confirmar a reserva.
        </div>
      <% end %>

      <div class="vg-summary-grid">
        <div>
          <p class="vg-summary-label">Responsável</p>
          <p class="vg-summary-value"><%= @reserva.guest_name.presence || @reserva.user.name %></p>
        </div>
        <div>
          <p class="vg-summary-label">Status</p>
          <p id="payment-status-label" class="vg-summary-value"><%= @payment_status_label %></p>
        </div>
        <div>
          <p class="vg-summary-label">Total</p>
          <p class="vg-summary-value"><%= number_to_currency(@reserva_payment.amount, unit: 'R$ ', separator: ',', delimiter: '.') %></p>
        </div>
      </div>

      <div class="vg-items">
        <% @purchase_items.each do |item| %>
          <div class="vg-item">
            <div>
              <p class="font-semibold text-[#1a2e1a]"><%= item[:name] %></p>
              <p class="mt-1 text-sm text-[#637066]">
                <%= item[:detail] %>
                <% if item[:quantity].to_i > 1 %>
                  · <%= item[:quantity] %> unidades
                <% end %>
              </p>
            </div>
            <p class="shrink-0 font-semibold text-[#1a2e1a]"><%= number_to_currency(item[:total], unit: 'R$ ', separator: ',', delimiter: '.') %></p>
          </div>
        <% end %>
      </div>

      <% if @payment_paid %>
        <div class="mt-8 border border-[#d8cdb8] bg-[#fbf7ee] p-5">
          <h2 class="vg-card-title text-[24px]">Próximo passo</h2>
          <p class="mt-2 text-sm leading-6 text-[#6c7066]">
            Envie o resumo abaixo pelo WhatsApp para agilizar o contato. Se preferir não enviar agora, tudo bem: entraremos em contato com você.
          </p>

          <textarea id="public-booking-summary" readonly rows="9" class="vg-textarea"><%= @summary_text %></textarea>

          <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <%= link_to "Enviar pelo WhatsApp",
                @whatsapp_url,
                target: "_blank",
                rel: "noopener",
                class: "vg-button w-full sm:w-auto" %>
            <button type="button" id="copy-summary-button" class="vg-button secondary w-full sm:w-auto">
              Copiar resumo
            </button>
          </div>
          <p id="copy-summary-feedback" class="mt-3 hidden text-sm font-medium text-green-700">Resumo copiado.</p>
        </div>
      <% elsif @payment_open %>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <%= link_to "Finalizar pagamento na Cielo",
              @payment_link_url,
              class: "vg-button w-full sm:w-auto",
              data: { turbo: false } %>
          <button type="button" id="check-payment-button" class="vg-button secondary w-full sm:w-auto">
            Verificar pagamento
          </button>
        </div>
        <p class="mt-3 text-sm text-[#637066]">Esta página verifica automaticamente se o pagamento foi confirmado.</p>
      <% else %>
        <div class="mt-8">
          <%= link_to "Iniciar nova reserva",
              new_public_booking_path,
              class: "vg-button" %>
        </div>
      <% end %>
    </section>
  </div>
</main>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var statusLabel = document.getElementById("payment-status-label");
    var checkButton = document.getElementById("check-payment-button");
    var statusUrl = <%= raw public_booking_status_path(token: @reserva_payment.terms_token).to_json %>;

    function checkPaymentStatus() {
      if (!statusLabel) return;

      fetch(statusUrl, { headers: { "Accept": "application/json" } })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (data.status_label) statusLabel.textContent = data.status_label;
          if (data.paid || !data.open) window.location.reload();
        })
        .catch(function() {});
    }

    if (checkButton) checkButton.addEventListener("click", checkPaymentStatus);
    if (checkButton) window.setInterval(checkPaymentStatus, 5000);

    var copyButton = document.getElementById("copy-summary-button");
    var textarea = document.getElementById("public-booking-summary");
    var feedback = document.getElementById("copy-summary-feedback");

    if (copyButton && textarea && feedback) {
      copyButton.addEventListener("click", function() {
        function showFeedback() {
          feedback.classList.remove("hidden");
          copyButton.textContent = "Resumo copiado";
        }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(textarea.value).then(showFeedback).catch(function() {
            textarea.select();
            document.execCommand("copy");
            showFeedback();
          });
        } else {
          textarea.select();
          document.execCommand("copy");
          showFeedback();
        }
      });
    }
  });
</script>
