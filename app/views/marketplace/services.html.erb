<h1 class="text-2xl lg:text-4xl font-alice text-center my-8 lg:my-16">Serviços Disponíveis</h1>

<div class="container mx-auto px-4 lg:px-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <% @services.each do |service| %>
      <div class="service-card bg-white rounded-lg shadow-lg overflow-hidden flex flex-col lg:flex-row">
        <!-- Imagem do Serviço -->
        <div class="service-image lg:w-1/3">
          <% if service.images.attached? %>
            <% service.images.each do |image| %>
              <img src="<%= image.url %>" alt="<%= service.name %>" class="w-full h-full object-cover">
            <% end %>
          <% else %>
            <div class="flex items-center justify-center w-full h-full bg-creme">
              <p class="text-gray-500">Sem imagem disponível!</p>
            </div>
          <% end %>
        </div>

        <!-- Detalhes do Serviço -->
        <div class="service-details flex flex-col justify-between p-6 lg:w-2/3">
          <div>
            <h2 class="text-xl lg:text-2xl font-alice text-preto-fill mb-4"><%= service.name %></h2>
            <p class="text-base lg:text-lg text-gray-600 mb-4"><%= service.description %></p>
            <p class="text-lg lg:text-xl text-verde-escuro font-bold"><strong>Price:</strong> <%= number_to_currency(service.price) %></p>
          </div>

          <!-- Botão de Visualização -->
          <div class="mt-6">
            <%= link_to 'Ver serviço', service_path(service), class: 'uppercase font-light text-creme bg-botao-verde rounded-3xl px-6 py-3 inline-block text-center' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<h2 class="text-2xl lg:text-3xl font-alice text-center my-8 lg:my-16">Seu carrinho</h2>

<div class="container mx-auto px-4 lg:px-20">
  <% if @cart_items.present? %>
    <div class="grid grid-cols-1 gap-8">
      <% @cart_items.each do |cart_item| %>
        <div class="cart-item bg-white rounded-lg shadow-lg p-6 flex flex-col lg:flex-row items-center justify-between">
          <!-- Detalhes do Item -->
          <div class="flex flex-col gap-4 lg:w-2/3">
            <h4 class="text-xl font-alice text-preto-fill"><%= cart_item.item&.name || cart_item.service&.name %></h4>
            <p class="text-gray-600 text-lg">Price: <%= number_to_currency(cart_item.item&.price || cart_item.service&.price) %></p>
          </div>

          <!-- Ações do Item -->
          <div class="flex flex-col lg:flex-row items-center gap-4 lg:w-1/3">
            <%= form_with url: add_item_path, method: :post, local: true do |f| %>
              <div class="flex items-center gap-4">
                <%= hidden_field_tag :item_id, cart_item.item_id if cart_item.item.present? %>
                <%= hidden_field_tag :service_id, cart_item.service_id if cart_item.service.present? %>
                <%= number_field_tag :quantity, cart_item.quantity, min: 1, class: 'w-16 text-center border border-gray-300 rounded-lg' %>
                <%= submit_tag "Update", class: 'uppercase font-light text-creme bg-botao-verde rounded-3xl px-4 py-2' %>
              </div>
            <% end %>
            <%= button_to "Remove", remove_item_path(cart_item), method: :delete, class: 'uppercase font-light text-creme bg-red-500 rounded-3xl px-4 py-2' %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-gray-600 text-lg">Seu carrinho está vazio!</p>
  <% end %>
</div>