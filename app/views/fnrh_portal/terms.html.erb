<% content_for :title, 'Acesso da hospedagem - Villaggio Girotto' %>

<main class="min-h-screen bg-[#ede5d2] px-4 py-5 text-[#20241f] sm:py-8">
  <div class="mx-auto w-full max-w-5xl">
    <div class="flex items-center justify-between gap-4 border-b border-[#d8cdb8] py-4">
      <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#55613a]">Villaggio Girotto</span>
      <span class="text-sm text-[#6c7066]">Área da hospedagem</span>
    </div>

    <header class="grid gap-8 py-10 sm:grid-cols-[1.05fr_.95fr] sm:items-end">
      <div>
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.12em] text-[#9f7f4f]">Acesso da reserva</p>
        <h1 class="max-w-3xl text-[44px] font-medium leading-[0.96] tracking-normal sm:text-[72px]" style="font-family: Georgia, 'Times New Roman', serif;">
          Acesso da hospedagem.
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-[#6c7066]">
          Informe o primeiro nome e o código da reserva para acessar serviços, serviços comprados e material do hóspede.
        </p>
      </div>

      <div class="border border-[#d8cdb8] bg-[#f7f1e4]/80 p-5 text-sm leading-6 text-[#6c7066]">
        O código da reserva é o número entre parênteses no final do nome do grupo de WhatsApp.
      </div>
    </header>

    <% if flash[:notice].present? %>
      <div class="mb-5 border-l-4 border-[#4f7a45] bg-[#fbf7ee] px-4 py-3 text-sm leading-6 text-[#315329]">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="mb-5 border-l-4 border-[#b42318] bg-[#fbf7ee] px-4 py-3 text-sm leading-6 text-[#7a1d17]">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if @reserva.present? && @terms_accepted %>
      <section class="border border-[#d8cdb8] bg-[#f7f1e4] p-6 shadow-[0_18px_48px_rgba(42,43,36,0.08)] sm:p-9">
        <div class="grid gap-6 border-b border-[#d8cdb8] pb-7 sm:grid-cols-[1fr_auto] sm:items-start">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#9f7f4f]">Reserva #<%= @reserva.id %></p>
            <h2 class="mt-3 text-3xl font-medium leading-tight sm:text-4xl" style="font-family: Georgia, 'Times New Roman', serif;">
              <%= @reserva.cabana.name %>
            </h2>
            <p class="mt-3 text-base text-[#6c7066]">
              <%= @reserva.start_date.strftime('%d/%m/%Y') %> a <%= @reserva.end_date.strftime('%d/%m/%Y') %>
            </p>
          </div>

          <span class="inline-flex w-fit items-center border border-[#d8cdb8] bg-[#fbf7ee] px-4 py-3 text-sm font-bold text-[#55613a]">
            Termos aceitos
          </span>
        </div>

        <div class="mt-8 grid gap-3">
          <%= link_to 'Comprar serviços',
              portal_reserva_servicos_path,
              class: 'inline-flex min-h-[56px] w-full items-center justify-center border border-[#55613a] bg-[#55613a] px-5 py-4 text-center font-extrabold text-white transition hover:border-[#3f4a2f] hover:bg-[#3f4a2f]' %>

          <%= link_to 'Ver serviços comprados',
              portal_reserva_comprados_path,
              class: 'inline-flex min-h-[56px] w-full items-center justify-center border border-[#55613a] bg-transparent px-5 py-4 text-center font-extrabold text-[#3f4a2f] transition hover:bg-[#55613a] hover:text-white' %>

          <% if @reserva.fnrh_information_released? %>
            <%= link_to 'Material do hóspede',
                fnrh_portal_information_path,
                class: 'inline-flex min-h-[56px] w-full items-center justify-center border border-[#d8cdb8] bg-[#fbf7ee] px-5 py-4 text-center font-extrabold text-[#20241f] transition hover:border-[#55613a]' %>
          <% else %>
            <%= button_to 'Material do hóspede',
                fnrh_portal_access_path,
                method: :post,
                params: {
                  guest_name: @guest_name,
                  reservation_code: @reserva.id
                },
                form: { data: { fnrh_loading: true } },
                class: 'inline-flex min-h-[56px] w-full items-center justify-center border border-[#d8cdb8] bg-[#fbf7ee] px-5 py-4 text-center font-extrabold text-[#20241f] transition hover:border-[#55613a]' %>
          <% end %>
        </div>

        <%= button_to 'Sair',
            fnrh_portal_logout_path,
            method: :delete,
            class: 'mt-7 text-sm font-bold text-[#55613a] underline underline-offset-4' %>
      </section>
    <% elsif @reserva.present? %>
      <section class="border border-[#d8cdb8] bg-[#f7f1e4] p-6 shadow-[0_18px_48px_rgba(42,43,36,0.08)] sm:p-9">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#9f7f4f]">Reserva #<%= @reserva.id %></p>
        <h2 class="mt-3 text-3xl font-medium leading-tight sm:text-4xl" style="font-family: Georgia, 'Times New Roman', serif;">
          <%= @reserva.cabana.name %>
        </h2>
        <p class="mt-3 text-base leading-7 text-[#6c7066]">
          Para liberar o acesso desta reserva, leia e confirme os termos abaixo uma única vez.
        </p>
      </section>

      <section class="mt-5 border border-[#d8cdb8] bg-[#f7f1e4] p-6 shadow-[0_18px_48px_rgba(42,43,36,0.08)] sm:p-9">
        <h2 class="text-2xl font-medium" style="font-family: Georgia, 'Times New Roman', serif;">Termos de hospedagem</h2>
        <p class="mt-2 text-sm leading-6 text-[#6c7066]">Leia os termos antes de confirmar o aceite e acessar os serviços e material do hóspede.</p>

        <details class="mt-6 border border-[#d8cdb8] bg-[#fbf7ee]" open>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-extrabold uppercase tracking-[0.08em] text-[#3f4a2f]">
            <span>Ler termos e condições</span>
            <span class="text-2xl leading-none">+</span>
          </summary>
          <div class="max-h-[70vh] overflow-auto border-t border-[#d8cdb8] p-5">
            <%= render 'hosting_terms' %>
          </div>
        </details>

        <%= form_with url: fnrh_terms_access_path, method: :post, local: true, data: { fnrh_loading: true }, class: 'mt-7 space-y-5' do |form| %>
          <%= form.hidden_field :guest_name, value: @guest_name %>
          <%= form.hidden_field :reservation_code, value: @reserva.id %>

          <label class="flex items-start gap-3 border border-[#d8cdb8] bg-[#fbf7ee] p-4 text-sm leading-6 text-[#3f4b43]">
            <%= form.check_box :terms_accepted,
                { required: true, class: 'mt-1 h-5 w-5 shrink-0 accent-[#55613a]' },
                '1',
                '0' %>
            <span>Declaro que li, compreendi e concordo com os Termos e Condições de Hospedagem acima.</span>
          </label>

          <button type="submit" class="inline-flex min-h-[56px] w-full items-center justify-center border border-[#55613a] bg-[#55613a] px-5 py-4 text-center font-extrabold text-white transition hover:border-[#3f4a2f] hover:bg-[#3f4a2f]">
            Concordar e Ver Material
          </button>
        <% end %>
      </section>
    <% else %>
      <section class="border border-[#d8cdb8] bg-[#f7f1e4] p-6 shadow-[0_18px_48px_rgba(42,43,36,0.08)] sm:p-9">
        <h2 class="text-3xl font-medium" style="font-family: Georgia, 'Times New Roman', serif;">Entrar na reserva</h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-[#6c7066]">
          Use o primeiro nome do responsável e o código que aparece entre parênteses no nome do grupo de WhatsApp.
        </p>

        <%= form_with url: fnrh_terms_access_path, method: :post, local: true, class: 'mt-7 space-y-5' do |form| %>
          <div>
            <%= form.label :guest_name, 'Primeiro nome', class: 'block text-xs font-extrabold uppercase tracking-[0.08em] text-[#3f4a2f]' %>
            <%= form.text_field :guest_name,
                required: true,
                autocomplete: 'given-name',
                pattern: '\\S+',
                title: 'Digite somente o primeiro nome, sem espaços',
                data: { first_name_only: true },
                placeholder: 'Ex.: Maria',
                class: 'mt-2 w-full border border-[#d8cdb8] bg-[#fbf7ee] px-4 py-4 text-base text-[#20241f] outline-none focus:border-[#55613a] focus:ring-2 focus:ring-[#55613a]/20' %>
            <p class="mt-2 text-sm text-[#6c7066]">Digite somente o primeiro nome, sem sobrenome e sem espaços.</p>
          </div>

          <div>
            <%= form.label :reservation_code, 'Código da reserva', class: 'block text-xs font-extrabold uppercase tracking-[0.08em] text-[#3f4a2f]' %>
            <%= form.number_field :reservation_code,
                required: true,
                min: 1,
                inputmode: 'numeric',
                placeholder: 'Ex.: 843',
                class: 'mt-2 w-full border border-[#d8cdb8] bg-[#fbf7ee] px-4 py-4 text-base text-[#20241f] outline-none focus:border-[#55613a] focus:ring-2 focus:ring-[#55613a]/20' %>
            <p class="mt-2 text-sm text-[#6c7066]">
              Código da reserva: números que ficam entre parênteses no final do nome do seu grupo do WhatsApp.
            </p>
          </div>

          <button type="submit" class="inline-flex min-h-[56px] w-full items-center justify-center border border-[#55613a] bg-[#55613a] px-5 py-4 text-center font-extrabold text-white transition hover:border-[#3f4a2f] hover:bg-[#3f4a2f]">
            Acessar Serviços e Material do Hospede
          </button>
        <% end %>
      </section>
    <% end %>
  </div>
</main>
