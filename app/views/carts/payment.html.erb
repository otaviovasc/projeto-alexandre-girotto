<div class="bg-white rounded-md flex flex-col w-full mx-auto p-4 relative">
  <%= link_to checkout_cart_path, class: "absolute left-2 inline-flex items-center justify-center w-10 h-10 rounded-full border border-verde-escuro text-verde-escuro" do %>
    <i class="fa-solid fa-arrow-left"></i>
  <% end %>

  <p class="text-center text-4xl font-alice text-verde-escuro">
    Pagamento
  </p>
</div>

<div class="bg-white rounded-md w-full max-w-4xl mx-auto p-6 flex flex-col gap-6 shadow-md">
  <% if @pending_payment.present? %>
    <div class="flex flex-col gap-3 text-center">
      <h2 class="font-alice text-2xl text-verde-escuro">Aguardando confirmação do pagamento</h2>
      <p class="text-gray-600">
        Seu pedido foi enviado para o checkout seguro. Assim que o pagamento por Pix ou cartão for confirmado,
        os itens serão vinculados automaticamente à sua reserva.
      </p>
      <%= link_to "Abrir link de pagamento", @pending_payment.payment_link_url,
                  class: "bg-botao-verde text-white px-6 py-3 rounded-md text-sm font-dm uppercase hover:bg-botao-verde-hover transition mx-auto",
                  target: "_blank", rel: "noopener" %>
    </div>
  <% else %>
    <div class="flex flex-col gap-3 text-center">
      <h2 class="font-alice text-2xl text-verde-escuro">Pagamento recebido</h2>
      <p class="text-gray-600">
        Se o carrinho estiver vazio, seu pagamento já foi processado e os itens foram adicionados à reserva.
      </p>
    </div>
  <% end %>

  <% if @cart_items.any? %>
    <div class="flex justify-between items-center border-t border-gray-300 pt-4">
      <h2 class="font-alice text-lg text-verde-escuro">
        <i class="bi bi-cash-stack"></i> Total do pedido
      </h2>
      <p class="text-xl font-bold text-gray-800">
        <%= number_to_currency(@cart_items.sum { |cart_item| (cart_item.unit_price_paid || cart_item_unit_price(cart_item)) * cart_item.quantity }) %>
      </p>
    </div>

    <div class="flex flex-col gap-4 border-t border-gray-300 pt-4">
      <h2 class="font-alice text-lg text-verde-escuro">
        <i class="bi bi-bag-check"></i> Itens do pedido
      </h2>
      <ul class="list-disc ml-6 text-gray-600">
        <% @cart_items.each do |cart_item| %>
          <li>
            <strong><%= cart_item.service&.name || cart_item.item&.name %></strong>,
            <strong>Preço:</strong> <%= number_to_currency(cart_item.unit_price_paid || cart_item_unit_price(cart_item)) %>,
            <strong>Quantidade:</strong> <%= cart_item.quantity %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
