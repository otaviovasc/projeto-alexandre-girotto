<div class="row">
  <% Cabana.all.each do |cabana| %>
    <div class="col-auto d-flex align-items-center my-1">
      <div class="legend-color me-2" style="background-color: <%= cabana.color %>"></div>
      <%= cabana.name %>
    </div>
  <% end %>
  <div class="col-auto d-flex align-items-center my-1">
    <div class="legend-color operational-block me-2"></div>
    Early check-in / Late checkout
  </div>
</div>
