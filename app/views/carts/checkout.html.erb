<div class="bg-white rounded-md flex flex-col w-full mx-auto p-4 relative">

    <!-- Ícone de voltar (sem texto) -->
    <%= link_to services_marketplace_index_path,
                class: "absolute left-2 inline-flex items-center justify-center w-10 h-10
                        rounded-full border border-verde-escuro text-verde-escuro" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>

    <!-- Título da Cabana (centralizado) -->
    <p class="text-center text-4xl font-alice text-verde-escuro">
      Seu Carrinho
    </p>
  </div>

<div class="container mx-auto px-4 lg:px-20">
  <% if @cart_items.present? %>
    <!-- Lista de Itens no Carrinho -->
    <div class="flex flex-col gap-6">
      <% @cart_items.each do |cart_item| %>
        <div class="cart-item bg-white rounded-lg shadow-lg p-6 flex flex-col sm:flex-row justify-between items-center">
          <!-- Detalhes do Item -->
          <div class="flex flex-col gap-2 text-center sm:text-left">
            <h4 class="text-lg font-alice text-preto-fill"><%= cart_item.item&.name || cart_item.service&.name %></h4>
            <p class="text-sm lg:text-base text-gray-600">Preço: <%= number_to_currency(cart_item.item&.price || cart_item.service&.price) %></p>
          </div>

          <!-- Ações do Item -->
          <div class="mt-4 sm:mt-0 flex flex-col sm:flex-row items-center gap-4">
            <%= form_with url: update_item_path, method: :post, local: true do %>
              <div class="flex items-center gap-2">
                <%= hidden_field_tag :item_id, cart_item.item_id if cart_item.item.present? %>
                <%= hidden_field_tag :service_id, cart_item.service_id if cart_item.service.present? %>
                <%= number_field_tag :quantity, cart_item.quantity, min: 1, class: 'w-16 text-center border border-gray-300 rounded-lg' %>
                <%= submit_tag "Atualizar", class: 'uppercase font-light text-creme bg-botao-verde rounded-3xl px-4 py-2' %>
              </div>
            <% end %>

            <%= button_to "Remover", remove_item_path(cart_item), method: :delete, class: 'uppercase font-light text-creme bg-red-500 rounded-3xl px-4 py-2' %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Botão de Checkout -->
    <div class="flex justify-center border-gray-300 pt-4">
      <%= form_with url: checkout_process_path, method: :post, local: true do %>
        <%= submit_tag 'Finalizar Compra', class: 'bg-botao-verde text-white px-6 py-3 rounded-md text-sm font-dm uppercase hover:bg-botao-verde-hover transition' %>
      <% end %>
    </div>



  <% else %>
    <p class="text-center text-gray-600 text-lg my-8">Seu carrinho está vazio.</p>

    <div class="flex justify-center flex-col text-center gap-4 content-center">
      <%= link_to '<i class="bi bi-basket2"></i> &nbsp Ver serviços disponiveis.'.html_safe, services_marketplace_index_path,
                class: 'bg-verde-escuro text-white px-4 py-2 rounded-md text-sm font-dm hover:bg-verde-escuro-hover transition d-flex align-items-center gap-2' %>

      <%= link_to '<i class="bi bi-bag-check"></i> &nbsp Ver items disponiveis.'.html_safe, items_marketplace_index_path,
          class: 'bg-verde-escuro text-white px-4 py-2 rounded-md text-sm font-dm hover:bg-verde-escuro-hover transition d-flex align-items-center gap-2' %>
    </div>

  <% end %>
</div>
