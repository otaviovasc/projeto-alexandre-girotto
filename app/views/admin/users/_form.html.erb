<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4">Criar Novo Usuário</h1>

  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(@user.errors.count, "erro") %> impediram o salvamento deste usuário:</h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: [:admin, @user], local: true, html: { class: 'needs-validation' }) do |form| %>
    <div class="mb-3">
      <%= form.label :email, 'E-mail', class: 'form-label' %>
      <%= form.email_field :email, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :password, 'Senha', class: 'form-label' %>
      <%= form.password_field :password, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :password_confirmation, 'Confirmação de Senha', class: 'form-label' %>
      <%= form.password_field :password_confirmation, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :role, 'Função', class: 'form-label' %>
      <%= form.select :role, User.roles.keys.reject { |role| role == 'admin' }.map { |role| [role.humanize, role] }, { include_blank: 'Selecione uma função' }, { class: 'form-select' } %>
    </div>

    <div class="mb-3">
      <%= form.label :filial_id, 'Filial', class: 'form-label' %>
      <%= form.collection_select :filial_id, Filial.all, :id, :name, { include_blank: 'Selecione uma filial' }, { class: 'form-select' } %>
    </div>

    <div class="d-flex gap-2 mt-4">
      <%= form.submit 'Salvar', class: 'btn btn-primary' %>
      <%= link_to 'Cancelar', admin_users_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
