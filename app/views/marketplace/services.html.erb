<h1 class="text-2xl lg:text-4xl font-alice text-center my-8 lg:my-16">Serviços Disponíveis</h1>

<div class="flex justify-center items-center gap-4 mb-8">
  <%= link_to 'Ver serviços', services_marketplace_index_path,
              class: "px-4 py-2 rounded-full font-dm text-sm lg:text-base #{current_page?(services_marketplace_index_path) ? 'bg-gray-200 text-gray-800' : 'bg-white text-gray-500 border border-gray-300'} hover:bg-gray-300 transition" %>

  <%= link_to 'Ver itens', items_marketplace_index_path,
              class: "px-4 py-2 rounded-full font-dm text-sm lg:text-base #{current_page?(items_marketplace_index_path) ? 'bg-gray-200 text-gray-800' : 'bg-white text-gray-500 border border-gray-300'} hover:bg-gray-300 transition" %>
</div>

<div class="container mx-auto px-4 lg:px-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <% @services.each do |service| %>
      <div class="service-card bg-white rounded-lg shadow-lg overflow-hidden flex flex-col lg:flex-row">
        <!-- Imagem do Serviço -->
        <div class="service-image lg:w-1/3">
          <% if service.images.attached? %>
            <%= render partial: "shared/cabana_slider", locals: { images: service.images, cabana: service } %>
          <% else %>
            <div class="flex items-center justify-center w-full h-full bg-creme">
              <p class="text-gray-500">Sem imagem disponível!</p>
            </div>
          <% end %>
        </div>

        <!-- Detalhes do Serviço -->
        <div class="service-details flex flex-col justify-between p-6 lg:w-2/3">
          <div>
            <h2 class="text-xl lg:text-2xl font-alice text-preto-fill mb-4"><%= service.name %></h2>
            <p class="text-base lg:text-lg text-gray-600 mb-4"><%= service.description %></p>
            <p class="text-lg lg:text-xl text-verde-escuro font-bold"><strong>Preço:</strong> <%= number_to_currency(service.price) %></p>
          </div>

          <!-- Botão de Visualização -->
          <div class="mt-6">
            <%= link_to 'Ver serviço', service_path(service), class: 'uppercase font-light text-creme bg-botao-verde rounded-3xl px-6 py-3 inline-block text-center' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
