<head>
  <style>
    input:focus,
    textarea:focus,
    select:focus {
      outline: none;
      box-shadow: none;
    }

    .background-image-right {
      position: absolute;
      top: 0;
      right: 0;
      width: 30%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
      pointer-events: none; /* Evita interações com a imagem */
    }

    .form-container {
      position: relative; /* Para que o background seja ajustado ao contexto */
    }
  </style>
</head>
<div class="form-container px-6 py-10 text-preto-fill flex flex-col gap-8 lg:px-20 lg:py-16">
  <!-- Plano de fundo -->
  <img src="<%= asset_path('logo_home.png') %>" class="background-image-right hidden lg:block">

  <!-- Conteúdo -->
  <div class="text-center lg:text-left">
    <p class="font-alice font-bold text-3xl leading-tight lg:text-4xl">Quer receber ofertas e ficar por dentro de
      oportunidades únicas?</p>
    <p class="font-dm font-light text-base leading-relaxed lg:text-lg">Preencha os campos abaixo para ficar por dentro.
    </p>
  </div>
  <%= form_with(url: crete_mailer_entry_path, model: @funil_mailer, method: :post, local: true) do |form| %>
    <div class="font-dm text-base flex flex-col gap-12 lg:gap-16 max-w-9/10 lg:max-w-5xl">
      <div class="font-dm text-base flex flex-col gap-4 lg:flex-row lg:flex-wrap lg:gap-8">
        <!-- Nome Completo -->
        <div class="flex flex-row items-center gap-4 border rounded p-2 lg:w-[48%]">
          <div class="whitespace-nowrap pl-2">
            <%= form.label :fullname, "Nome Completo: " %>
          </div>
          <div class='w-full'>
            <%= form.text_field :fullname, class: "w-full border-gray-300 rounded p-2" %>
          </div>
        </div>
        <!-- Whatsapp -->
        <div class="flex flex-row items-center gap-4 border rounded p-2 lg:w-[48%]">
          <div class="whitespace-nowrap pl-2">
            <%= form.label :number, "Whatsapp: " %>
          </div>
          <div class="w-full">
            <%= form.telephone_field :number, class: "w-full border-gray-300 rounded p-2" %>
          </div>
        </div>
        <!-- Email -->
        <div class="flex flex-row items-center gap-4 border rounded p-2 lg:w-full">
          <div class="whitespace-nowrap pl-2">
            <%= form.label :email, "Email: " %>
          </div>
          <div class="w-full">
            <%= form.email_field :email, class: "w-full border-gray-300 rounded p-2" %>
          </div>
        </div>
      </div>
      <!-- Botão Enviar -->
      <div class="text-center lg:text-left">
        <%= form.submit "Enviar", class: "bg-botao-verde text-xl text-white px-6 py-2 rounded-xl uppercase" %>
      </div>
    </div>
  <% end %>
</div>