    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .form-control, .form-select {
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.6rem 0.75rem;
    transition: all 0.2s ease;
  }

  .form-control:focus, .form-select:focus {
