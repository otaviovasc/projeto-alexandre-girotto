<% content_for :title, "Pagamento da reserva ##{@reserva.id} - Villaggio Girotto" %>

<main class="min-h-screen px-4 py-8 sm:py-12">
  <div class="mx-auto max-w-3xl">
    <header class="mb-8">
      <p class="text-sm font-semibold text-[#5f755f]">Villaggio Girotto</p>
      <h1 class="mt-1 text-3xl font-semibold sm:text-4xl">Pagamento da reserva</h1>
      <p class="mt-3 text-sm leading-6 text-[#637066]">
        Reserva #<%= @reserva.id %> · <%= @reserva.cabana.name %> ·
        <%= @reserva.start_date.strftime('%d/%m/%Y') %> a <%= @reserva.end_date.strftime('%d/%m/%Y') %>
      </p>
    </header>

    <% if flash[:notice].present? %>
      <div class="mb-6 border-l-4 border-green-600 bg-green-50 px-4 py-3 text-sm text-green-800">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="mb-6 border-l-4 border-red-500 bg-red-50 px-4 py-3 text-sm text-red-800">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <section class="border border-[#d9dfd7] bg-white p-6 shadow-sm sm:p-8">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <p class="text-xs uppercase tracking-wide text-[#7a857d]">Parcela</p>
          <p class="mt-1 text-xl font-semibold"><%= @reserva_payment.installment_number %>ª parcela</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-[#7a857d]">Valor</p>
          <p class="mt-1 text-xl font-semibold"><%= number_to_currency(@reserva_payment.amount, unit: 'R$ ', separator: ',', delimiter: '.') %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-[#7a857d]">Prazo</p>
          <p class="mt-1 font-semibold"><%= @reserva_payment.due_at.in_time_zone('America/Sao_Paulo').strftime('%d/%m/%Y às %H:%M') %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-[#7a857d]">Status</p>
          <p class="mt-1 font-semibold"><%= @reserva_payment.payment_status.humanize %></p>
        </div>
      </div>

      <% if @reserva_payment.paid? %>
        <div class="mt-6 border-l-4 border-green-600 bg-green-50 px-4 py-3 text-sm text-green-800">
          Pagamento confirmado. A reserva está registrada no sistema.
        </div>
      <% elsif @reserva.canceled? || @reserva_payment.canceled? || @reserva_payment.overdue? || @reserva_payment.expired? %>
        <div class="mt-6 border-l-4 border-red-500 bg-red-50 px-4 py-3 text-sm text-red-800">
          Este link está vencido ou cancelado. Entre em contato com o Villaggio para verificar a disponibilidade da data.
        </div>
      <% elsif @reserva_payment.terms_accepted? %>
        <div class="mt-6 border border-[#d9dfd7] bg-[#f7f9f6] p-4 text-sm leading-6 text-[#3f4b43]">
          Termos aceitos por <strong><%= @reserva_payment.terms_acceptance_display_name %></strong>.
          Continue para a Cielo para concluir o pagamento.
        </div>

        <%= link_to 'Pagar com segurança pela Cielo',
            @reserva_payment.payment_link_url,
            class: 'mt-6 block w-full bg-[#315b3a] px-4 py-3 text-center font-semibold text-white hover:bg-[#264a2e]',
            data: { turbo: false } %>
      <% else %>
        <div class="mt-6 space-y-6 leading-7 text-[#58645d]">
          <section>
            <h2 class="text-xl font-semibold text-[#172019]">Termos para confirmar a reserva</h2>
            <p class="mt-3">Ao prosseguir, o responsável declara que leu e concorda com os termos de hospedagem do Villaggio Girotto, incluindo regras de uso da cabana, política de cancelamento, responsabilidade por danos, regras para pets, visitas e preenchimento de dados obrigatórios quando aplicável.</p>
            <p class="mt-3">A data fica pré-reservada apenas até o prazo informado acima. A reserva só é confirmada após a confirmação do pagamento da primeira parcela.</p>
            <p class="mt-3">Se houver parcelas futuras e alguma delas vencer sem pagamento, a reserva poderá ser cancelada automaticamente.</p>
          </section>
        </div>

        <%= form_with url: accept_reserva_payment_terms_path(token: @reserva_payment.terms_token), method: :post, local: true, class: 'mt-6 space-y-5' do |form| %>
          <label class="flex items-start gap-3 border border-[#d9dfd7] bg-[#f7f9f6] p-4 text-sm leading-6 text-[#3f4b43]">
            <%= check_box_tag :terms_accepted, '1', false, required: true, class: 'mt-1 h-5 w-5 shrink-0 accent-[#315b3a]' %>
            <span>Declaro que li, compreendi e concordo com os termos para confirmação desta reserva.</span>
          </label>

          <div>
            <%= label_tag :terms_acceptance_name, 'Nome de quem aceitou os termos', class: 'block text-sm font-medium' %>
            <%= text_field_tag :terms_acceptance_name,
                nil,
                required: true,
                placeholder: 'Ex.: Maria Silva',
                class: 'mt-2 w-full border border-[#c9d1c7] px-3 py-3 text-base focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]' %>
          </div>

          <button type="submit" class="w-full bg-[#315b3a] px-4 py-3 font-semibold text-white hover:bg-[#264a2e]">
            Aceitar termos e continuar
          </button>
        <% end %>
      <% end %>
    </section>
  </div>
</main>
