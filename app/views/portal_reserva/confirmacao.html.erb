<% content_for :title, "#{@payment_paid ? 'Compra confirmada' : 'Aguardando pagamento'} - Villaggio Girotto" %>

<% grouped_services = @purchased_services.group_by { |reserva_service| [reserva_service.service_id, reserva_service.service_date] } %>
<% total = grouped_services.sum do |_key, items|
     first_item = items.first
     quantity = items.sum { |item| item.quantity.to_i }
     unit_price = first_item.unit_price_paid || first_item.service.price || 0
     unit_price * quantity
   end %>

<div class="min-h-screen bg-[#f7f5f0]">
  <div class="bg-[#1a2e1a] text-white px-4 py-5 shadow-lg">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      <div>
        <p class="text-white/50 text-xs uppercase tracking-widest">Meus servicos</p>
        <h1 class="text-xl font-bold leading-tight"><%= @payment_paid ? "Compra confirmada" : "Aguardando pagamento" %></h1>
      </div>

      <%= link_to "Voltar", portal_reserva_servicos_path, class: "text-white/70 hover:text-white text-sm font-medium transition" %>
    </div>
  </div>

  <main class="max-w-4xl mx-auto px-4 py-6">
    <section class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
      <div class="px-5 py-6 sm:px-7 border-b border-gray-100">
        <% if @payment_paid %>
          <p class="text-xs font-semibold text-[#2d6a3a] uppercase tracking-wider mb-2">Pagamento confirmado</p>
          <h2 class="text-2xl font-bold text-[#1a2e1a] leading-tight">Resumo da sua compra</h2>
          <p class="text-sm text-gray-500 mt-2">
            Envie esse resumo da sua compra para nosso grupo do WhatsApp.
          </p>
        <% elsif @payment_open %>
          <p class="text-xs font-semibold text-[#b09258] uppercase tracking-wider mb-2">Pedido criado</p>
          <h2 class="text-2xl font-bold text-[#1a2e1a] leading-tight">Finalize o pagamento</h2>
          <p class="text-sm text-gray-500 mt-2">
            Abra o checkout seguro da Pagar.me e mantenha esta pagina aberta. Assim que o pagamento for confirmado, o resumo para WhatsApp aparece aqui.
          </p>
        <% else %>
          <p class="text-xs font-semibold text-[#991b1b] uppercase tracking-wider mb-2">Pagamento expirado</p>
          <h2 class="text-2xl font-bold text-[#1a2e1a] leading-tight">Esta tentativa foi encerrada</h2>
          <p class="text-sm text-gray-500 mt-2">
            O prazo de pagamento desta tentativa acabou. Volte para escolher os servicos novamente.
          </p>
        <% end %>
      </div>

      <% unless @payment_paid %>
        <div class="px-5 py-5 sm:px-7 bg-[#fffaf0] border-b border-[#ead9b7]">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="text-sm font-semibold text-[#1a2e1a]">Status atual</p>
              <p id="payment-status-label" class="text-sm text-[#8a6b2f] mt-1"><%= @payment_status_label %></p>
            </div>

            <% if @payment_open && @payment_link_url.present? %>
              <%= link_to "Abrir checkout seguro", @payment_link_url,
                  target: "_blank",
                  rel: "noopener",
                  class: "inline-flex justify-center items-center bg-[#1a2e1a] hover:bg-[#2d4a2d] text-white text-sm font-bold px-5 py-3 rounded-lg transition" %>
            <% elsif !@payment_open %>
              <%= link_to "Escolher servicos novamente", portal_reserva_servicos_path,
                  class: "inline-flex justify-center items-center bg-[#1a2e1a] hover:bg-[#2d4a2d] text-white text-sm font-bold px-5 py-3 rounded-lg transition" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="px-5 py-5 sm:px-7 bg-[#faf9f6] border-b border-gray-100">
        <div class="grid sm:grid-cols-3 gap-3 text-sm">
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider">Cliente</p>
            <p class="font-semibold text-[#1a2e1a] mt-1"><%= @reserva.user.name %></p>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider">Reserva</p>
            <p class="font-semibold text-[#1a2e1a] mt-1">#<%= @reserva.id %></p>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider">Cabana</p>
            <p class="font-semibold text-[#1a2e1a] mt-1"><%= @reserva.cabana.name %></p>
          </div>
        </div>
      </div>

      <div class="divide-y divide-gray-100">
        <% grouped_services.each_value do |items| %>
          <% first_item = items.first %>
          <% quantity = items.sum { |item| item.quantity.to_i } %>
          <% unit_price = first_item.unit_price_paid || first_item.service.price || 0 %>
          <% subtotal = unit_price * quantity %>

          <div class="px-5 py-4 sm:px-7 flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="font-semibold text-[#1a2e1a] leading-tight"><%= first_item.service.name %></p>
              <p class="text-sm text-gray-500 mt-1">
                <%= quantity %> <%= quantity == 1 ? "unidade" : "unidades" %>
                <% if first_item.service_date.present? %>
                  - <%= first_item.service_date.strftime("%d/%m/%Y") %>
                <% end %>
              </p>
            </div>
            <p class="font-bold text-[#1a2e1a] whitespace-nowrap"><%= number_to_currency(subtotal) %></p>
          </div>
        <% end %>
      </div>

      <div class="px-5 py-5 sm:px-7 bg-[#f7f5f0] flex items-center justify-between gap-4">
        <span class="text-sm text-gray-500"><%= @payment_paid ? "Total pago" : "Total a pagar" %></span>
        <span class="text-xl font-bold text-[#1a2e1a]"><%= number_to_currency(total) %></span>
      </div>
    </section>

    <% if @payment_paid %>
      <section class="mt-4 bg-white rounded-xl border border-gray-100 shadow-sm p-5 sm:p-7">
        <label for="purchase-summary" class="block text-sm font-semibold text-[#1a2e1a] mb-2">
          Resumo para enviar no WhatsApp
        </label>
        <textarea id="purchase-summary" readonly rows="9" class="w-full rounded-lg border border-gray-200 bg-[#faf9f6] p-4 text-sm text-gray-700 leading-relaxed focus:outline-none focus:ring-2 focus:ring-[#c8a96e]"><%= @summary_text %></textarea>

        <button type="button" id="copy-summary-button" class="mt-4 w-full sm:w-auto bg-[#1a2e1a] hover:bg-[#2d4a2d] text-white text-sm font-bold px-5 py-3 rounded-lg transition">
          Copiar resumo
        </button>
        <p id="copy-summary-feedback" class="text-sm text-[#2d6a3a] font-medium mt-3 hidden" role="status">
          Resumo copiado. Agora e so enviar no grupo do WhatsApp.
        </p>
      </section>
    <% else %>
      <section class="mt-4 bg-white rounded-xl border border-gray-100 shadow-sm p-5 sm:p-7">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <p class="text-sm font-semibold text-[#1a2e1a]">Verificacao automatica ativa</p>
            <p class="text-sm text-gray-500 mt-1">A pagina atualiza sozinha quando o pagamento for confirmado.</p>
          </div>
          <button type="button" id="check-payment-button" class="w-full sm:w-auto border border-[#1a2e1a] text-[#1a2e1a] hover:bg-[#1a2e1a] hover:text-white text-sm font-bold px-5 py-3 rounded-lg transition">
            Verificar agora
          </button>
        </div>
      </section>
    <% end %>
  </main>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var copyButton = document.getElementById("copy-summary-button");
    var textarea = document.getElementById("purchase-summary");
    var feedback = document.getElementById("copy-summary-feedback");

    if (copyButton && textarea && feedback) {
      copyButton.addEventListener("click", function() {
        var text = textarea.value;

        function showFeedback() {
          feedback.classList.remove("hidden");
          copyButton.textContent = "Resumo copiado";
        }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(showFeedback).catch(function() {
            textarea.select();
            document.execCommand("copy");
            showFeedback();
          });
        } else {
          textarea.select();
          document.execCommand("copy");
          showFeedback();
        }
      });
    }

    var checkButton = document.getElementById("check-payment-button");
    var statusLabel = document.getElementById("payment-status-label");
    var statusUrl = <%= raw portal_reserva_confirmacao_status_path(codigo: params[:codigo]).to_json %>;

    function checkPaymentStatus() {
      if (!statusLabel) return;

      fetch(statusUrl, { headers: { "Accept": "application/json" } })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (data.status_label) statusLabel.textContent = data.status_label;
          if (data.paid) window.location.reload();
        })
        .catch(function() {});
    }

    if (checkButton) {
      checkButton.addEventListener("click", checkPaymentStatus);
      window.setInterval(checkPaymentStatus, 5000);
    }
  });
</script>
