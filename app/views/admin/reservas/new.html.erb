  }

  /* Melhorias para o datepicker */
  .flatpickr-calendar {
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  }

  .flatpickr-day.selected {
    background: #4299e1;
