<div class="bg-white rounded-md flex flex-col w-full mx-auto p-4 relative">

    <!-- Ícone de voltar (sem texto) -->
    <%= link_to checkout_cart_path,
                class: "absolute left-2 inline-flex items-center justify-center w-10 h-10
                        rounded-full border border-verde-escuro text-verde-escuro" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>

    <!-- Título da Cabana (centralizado) -->
    <p class="text-center text-4xl font-alice text-green-600">
      <i class="bi bi-check-circle-fill"></i> Pagamento confirmado. Obrigado!
    </p>
  </div>

<div class="bg-white rounded-md w-full max-w-4xl mx-auto p-6 flex flex-col gap-6 shadow-md">
  <!-- Serviços no Carrinho -->
  <div class="flex flex-col gap-4 border-t border-gray-300 pt-4">
    <h2 class="font-alice text-lg text-verde-escuro">
      <i class="bi bi-tools"></i> Serviços no Carrinho
    </h2>
    <% if @cart_items.any? %>
      <ul class="list-disc ml-6 text-gray-600">
        <% @cart_items.each do |cart_item| %>
          <% if cart_item.service.present? %>
            <li>
              <strong>Serviço:</strong> <%= cart_item.service.name %>,
              <strong>Preço:</strong> <%= number_to_currency(cart_item.service.price) %>,
              <strong>Quantidade:</strong> <%= cart_item.quantity %>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-600">Nenhum serviço adicionado ao carrinho.</p>
    <% end %>
    <div class="flex justify-center w-full">
      <%= link_to '<i class="bi bi-basket2"></i> &nbsp Adicionar mais serviços.'.html_safe, services_marketplace_index_path,
          class: 'bg-verde-escuro text-white px-4 py-2 rounded-md text-sm font-dm hover:bg-verde-escuro-hover transition flex items-center gap-2' %>
    </div>
  </div>

  <!-- Itens no Carrinho -->
  <div class="flex flex-col gap-4 border-t border-gray-300 pt-4">
    <h2 class="font-alice text-lg text-verde-escuro">
      <i class="bi bi-box"></i> Itens no Carrinho
    </h2>
    <% if @cart_items.any? %>
      <ul class="list-disc ml-6 text-gray-600">
        <% @cart_items.each do |cart_item| %>
          <% if cart_item.item.present? %>
            <li>
              <strong>Item:</strong> <%= cart_item.item.name %>,
              <strong>Preço:</strong> <%= number_to_currency(cart_item.item.price) %>,
              <strong>Quantidade:</strong> <%= cart_item.quantity %>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-600">Nenhum item adicionado ao carrinho.</p>
    <% end %>
    <div class="flex justify-center w-full">
      <%= link_to '<i class="bi bi-bag-check"></i> &nbsp Adicionar mais itens.'.html_safe, items_marketplace_index_path,
          class: 'bg-verde-escuro text-white px-4 py-2 rounded-md text-sm font-dm hover:bg-verde-escuro-hover transition flex items-center gap-2' %>
    </div>
  </div>
</div>
<%= render 'shared/wppButton' %>
