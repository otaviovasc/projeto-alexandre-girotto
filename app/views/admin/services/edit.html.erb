<div class="container py-4">
  <%= form_with model: [:admin, @service], local: true do |form| %>
    <% if @service.errors.any? %>
      <div id="error_explanation">
        <h2><%= pluralize(@service.errors.count, "error") %> prohibited this service from being saved:</h2>
        <ul>
        <% @service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :name %>
      <%= form.text_field :name, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :description %>
      <%= form.text_area :description, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :price %>
      <%= form.number_field :price, step: 0.01, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label 'Duration in minutes' %>
      <%= form.number_field :duration, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :start_time %>
      <%= form.time_select :start_time %>
    </div>

    <div class="form-group">
      <%= form.label :end_time %>
      <%= form.time_select :end_time %>
    </div>

    <div class="form-group">
      <%= form.label :filial_id %>
      <%= form.collection_select :filial_id, Filial.all, :id, :name, { prompt: "Select a Filial" }, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :images %>
      <%= form.file_field :images, multiple: true %>
    </div>

  <div class="form-group">
      <%= form.label :user_id %>
      <%= form.collection_select :user_id, User.where(role: 'service_provider'), :id, :email, { prompt: "Select a Service Provider" }, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :show_in_marketplace, 'Show on Marketplace?' %>
      <%= form.check_box :show_in_marketplace %>
    </div>

    <%= form.submit 'Save Service', class: "btn btn-primary" %>
  <% end %>


<!-- Exibição e Remoção de Imagens (Fora do Formulário) -->
  <% if @service.images.attached? %>
    <h2 class="mt-5 mb-3">Imagens Atuais</h2>
    <div class="row">
      <% @service.images.each do |image| %>
        <div class="col-md-3 mb-4">
          <div class="card h-100 position-relative">
            <img src="<%= url_for(image) %>" alt="<%= @service.name %> Image" class="card-img-top" style="height: 150px; object-fit: cover;">
            <div class="card-body">
              <%= button_to 'Remover', remove_image_admin_service_path(@service, image.id),
                method: :delete,
                data: { confirm: 'Tem certeza que deseja remover esta imagem?' },
                class: 'btn btn-sm btn-danger w-100' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
