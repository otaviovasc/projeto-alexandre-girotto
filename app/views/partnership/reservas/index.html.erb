<div class="container mt-4 partnership-dashboard">
  <style>
    .partnership-dashboard .goal-card {
      border: 1px solid #e2e8f0;
      border-left-width: 6px;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
    }
    .partnership-dashboard .goal-card.goal-below {
      border-left-color: #f59e0b;
    }
    .partnership-dashboard .goal-card.goal-ok {
      border-left-color: #16a34a;
    }
    .partnership-dashboard .goal-card.goal-above {
      border-left-color: #dc2626;
    }
    .partnership-dashboard .goal-count {
      font-size: 2rem;
      font-weight: 700;
      line-height: 1;
    }
    .partnership-dashboard .year-summary-panel {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
    }
    .partnership-dashboard .year-summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 0.5rem;
    }
    .partnership-dashboard .year-month-link {
      display: block;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 0.75rem;
      color: inherit;
      text-decoration: none;
      background: #f8fafc;
    }
    .partnership-dashboard .year-month-link:hover {
      border-color: #93c5fd;
      background: #eff6ff;
    }
    .partnership-dashboard .year-month-link.active {
      border-color: #2563eb;
      background: #dbeafe;
    }
    .partnership-dashboard .year-count-line {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.9rem;
    }
    .partnership-dashboard .month-goal-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .partnership-dashboard .month-goal-item {
      border: 1px solid #e2e8f0;
      border-left-width: 5px;
      border-radius: 6px;
      padding: 0.75rem;
      background: #f8fafc;
    }
    .partnership-dashboard .month-goal-item.goal-below {
      border-left-color: #f59e0b;
    }
    .partnership-dashboard .month-goal-item.goal-ok {
      border-left-color: #16a34a;
    }
    .partnership-dashboard .month-goal-item.goal-above {
      border-left-color: #dc2626;
    }
    .partnership-dashboard .calendar-card,
    .partnership-dashboard .list-card {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
    }
    .partnership-dashboard .partnership-row {
      background: #fff8db !important;
    }
    .partnership-dashboard .partnership-row td {
      border-color: rgba(245, 158, 11, 0.25) !important;
    }
  </style>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="mb-1">Painel de Parcerias</h1>
      <p class="text-muted mb-0">Acompanhe as metas do mês, a disponibilidade e as parcerias criadas.</p>
    </div>
    <%= link_to 'Nova Reserva de Parceria', new_partnership_reserva_path, class: 'btn btn-primary' %>
  </div>

  <div class="year-summary-panel p-3 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <h4 class="mb-0">Resumo de <%= @summary_year %></h4>
      <div class="d-flex gap-2">
        <%= link_to 'Ano anterior', partnership_dashboard_path(start_date: Date.new(@previous_year, 1, 1)), class: 'btn btn-outline-secondary btn-sm' %>
        <%= link_to 'Próximo ano', partnership_dashboard_path(start_date: Date.new(@next_year, 1, 1)), class: 'btn btn-outline-secondary btn-sm' %>
      </div>
    </div>

    <div class="year-summary-grid">
      <% @yearly_summary_rows.each do |summary| %>
        <% active_month = summary[:month_start].year == @reference_date.year && summary[:month_start].month == @reference_date.month %>
        <%= link_to partnership_dashboard_path(start_date: summary[:month_start].strftime('%Y-%m-%d'), anchor: 'calendario-parcerias'),
                    class: "year-month-link #{'active' if active_month}" do %>
          <div class="fw-semibold mb-2"><%= t('date.month_names')[summary[:month]].capitalize %></div>
          <% @monthly_goal_rows.each do |goal| %>
            <% label = goal[:filial_name].include?('Serra') ? 'Serra' : 'Fattoria' %>
            <div class="year-count-line">
              <span><%= label %></span>
              <strong><%= summary[:counts][goal[:filial_name]].to_i %></strong>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div id="calendario-parcerias" class="calendar-card p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h4 class="mb-0">Calendário de Disponibilidade</h4>
        <div class="text-muted">Metas de <%= @reference_date.strftime('%m/%Y') %> pela data da estadia</div>
      </div>
      <span class="text-muted">Datas sem faixa colorida estão livres.</span>
    </div>

    <div class="month-goal-strip">
      <% @monthly_goal_rows.each do |goal| %>
        <% goal_class = "goal-#{goal[:status]}" %>
        <% status_label =
          case goal[:status]
          when :below
            'Abaixo do mínimo'
          when :above
            'Acima do máximo'
          else
            'Dentro da meta'
          end
        %>
        <% progress_percent = goal[:max].positive? ? [((goal[:count].to_f / goal[:max]) * 100).round, 100].min : 0 %>
        <div class="month-goal-item <%= goal_class %>">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
              <div class="fw-semibold"><%= goal[:filial_name] %></div>
              <div class="text-muted">Meta <%= goal[:min] %> a <%= goal[:max] %></div>
            </div>
            <div class="text-end">
              <div class="goal-count"><%= goal[:count] %></div>
              <div class="text-muted"><%= status_label %></div>
            </div>
          </div>
          <div class="progress mt-2" style="height: 8px;">
            <div class="progress-bar <%= goal[:status] == :above ? 'bg-danger' : 'bg-success' %>" style="width: <%= progress_percent %>%"></div>
          </div>
        </div>
      <% end %>
    </div>

    <%= month_calendar(
          events: @reservas_calendar,
          start_date: @reference_date,
          attribute: :start_date,
          end_attribute: :end_date,
          previous_link: "<i class='bi bi-arrow-left'></i>".html_safe,
          next_link:     "<i class='bi bi-arrow-right'></i>".html_safe,
          title: ->(start_date){ start_date.strftime('%B %Y') }
        ) do |date, reservas_for_date| %>

      <div class="day-content">
        <span class="day-number"><%= date.day %></span>

        <% reservas_for_date.each do |reserva| %>
          <% is_start = (reserva.start_date == date) %>
          <% is_end   = (reserva.end_date   == date) %>
          <% same_day = (reserva.start_date == reserva.end_date && reserva.start_date == date) %>
          <% color_style = "background-color: #{reserva.cabana.color};" %>
          <% css_class =
            if same_day
              'start-end'
            elsif is_start
              'start'
            elsif is_end
              'end'
            else
              'middle'
            end
          %>
          <% top_offset_value = @top_offset[reserva.cabana_id] || 0 %>

          <div class="reserva-line <%= css_class %>"
               style="<%= color_style %> top: <%= top_offset_value %>px;"
               title="<%= reserva.cabana.name %>"></div>
        <% end %>
      </div>
    <% end %>

    <hr>
    <%= render 'admin/reservas/legend' %>
  </div>

  <div class="list-card mb-4">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0">Lista de Parcerias</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-striped align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Criada em</th>
            <th>Data Início</th>
            <th>Data Fim</th>
            <th>Cabana</th>
            <th>Filial</th>
            <th>Status</th>
            <th>Preço Total</th>
            <th>Hóspede</th>
            <th>Telefone</th>
            <% if current_user.admin? %>
              <th>Criada por</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% if @partnership_reservas.any? %>
            <% @partnership_reservas.each do |reserva| %>
              <tr class="partnership-row">
                <td><%= reserva.id %></td>
                <td><%= reserva.created_at&.in_time_zone('America/Sao_Paulo')&.strftime('%d/%m/%Y - %H:%M') %></td>
                <td><%= reserva.start_date&.strftime('%d/%m/%y') || '-' %></td>
                <td><%= reserva.end_date&.strftime('%d/%m/%y') || '-' %></td>
                <td>
                  <div class="legend-color me-2" style="background-color: <%= reserva.cabana.color %>"></div>
                  <%= reserva.cabana.name %>
                </td>
                <td><%= reserva.cabana.filial&.name || '-' %></td>
                <td>
                  <span class="badge <%= badge_class(reserva.payment_status) %>">
                    <%= status_translate(reserva.payment_status) %>
                  </span>
                </td>
                <td><%= number_to_currency(reserva.total_price, unit: 'R$') %></td>
                <td>
                  <span title="<%= reserva.user.email %>"><%= reserva.user.name %></span>
                </td>
                <td>
                  <span title="<%= reserva.user.email %>"><%= reserva.user.telephone.presence || '-' %></span>
                </td>
                <% if current_user.admin? %>
                  <td><%= reserva.partnership_creator&.name || reserva.partnership_creator&.email || '-' %></td>
                <% end %>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="<%= current_user.admin? ? 11 : 10 %>" class="text-center text-muted py-4">
                Nenhuma parceria criada ainda.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    const calendar = document.getElementById('calendario-parcerias');
    if (!calendar) return;

    calendar.querySelectorAll('.calendar-heading nav a').forEach(function(link) {
      const href = link.getAttribute('href');
      if (href && !href.includes('#')) {
        link.setAttribute('href', href + '#calendario-parcerias');
      }
    });

    if (window.location.hash === '#calendario-parcerias') {
      requestAnimationFrame(function() {
        calendar.scrollIntoView({ block: 'start' });
      });
    }
  });
</script>
