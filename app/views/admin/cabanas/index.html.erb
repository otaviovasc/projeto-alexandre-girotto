<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4">Todas as Cabanas</h1>

  <div class="d-flex gap-2 mb-4">
    <%= link_to 'Painel Administrativo', authenticated_root_path, class: 'btn btn-secondary d-flex align-items-center' %>
    <%= link_to 'Gerenciar Reservas', admin_reservas_path, class: 'btn btn-secondary d-flex align-items-center' %>
    <%= link_to 'Gerenciar Usuários', admin_users_path, class: 'btn btn-secondary d-flex align-items-center' %>
    <%= link_to 'Nova Cabana', new_admin_cabana_path, class: 'btn btn-primary d-flex align-items-center' %>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-hover shadow-sm">
      <thead class="table-light">
        <tr>
          <th class="py-2 px-4">Nome</th>
          <th class="py-2 px-4">Preço</th>
          <th class="py-2 px-4">Filial</th>
          <th class="py-2 px-4">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @cabanas.each do |cabana| %>
          <tr>
            <td class="py-2 px-4"><%= cabana.name %></td>
            <td class="py-2 px-4"><%= number_to_currency(cabana.price) %></td>
            <td class="py-2 px-4"><%= cabana.filial.name %></td>
            <td class="py-2 px-4 d-flex gap-2">
              <%= link_to 'Visualizar', admin_cabana_path(cabana), class: 'btn btn-sm btn-info' %>
              <%= link_to 'Editar', edit_admin_cabana_path(cabana), class: 'btn btn-sm btn-warning' %>
              <%= link_to 'Editar Links de Importação', edit_import_links_admin_cabana_path(cabana), class: 'btn btn-sm btn-primary' %>
              <%= button_to 'Excluir', admin_cabana_path(cabana), method: :delete, data: { confirm: 'Você tem certeza?' }, class: 'btn btn-sm btn-danger' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
