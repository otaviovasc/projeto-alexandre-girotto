<div>
    <div class="bg-creme">
        <div class="flex flex-col gap-2 lg:gap-16">
            <!-- Slider Section -->
            <div class="flex flex-col lg:flex-row gap-4 lg:gap-16 px-6 lg:px-16 pt-16 lg:py-24">
                <div class="swiper-container swiper-exp lg:w-1/2 lg:h-[400px] aspect-square">
                    <div class="swiper-wrapper relative">
                        <% (1..14).each do |i| %>
                            <div class="swiper-slide p-4"
                                style="background-image: url('<%= asset_path("home#{i}.png") %>'); background-size: cover; background-position: center;">
                            </div>
                        <% end %>
                    </div>
                </div>
                <div class="flex flex-col justify-center lg:w-1/2">
                    <p class="uppercase font-dm text-gray-500 text-base leading-10">Experiências</p>
                    <p class="font-alice text-preto-fill font-light text-2xl lg:text-4xl mt-4">
                        Mindfulness, conexão com a natureza e uma vida muito melhor.
                    </p>
                    <p class="font-dm text-gray-500 text-base mt-4">
                        Nós somos comprometidos com o bem-estar, sustentabilidade e uma obrigação em transformar a sua
                        vida. Lorem ipsum dolor sit amet consectetur adipisicing elit. Obcaecati neque eum quam quisquam
                        itaque culpa, omnis corporis consequatur eligendi sint!
                    </p>
                    <div class="flex items-center gap-2 mt-4">
                        <p class="text-laranja font-dm text-base leading-10">
                            <%= link_to "Quais são as experiências?", "/experiencias" %>
                        </p>
                        <i class="fa-solid fa-chevron-right text-laranja text-xs"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('turbo:load', function () {
        var swiper = new Swiper('.swiper-exp', {
            loop: true,
            autoplay: {
                delay: 3000,
            },
            speed: 2000,
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
                dynamicBullets: true, // Ativa as bolinhas dinâmicas
                dynamicMainBullets: 3, // Define o número máximo de bolinhas visíveis
            },
            allowTouchMove: true,
            disableOnInteraction: false
        });
    });
</script>
