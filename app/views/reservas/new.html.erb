<div class="mt-4 pt-16">
  <div class="bg-white rounded-md flex flex-col w-full mx-auto p-4 relative">

    <!-- Ícone de voltar (sem texto) -->
    <%= link_to cabanas_path,
                class: "absolute left-2 inline-flex items-center justify-center w-10 h-10
                        rounded-full border border-verde-escuro text-verde-escuro
                        hover:bg-verde-escuro hover:text-white transition-colors duration-300
                        focus:outline-none focus:ring-2 focus:ring-verde-escuro" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>

    <!-- Título da Cabana (centralizado) -->
    <p class="text-center text-4xl font-alice text-verde-escuro">
      <%= @cabana.name %>
    </p>
  </div>

  <!-- Slider de Imagens da Cabana -->
  <div class="flex flex-col items-center m-8">
    <%= render partial: "shared/cabana_show_slider", locals: { cabana: @cabana, images: @cabana.images } %>
  </div>

  <!-- Botão para scrollar até a seção de seleção de datas -->
  <div id="scroll-button-container" class="fixed bottom-8 left-8 z-50">
    <button
      id="scroll-to-dates"
      class="bg-verde-escuro text-white p-4 rounded-full shadow-lg hover:bg-green-700 transition-colors">
      Reservar Agora
    </button>
  </div>


  <!-- Formulário de Nova Reserva -->
  <div class="flex flex-col gap-6 px-8 mt-8 bg-white rounded-md p-6 shadow-md">

    <% @infos_da_cabana.each do |info| %>
      <% if info.info_type == "intro" %>
        <!-- Seção de introdução com destaque suave -->
        <div class="bg-gray-100 p-6 rounded-lg mb-8">
          <p class="text-xl font-semibold font-dm text-verde-escuro">
            <%= info.title %>
          </p>
          <p class="text-lg font-alice text-verde-escuro mt-2">
            <%= simple_format(info.content) %>
          </p>
        </div>
      <% end %>
    <% end %>

    <% @infos_da_cabana.each do |info| %>
      <% if info.info_type == "description" %>
        <p class="text-xl font-bold font-dm text-verde-escuro">
          A <%= @cabana.name %>
        </p>
        <p class="text-lg font-alice text-verde-escuro">
          <%= simple_format(info.content) %>
        </p>
      <% end %>
    <% end %>

    <% @infos_da_cabana.each do |info| %>
      <% if info.info_type == "comodidades" %>
        <p class="text-xl font-bold font-dm text-verde-escuro">Comodidades:</p>
        <p class="text-lg font-dm text-verde-escuro max-w-6/10">
          <%= simple_format(info.content) %>
        </p>
      <% end %>
      <% if info.info_type == "other" %>
        <p class="text-xl font-bold font-dm text-verde-escuro">Fatores Chave:</p>
        <p class="text-lg font-dm max-w-8/10 text-verde-escuro">
          <%= simple_format(info.content) %>
        </p>
      <% end %>
    <% end %>

    <%= form_with model: [@cabana, @reserva], local: true, html: { class: 'flex flex-col gap-6' } do |form| %>
      <!-- Campo de Seleção de Datas -->
      <div class="flex flex-col gap-4" id="date-selection">
        <label for="reservation_date_range" class="font-dm text-lg text-terracota">Selecione as datas</label>
        <input type="text" id="reservation_date_range" data-cabana-id="<%= @cabana.id %>"
          placeholder="Selecione as datas"
          class="w-full bg-transparent border border-terracota rounded-md px-4 py-2 text-terracota" />
        <%= form.hidden_field :start_date, id: "start_date" %>
        <%= form.hidden_field :end_date, id: "end_date" %>
      </div>

      <!-- Serviços adicionais -->
      <div class="flex flex-col gap-4">
        <h3 class="font-alice text-lg text-verde-escuro">Serviços Adicionais</h3>
        <div class="flex items-center gap-2">
          <%= check_box_tag 'reserva[include_breakfast]', '1', false, id: 'include_breakfast',
            class: 'w-5 h-5 text-verde-escuro border-gray-300 rounded focus:ring focus:ring-verde-escuro' %>
          <label for="include_breakfast" class="font-dm text-terracota text-md">Incluir café da manhã?</label>
        </div>
        <div id="breakfast_quantity_container" class="flex flex-col gap-2 pl-6 hidden">
          <label class="font-dm text-lg text-terracota">
             Café da manhã: R$<%= @breakfast_service.price %>/dia
          </label>
          <div class="flex items-center gap-2">
            <%= number_field_tag 'reserva[breakfast_quantity]', 1, min: 0, id: 'breakfast_quantity',
              class: 'w-16 text-center border border-terracota rounded-md hidden px-2' %>
          </div>
        </div>
      </div>

      <!-- Total -->
      <div class="flex flex-col gap-2">
        <h3 class="font-alice text-lg text-verde-escuro">Total:</h3>
        <p id="total_price" class="font-dm text-lg text-terracota">R$0.00</p>
      </div>

      <!-- Botão de Submissão -->
      <div class="font-dm bg-botao-verde rounded-3xl flex justify-center items-center p-3 mt-4">
        <%= form.submit 'Reservar', class: 'uppercase font-light text-white w-full bg-transparent' %>
      </div>
    <% end %>
  </div>

  <!-- Funil Form e Footer -->
  <%= render 'shared/funilform' %>
  <%= render 'shared/footer' %>
  <%= render 'shared/wppButton' %>
</div>


<script>
  document.addEventListener("turbo:load", function() {
    const cabanaId = document.getElementById('reservation_date_range').dataset.cabanaId;
    let includeBreakfast = false;

    const includeBreakfastCheckbox = document.getElementById('include_breakfast');
    const breakfastQuantityContainer = document.getElementById('breakfast_quantity_container');
    const totalPriceElement = document.getElementById('total_price');

    includeBreakfastCheckbox.addEventListener('change', function() {
      includeBreakfast = includeBreakfastCheckbox.checked;
      breakfastQuantityContainer.style.display = includeBreakfast ? 'block' : 'none';
      updateTotalPrice();
    });

    const dateRangeInput = document.getElementById("reservation_date_range");
    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");

    dateRangeInput.addEventListener("change", function(event) {
      const dates = event.target.value.split(" to ");
      // Ensure that both start and end dates are set
      if (dates.length === 2) {
        startDateInput.value = dates[0];
        endDateInput.value = dates[1];
        updateTotalPrice();  // Update the total price when both dates are set
      }
    });

    fetch(`/cabanas/${cabanaId}/unavailable_dates`)
    .then(response => response.json())
    .then(dates => {
      flatpickr("#reservation_date_range", {
        mode: "range",
        minDate: "today",
        dateFormat: "Y-m-d",
        disable: dates,
        onChange: function(selectedDates, dateStr, instance) {
          // Proceed only if a complete range is selected
          if (selectedDates.length === 2) {
            const startDate = selectedDates[0];
            const endDate = selectedDates[1];
            // Calculate the difference in days
            const diffDays = (endDate - startDate) / (1000 * 60 * 60 * 24);
            // Check if it is a 1-night stay starting on Friday (5) or Saturday (6)
            if (diffDays === 1 && (startDate.getDay() === 5 || startDate.getDay() === 6)) {
              alert("Reservas de apenas uma noite que comecem na sexta-feira ou no sábado não são permitidas. Por favor, escolha outro intervalo de datas.");
              // Clear the selection
              instance.clear();
            }
          }
        }
      });
    });


    const quantityInput = document.getElementById("breakfast_quantity");
    const quantityUpButton = document.getElementById("quantity_up");
    const quantityDownButton = document.getElementById("quantity_down");

    quantityUpButton.addEventListener("click", function() {
      quantityInput.value = parseInt(quantityInput.value) + 1;
      console.log(`Quantity Up: ${quantityInput.value}`);
      updateTotalPrice();  // Update price after changing quantity
    });

    quantityDownButton.addEventListener("click", function() {
      if (parseInt(quantityInput.value) > 0) {
        quantityInput.value = parseInt(quantityInput.value) - 1;
        console.log(`Quantity Down: ${quantityInput.value}`);
        updateTotalPrice();  // Update price after changing quantity
      }
    });

    function updateTotalPrice() {
      const startDate = startDateInput.value;
      const endDate = endDateInput.value;
      const breakfastQuantity = parseInt(quantityInput.value); // Get breakfast quantity

      if (startDate && endDate) {
        const url = `/cabanas/${cabanaId}/reservas/calculate_price?start_date=${startDate}&end_date=${endDate}&include_breakfast=${includeBreakfast}&breakfast_quantity=${breakfastQuantity}`;

        fetch(url)
          .then(response => response.json())
          .then(data => {
            totalPriceElement.textContent = `R$${data.total_price.toFixed(2)}`;
          });
      }
    }
  });
</script>

<script>
  document.addEventListener("turbo:load", function() {
    const scrollToDatesButton = document.getElementById("scroll-to-dates");
    const reservationSection = document.getElementById('date-selection');

    if (scrollToDatesButton && reservationSection) {
      scrollToDatesButton.addEventListener("click", function() {
        // Calcula o offset para centralizar
        const offset = -window.innerHeight / 4; // Ajuste fino para centralizar
        const sectionTop = reservationSection.getBoundingClientRect().top + window.scrollY + offset;

        // Scroll suavemente até a posição calculada
        window.scrollTo({
          top: sectionTop,
          behavior: "smooth"
        });

        // Oculta o botão depois do scroll
        scrollToDatesButton.style.display = "none";
      });
    }
  });
</script>
