<!DOCTYPE html>
<html>
  <head>
    <title>Villaggio ADM v2</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Villaggio ADM v2">
    <meta name="apple-mobile-web-app-title" content="Villaggio ADM v2">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#55613a">
    <link rel="manifest" href="/manifest.webmanifest?v=2">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/adm-icon-180.png?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/adm-icon-32.png?v=2">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/adm-icon-192.png?v=2">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if current_user&.operations_viewer? && ENV['WEB_PUSH_PUBLIC_KEY'].present? %>
      <meta name="villaggio-web-push-public-key" content="<%= ENV['WEB_PUSH_PUBLIC_KEY'] %>">
      <meta name="villaggio-web-push-register-path" content="<%= admin_web_push_subscription_path %>">
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
    <%# bootstrap %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous" defer></script>
    <%# flatpicker calendar %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <%# BootstrapIcons %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css">
    
    <%# jQuery & Select2 %>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  </head>

  <body>
    <% unless devise_controller? %>
      <%= render 'shared/navadmin' %>
    <% end %>
      <div class="container-fluid">
        <%= render "shared/flashes" %>
        <div class="row py-3">
          <main class="col-12">
            <%= yield %>
          </main>
        </div>
      </div>
      </div>
    
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
      // Custom Turbo Confirm com SweetAlert2
      // Define globalmente para funcionar em todas as views (show, edit, index)
      Turbo.setConfirmMethod((message, element) => {
        // Verifica se é uma exclusão de reserva (pela mensagem)
        if (message.includes("excluir esta reserva") || message.includes("excluir")) {
          return new Promise((resolve, reject) => {
            Swal.fire({
              title: 'Tem certeza?',
              text: "Você não poderá reverter isso!",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#ef4444',
              cancelButtonColor: '#64748b',
              confirmButtonText: 'Sim, excluir!',
              cancelButtonText: 'Cancelar'
            }).then((result) => {
              resolve(result.isConfirmed);
            });
          });
        } else {
          // Fallback para o confirm nativo para outras ações
          return Promise.resolve(window.confirm(message));
        }
      });
    </script>
  </body>
</html>
