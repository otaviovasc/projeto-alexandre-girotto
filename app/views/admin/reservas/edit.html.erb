<% if @reserva.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@reserva.errors.count, "erro") %> impediram que a reserva fosse salva:</h2>
    <ul>
      <% @reserva.errors.full_messages.each do |mensagem| %>
        <li><%= mensagem %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, @reserva], local: true do |form| %>
  <div class="mb-3">
    <%= form.label :cabana_id, 'Cabana', class: 'form-label' %>
    <%= form.collection_select :cabana_id, Cabana.all, :id, :name, { prompt: 'Selecione uma cabana' }, { class: 'form-select', id: 'reserva_cabana_id' } %>
  </div>

  <div>
    <%= form.label :user %>
    <%= form.collection_select :user_id, User.all, :id, :email %>
  </div>

  <!-- Added observation field -->
  <div class="mb-3">
    <%= form.label :observation, 'Observation', class: 'form-label' %>
    <%= form.text_area :observation, class: 'form-control' %>
  </div>

  <div class="mb-3" id="date-selection">
    <label for="reservation_date_range" class="form-label">Selecione as datas</label>
    <input type="text" id="reservation_date_range" placeholder="Selecione as datas" class="form-control" />
    <%= form.hidden_field :start_date, id: "start_date" %>
    <%= form.hidden_field :end_date, id: "end_date" %>
  </div>

  <div>
    <%= form.submit 'Update Reserva', class: 'btn btn-primary' %>
  </div>
<% end %>

<%= link_to 'Back', admin_reservas_summary_path %>

<script>
  document.addEventListener("turbo:load", function() {
    const cabanaSelect = document.getElementById('reserva_cabana_id');
    const dateRangeInput = document.getElementById("reservation_date_range");
    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");

    // Função para inicializar o flatpickr com as datas indisponíveis
    function initializeFlatpickr(cabanaId) {
      if (!cabanaId) return;

      fetch(`/cabanas/${cabanaId}/unavailable_dates`)
        .then(response => response.json())
        .then(disabledDates => {
          // Se já houver um flatpickr inicializado, destrua-o antes
          if (dateRangeInput._flatpickr) {
            dateRangeInput._flatpickr.destroy();
          }
          flatpickr("#reservation_date_range", {
            mode: "range",
            minDate: "today",
            dateFormat: "Y-m-d",
            disable: disabledDates,
            onChange: function(selectedDates, dateStr, instance) {
              // Se tiver duas datas selecionadas, atualize os hidden fields
              if (selectedDates.length === 2) {
                startDateInput.value = instance.formatDate(selectedDates[0], "Y-m-d");
                endDateInput.value = instance.formatDate(selectedDates[1], "Y-m-d");
              }
            }
          });
        })
        .catch(err => {
          console.error("Erro ao buscar datas indisponíveis:", err);
        });
    }

    // Quando o select de cabana mudar, reinicialize o flatpicker
    cabanaSelect.addEventListener("change", function(e) {
      const selectedCabanaId = e.target.value;
      initializeFlatpickr(selectedCabanaId);
    });

    // Se já houver um valor selecionado ao carregar a página, inicialize
    if (cabanaSelect.value) {
      initializeFlatpickr(cabanaSelect.value);
    }
  });
</script>
