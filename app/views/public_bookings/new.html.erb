<% content_for :title, "Reserva online - Villaggio Girotto" %>

<main class="vg-public-page">
  <div class="vg-public-shell">
    <div class="vg-topline">
      <span class="vg-brand-name">Villaggio Girotto</span>
      <span class="vg-page-status">Checkout seguro</span>
    </div>

    <header class="vg-hero">
      <div>
        <p class="vg-kicker">Reserva online</p>
        <h1 class="vg-title">Finalize sua estadia.</h1>
        <p class="vg-lead">
          Confirme os dados da reserva, aceite os termos e siga para o pagamento. As datas ficam pré-reservadas por 15 minutos enquanto o pagamento é finalizado.
        </p>
      </div>
      <div class="vg-note">
        Pagamento processado pela Cielo. Após a confirmação, a reserva é registrada automaticamente no sistema do Villaggio Girotto.
      </div>
    </header>

    <% if @errors.present? %>
      <div class="vg-alert error mb-5">
        <p class="font-semibold">Não foi possível iniciar a reserva.</p>
        <ul class="mt-2 list-disc pl-5">
          <% @errors.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: public_bookings_path, scope: :booking, method: :post, local: true, class: "vg-form", id: "public-booking-form" do |form| %>
      <section class="vg-card">
        <h2 class="vg-card-title">Dados da estadia</h2>
        <p class="vg-card-copy">Escolha a cabana, as datas da estadia e os serviços opcionais disponíveis para a sua reserva.</p>
        <div class="vg-field-grid three">
          <div class="sm:col-span-3">
            <%= form.label :cabana_id, "Cabana", class: "vg-label" %>
            <%= form.select :cabana_id,
                options_for_select(@cabanas.map { |cabana| [cabana.name, cabana.id, { data: { filial_id: cabana.filial_id } }] }, @booking_values["cabana_id"]),
                { prompt: "Selecione a cabana" },
                required: true,
                id: "booking-cabana",
                class: "vg-input" %>
          </div>

          <div>
            <%= form.label :start_date, "Entrada", class: "vg-label" %>
            <%= form.date_field :start_date,
                value: @booking_values["start_date"],
                required: true,
                id: "booking-start-date",
                class: "vg-input" %>
          </div>

          <div>
            <%= form.label :end_date, "Saída", class: "vg-label" %>
            <%= form.date_field :end_date,
                value: @booking_values["end_date"],
                required: true,
                id: "booking-end-date",
                class: "vg-input" %>
          </div>
        </div>
      </section>

      <section class="vg-card">
        <h2 class="vg-card-title">Responsável pela reserva</h2>
        <div class="vg-field-grid three">
          <div>
            <%= form.label :guest_name, "Nome e sobrenome", class: "vg-label" %>
            <%= form.text_field :guest_name,
                value: @booking_values["guest_name"],
                required: true,
                autocomplete: "name",
                placeholder: "Ex.: Maria Silva",
                class: "vg-input" %>
          </div>

          <div>
            <%= form.label :guest_email, "E-mail", class: "vg-label" %>
            <%= form.email_field :guest_email,
                value: @booking_values["guest_email"],
                required: true,
                autocomplete: "email",
                placeholder: "voce@email.com",
                class: "vg-input" %>
          </div>

          <div>
            <%= form.label :guest_phone, "WhatsApp", class: "vg-label" %>
            <%= form.telephone_field :guest_phone,
                value: @booking_values["guest_phone"],
                required: true,
                autocomplete: "tel",
                placeholder: "11999999999",
                class: "vg-input" %>
          </div>
        </div>
      </section>

      <section class="vg-card" id="services-section">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="vg-card-title">Serviços opcionais</h2>
            <p class="vg-card-copy">A compra de serviços fica disponível apenas com mais de 10 dias de antecedência.</p>
          </div>
          <p id="services-window-warning" class="vg-alert warning hidden">
            Para datas próximas, compre apenas a hospedagem e fale pelo WhatsApp sobre os serviços.
          </p>
        </div>

        <div class="vg-service-list">
          <% @services.each do |service| %>
            <div class="service-row vg-service-row"
                 data-filial-id="<%= service.filial_id %>">
              <label class="flex items-start gap-3">
                <%= check_box_tag "booking[service_items][#{service.id}][selected]", "1", false, class: "service-checkbox vg-checkbox mt-1" %>
                <span>
                  <span class="block font-semibold text-[#1a2e1a]"><%= service.name %></span>
                  <span class="block text-sm text-[#637066]"><%= number_to_currency(service.price, unit: 'R$ ', separator: ',', delimiter: '.') %></span>
                </span>
              </label>

              <div>
                <label class="vg-label">Data</label>
                <%= date_field_tag "booking[service_items][#{service.id}][service_date]",
                    nil,
                    class: "service-date vg-input py-2 text-sm" %>
              </div>

              <div>
                <label class="vg-label">Qtd</label>
                <%= number_field_tag "booking[service_items][#{service.id}][quantity]",
                    1,
                    min: 1,
                    class: "vg-input py-2 text-sm" %>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <section class="vg-action-card">
        <label class="flex items-start gap-3 text-sm leading-6 text-[#3f4b43]">
          <%= form.check_box :terms_accepted, required: true, class: "vg-checkbox mt-1 shrink-0" %>
          <span>Declaro que li, compreendi e concordo com os termos de hospedagem do Villaggio Girotto.</span>
        </label>

        <button type="submit" class="vg-button w-full">
          Pré-reservar e seguir para pagamento
        </button>
      </section>
    <% end %>
  </div>
</main>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var cabanaSelect = document.getElementById("booking-cabana");
    var startInput = document.getElementById("booking-start-date");
    var endInput = document.getElementById("booking-end-date");
    var warning = document.getElementById("services-window-warning");
    var serviceRows = Array.prototype.slice.call(document.querySelectorAll(".service-row"));
    var today = new Date();
    today.setHours(0, 0, 0, 0);

    function selectedFilialId() {
      var option = cabanaSelect.options[cabanaSelect.selectedIndex];
      return option ? option.dataset.filialId : "";
    }

    function servicesAllowed() {
      if (!startInput.value) return true;

      var start = new Date(startInput.value + "T00:00:00");
      var diffDays = Math.floor((start - today) / 86400000);
      return diffDays > 10;
    }

    function syncServiceRows() {
      var filialId = selectedFilialId();
      var startDate = startInput.value;
      var endDate = endInput.value;
      var allowed = servicesAllowed();

      if (warning) warning.classList.toggle("hidden", allowed);

      serviceRows.forEach(function(row) {
        var sameFilial = !!filialId && row.dataset.filialId === filialId;
        var visible = sameFilial && allowed;
        row.classList.toggle("hidden", !visible);

        row.querySelectorAll("input").forEach(function(input) {
          input.disabled = !visible;
        });

        var dateInput = row.querySelector(".service-date");
        if (dateInput) {
          dateInput.min = startDate || "";
          dateInput.max = endDate || "";
          if (startDate && !dateInput.value) dateInput.value = startDate;
        }

        if (!visible) {
          var checkbox = row.querySelector(".service-checkbox");
          if (checkbox) checkbox.checked = false;
        }
      });
    }

    [cabanaSelect, startInput, endInput].forEach(function(element) {
      if (element) element.addEventListener("change", syncServiceRows);
    });

    syncServiceRows();
  });
</script>
