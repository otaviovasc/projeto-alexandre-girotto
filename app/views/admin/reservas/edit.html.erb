<style>
  .reserva-edit-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .form-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .form-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .form-subtitle {
    color: #64748b;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .form-section {
    margin-bottom: 1.5rem;
  }

  .form-section-title {
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .form-section-title::before {
    content: '';
    width: 4px;
    height: 1rem;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border-radius: 2px;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-label {
    display: block;
    font-weight: 500;
    color: #374151;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .form-control, .form-select {
    width: 100%;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    background-color: #f8fafc;
  }

  .form-control:focus, .form-select:focus {
    border-color: #3b82f6;
    background-color: white;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    outline: none;
  }

  textarea.form-control {
    min-height: 80px;
    resize: vertical;
  }

  .form-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: #f8fafc;
    border-radius: 8px;
    border: 1.5px solid #e2e8f0;
    margin-bottom: 1rem;
  }

  .form-check-input {
    width: 1.2rem;
    height: 1.2rem;
    accent-color: #3b82f6;
  }

  .form-check-label {
    font-weight: 500;
    color: #374151;
  }

  .error-box {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.5rem;
    color: #dc2626;
  }

  .error-box h4 {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .service-item {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 0.75rem;
    transition: all 0.2s ease;
  }

  .service-item:hover {
    border-color: #cbd5e1;
  }

  .service-item.cancelled-service {
    opacity: 0.6;
    background: #fef2f2;
    border-color: #fecaca;
  }

  .service-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .service-name {
    font-weight: 600;
    color: #1e293b;
  }

  .service-price {
    color: #059669;
    font-weight: 600;
  }

  .status-badge {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    margin-left: 0.5rem;
  }

  .status-cancelled {
    background: #fee2e2;
    color: #991b1b;
  }

  .cancelled-badge {
    background: #dc2626;
    color: white;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .active-badge {
    background: #dcfce7;
    color: #166534;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .cancelled-info {
    background: #fef2f2;
    border: 1px dashed #fecaca;
    border-radius: 6px;
    padding: 0.75rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #7f1d1d;
  }

  .cancelled-info p {
    margin: 0.25rem 0;
  }

  .cancel-select {
    border-color: #e2e8f0;
  }

  .cancel-select:focus {
    border-color: #ef4444;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
  }

  .btn {
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .btn-secondary {
    background: #f1f5f9;
    color: #475569;
    border: 1.5px solid #e2e8f0;
  }

  .btn-secondary:hover {
    background: #e2e8f0;
    transform: translateY(-1px);
  }

  .add-service-check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .service-fields-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>

<div class="reserva-edit-container">
  <div class="form-card">
    <h1 class="form-title">✏️ Editar Reserva #<%= @reserva.id %></h1>
    <p class="form-subtitle">Atualize as informações da reserva</p>

    <% if @reserva.errors.any? %>
      <div class="error-box">
        <h4><%= pluralize(@reserva.errors.count, "erro") %> encontrado(s):</h4>
        <ul style="margin: 0; padding-left: 1.25rem;">
          <% @reserva.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [:admin, @reserva], local: true do |form| %>
      
      <!-- Informações Básicas -->
      <div class="form-section">
        <h3 class="form-section-title">Informações Básicas</h3>
        
        <div class="form-row">
          <div class="form-group">
            <%= form.label :cabana_id, 'Cabana *', class: 'form-label' %>
            <%= form.collection_select :cabana_id, Cabana.all, :id, :name, { prompt: 'Selecione' }, { class: 'form-control', id: 'reserva_cabana_id', required: true } %>
          </div>

          <div class="form-group">
            <%= form.label :user_id, 'Hóspede *', class: 'form-label' %>
            <%= form.collection_select :user_id, User.all, :id, :email, { prompt: 'Selecione' }, { class: 'form-control', required: true, id: 'user_select' } %>
          </div>
        </div>

        <div class="form-check">
          <%= form.fields_for :user do |user_fields| %>
            <%= user_fields.check_box :partner, class: 'form-check-input', id: 'partner_checkbox' %>
            <%= user_fields.label :partner, 'Marcar como Parceiro', class: 'form-check-label' %>
          <% end %>
        </div>
      </div>

      <!-- Datas -->
      <div class="form-section">
        <h3 class="form-section-title">Período da Reserva</h3>
        
        <div class="form-group">
          <label for="reservation_date_range" class="form-label">Datas de Check-in e Check-out *</label>
          <input type="text" id="reservation_date_range" placeholder="Clique para selecionar as datas" class="form-control" required
                 data-start-date="<%= @reserva.start_date&.strftime('%Y-%m-%d') %>"
                 data-end-date="<%= @reserva.end_date&.strftime('%Y-%m-%d') %>"
                 data-reserva-id="<%= @reserva.id %>" />
          <%= form.hidden_field :start_date, id: "start_date", required: true %>
          <%= form.hidden_field :end_date, id: "end_date", required: true %>
        </div>

        <div class="form-group">
          <%= form.label :observation, 'Observação / Origem', class: 'form-label' %>
          <%= form.text_area :observation, class: 'form-control', rows: 2, placeholder: 'Ex: Airbnb, Booking, Indicação...' %>
        </div>
      </div>

      <!-- Preço Total -->
      <div class="form-section">
        <h3 class="form-section-title">💰 Valor da Reserva</h3>
        <div class="form-group">
          <%= form.label :total_price, 'Preço Total *', class: 'form-label' %>
          <small class="text-muted d-block mb-2">Este valor é o total da hospedagem (sem contar serviços extras adicionados abaixo).</small>
          <%= form.number_field :total_price, class: 'form-control', step: '0.01', required: true, min: '0' %>
        </div>
      </div>

      <!-- Serviços Existentes -->
      <div class="form-section">
        <h3 class="form-section-title">🛎️ Serviços da Reserva</h3>
        
        <% if @reserva.reserva_services.any? %>
          <% @reserva.reserva_services.each_with_index do |rs, idx| %>
            <div class="service-item <%= rs.cancelled? ? 'cancelled-service' : '' %>" id="service_item_<%= rs.id %>">
              <%= form.fields_for :reserva_services, rs do |rsf| %>
                <%= rsf.hidden_field :id %>
                <%= rsf.hidden_field :service_id %>
                
                <div class="service-header">
                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span class="service-name"><%= rs.service.name %></span>
                    <% if rs.cancelled? %>
                      <span class="cancelled-badge">❌ CANCELADO</span>
                    <% else %>
                      <span class="active-badge">✓ Ativo</span>
                    <% end %>
                  </div>
                  <span class="service-price">R$ <%= number_with_precision(rs.service.price * rs.quantity, precision: 2) %></span>
                </div>
                
                <% if rs.cancelled? %>
                  <div class="cancelled-info">
                    <p>📅 Data: <%= rs.service_date&.strftime('%d/%m/%Y') || 'N/A' %></p>
                    <p>📦 Quantidade: <%= rs.quantity %></p>
                    <% if rs.observation.present? %>
                      <p>📝 Obs: <%= rs.observation %></p>
                    <% end %>
                    <p style="margin-top: 0.5rem; font-style: italic; color: #991b1b;">
                      Este serviço foi cancelado e não será cobrado.
                    </p>
                  </div>
                  <%= rsf.hidden_field :service_date %>
                  <%= rsf.hidden_field :quantity %>
                  <%= rsf.hidden_field :status %>
                  <%= rsf.hidden_field :observation %>
                <% else %>
                  <div class="service-fields-row">
                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label">📅 Data</label>
                      <%= rsf.date_field :service_date, class: 'form-control' %>
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label">📦 Qtd</label>
                      <%= rsf.number_field :quantity, class: 'form-control', min: 1 %>
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                      <label class="form-label">⚡ Ação</label>
                      <%= rsf.select :status, [['Manter Ativo', 'active'], ['🚫 Cancelar Serviço', 'cancelled']], {}, class: 'form-control cancel-select', id: "status_select_#{rs.id}", onchange: "confirmCancel(this, #{rs.id}, '#{rs.service.name}')" %>
                    </div>
                  </div>
                  <div class="form-group" style="margin-top: 0.5rem; margin-bottom: 0;">
                    <label class="form-label">📝 Observação</label>
                    <%= rsf.text_area :observation, class: 'form-control', rows: 2, placeholder: 'Ex: sem lactose, capricho na decoração...' %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p style="color: #94a3b8; text-align: center; padding: 1rem;">Nenhum serviço adicionado</p>
        <% end %>
      </div>

      <!-- Adicionar Novos Serviços -->
      <div class="form-section">
        <h3 class="form-section-title">➕ Adicionar Serviços</h3>
        
        <!-- Filtro por Região -->
        <div class="row mb-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Filtrar por Região</label>
            <select id="service-region-filter" class="form-control">
              <option value="">Todas as regiões</option>
              <option value="SP">São Paulo (SP)</option>
              <option value="MG">Minas Gerais (MG)</option>
            </select>
          </div>
        </div>
        
        <!-- Adicionar Serviço -->
        <div class="add-service-box border rounded p-3 mb-3" style="background: #f8fafc;">
          <div class="row align-items-end">
            <div class="col-md-5 mb-2 mb-md-0">
              <label class="form-label fw-bold">Serviço</label>
              <select id="service-select" class="form-control">
                <option value="">Selecione ou digite para buscar...</option>
                <% @services.each do |service| %>
                  <option value="<%= service.id %>" 
                          data-name="<%= service.name %>" 
                          data-price="<%= service.price %>"
                          data-region="<%= service.region %>">
                    <%= service.name %> - R$ <%= number_with_precision(service.price, precision: 2) %> (<%= service.region %>)
                  </option>
                <% end %>
              </select>
            </div>
            <div class="col-md-2 mb-2 mb-md-0">
              <label class="form-label fw-bold">Data *</label>
              <input type="date" id="service-date-input" class="form-control">
            </div>
            <div class="col-md-1 mb-2 mb-md-0">
              <label class="form-label fw-bold">Qtd</label>
              <input type="number" id="service-quantity-input" class="form-control" value="1" min="1">
            </div>
            <div class="col-md-2">
              <button type="button" id="add-service-btn" class="btn btn-success w-100" onclick="addServiceToList()">
                <i class="bi bi-plus-lg"></i> Adicionar
              </button>
            </div>
          </div>
          <div class="row mt-2">
            <div class="col-12">
              <label class="form-label fw-bold">📝 Observação <small class="text-muted fw-normal">(opcional)</small></label>
              <textarea id="service-observation-input" class="form-control" rows="2" placeholder="Ex: sem lactose, capricho na decoração..."></textarea>
            </div>
          </div>
        </div>
        
        <!-- Lista de Novos Serviços Adicionados -->
        <div id="services-list-container" class="border rounded p-3" style="min-height: 60px; background: #fff;">
          <h6 class="text-muted mb-3">📋 Novos Serviços <small>(ordenados por data)</small></h6>
          <div id="services-list">
            <p id="no-services-msg" class="text-center text-muted py-2">Nenhum novo serviço adicionado.</p>
          </div>
        </div>
        
        <!-- Container para hidden inputs dos novos serviços -->
        <div id="services-hidden-inputs" data-reserva-services-count="<%= @reserva.reserva_services.size %>"></div>
      </div>

      <!-- Ações -->
      <div class="form-actions">
        <%= form.submit '💾 Salvar Alterações', class: 'btn btn-primary' %>
        <%= link_to export_sheets_admin_reservas_path(redirect_to: 'edit', id: @reserva.id), class: 'btn btn-warning', data: { turbo_method: :get } do %>
          <i class="bi bi-cloud-upload"></i> Sincronizar com Sheets
        <% end %>
        <%= link_to '← Voltar', admin_reservas_summary_path, class: 'btn btn-secondary' %>
      </div>
    <% end %>
  </div>
</div>

<script>
  function confirmCancel(selectElement, serviceId, serviceName) {
    const serviceItem = document.getElementById('service_item_' + serviceId);
    
    if (selectElement.value === 'cancelled') {
      // Atualiza a aparência visual imediatamente
      serviceItem.classList.add('cancelled-service');
      serviceItem.style.opacity = '0.6';
      
      // Mostra uma mensagem de feedback
      const header = serviceItem.querySelector('.service-header');
      let existingWarning = serviceItem.querySelector('.cancel-warning');
      if (!existingWarning) {
        const warning = document.createElement('div');
        warning.className = 'cancel-warning';
        warning.style.cssText = 'background: #fef3c7; color: #92400e; padding: 0.5rem; border-radius: 4px; margin-top: 0.5rem; font-size: 0.85rem; text-align: center;';
        warning.innerHTML = '⚠️ Este serviço será CANCELADO ao salvar. Selecione "Manter Ativo" para desfazer.';
        header.parentNode.insertBefore(warning, header.nextSibling);
      }
    } else {
      // Se voltar para 'active', remove avisos visuais
      serviceItem.classList.remove('cancelled-service');
      serviceItem.style.opacity = '1';
      const warning = serviceItem.querySelector('.cancel-warning');
      if (warning) warning.remove();
    }
  }
</script>

<script>
  // Array para armazenar os novos serviços adicionados
  let addedServices = [];
  let serviceIndex = <%= @reserva.reserva_services.size %>;

  document.addEventListener("turbo:load", function() {
    // Resetar estado dos serviços a cada carregamento de página (evita acumular entre reservas)
    addedServices = [];
    serviceIndex = parseInt(document.querySelector('[data-reserva-services-count]')?.dataset.reservaServicesCount || '<%= @reserva.reserva_services.size %>');
    
    // Limpar UI de novos serviços
    const servicesList = document.getElementById('services-list');
    const hiddenInputs = document.getElementById('services-hidden-inputs');
    if (servicesList) {
      servicesList.innerHTML = '<p id="no-services-msg" class="text-center text-muted py-2">Nenhum novo serviço adicionado.</p>';
    }
    if (hiddenInputs) {
      hiddenInputs.innerHTML = '';
    }

    // Inicializar Select2 para o select de serviços
    $('#service-select').select2({
      theme: 'bootstrap-5',
      width: '100%',
      placeholder: 'Selecione ou digite para buscar...',
      allowClear: true
    });

    // Filtro por região
    const regionFilter = document.getElementById('service-region-filter');
    const serviceSelect = document.getElementById('service-select');

    if (regionFilter) {
      regionFilter.addEventListener('change', function() {
        const selectedRegion = this.value;
        const options = serviceSelect.querySelectorAll('option');
        
        options.forEach(option => {
          if (option.value === '') return; // Skip placeholder
          const region = option.dataset.region;
          if (selectedRegion === '' || region === selectedRegion) {
            option.style.display = '';
            option.disabled = false;
          } else {
            option.style.display = 'none';
            option.disabled = true;
          }
        });
        
        // Resetar seleção e atualizar Select2
        $('#service-select').val('').trigger('change');
      });
    }
  });

  function addServiceToList() {
    const selectEl = document.getElementById('service-select');
    const dateInput = document.getElementById('service-date-input');
    const quantityInput = document.getElementById('service-quantity-input');
    const observationInput = document.getElementById('service-observation-input');
    
    const serviceId = selectEl.value;
    const selectedOption = selectEl.options[selectEl.selectedIndex];
    const serviceName = selectedOption.dataset.name;
    const servicePrice = parseFloat(selectedOption.dataset.price);
    const serviceDate = dateInput.value;
    const quantity = parseInt(quantityInput.value) || 1;
    const observation = observationInput ? observationInput.value.trim() : '';

    // Validações
    if (!serviceId) {
      alert('Por favor, selecione um serviço.');
      return;
    }
    if (!serviceDate) {
      alert('Por favor, selecione a data do serviço.');
      return;
    }

    // Criar objeto do serviço
    const service = {
      id: serviceIndex++,
      serviceId: serviceId,
      name: serviceName,
      price: servicePrice,
      date: serviceDate,
      quantity: quantity,
      total: servicePrice * quantity,
      observation: observation
    };

    // Adicionar ao array
    addedServices.push(service);

    // Ordenar por data
    addedServices.sort((a, b) => new Date(a.date) - new Date(b.date));

    // Renderizar lista
    renderServicesList();

    // Limpar inputs
    $('#service-select').val('').trigger('change');
    dateInput.value = '';
    quantityInput.value = '1';
    if (observationInput) observationInput.value = '';
  }

  function removeService(id) {
    addedServices = addedServices.filter(s => s.id !== id);
    renderServicesList();
  }

  function renderServicesList() {
    const listContainer = document.getElementById('services-list');
    const hiddenInputsContainer = document.getElementById('services-hidden-inputs');

    // Limpar containers
    listContainer.innerHTML = '';
    hiddenInputsContainer.innerHTML = '';

    if (addedServices.length === 0) {
      listContainer.innerHTML = '<p id="no-services-msg" class="text-center text-muted py-2">Nenhum novo serviço adicionado.</p>';
      return;
    }

    // Renderizar cada serviço
    addedServices.forEach((service, index) => {
      // Formatar data para exibição
      const dateObj = new Date(service.date + 'T00:00:00');
      const formattedDate = dateObj.toLocaleDateString('pt-BR');

      // Criar item visual
      const itemHtml = `
        <div class="service-list-item border rounded p-2 mb-2" style="background: #f0fdf4;">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
              <span class="badge bg-primary">📅 ${formattedDate}</span>
              <strong>${service.name}</strong>
              <span class="text-muted">Qtd: ${service.quantity}</span>
              <span class="text-success fw-bold">R$ ${service.total.toFixed(2).replace('.', ',')}</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeService(${service.id})">
              <i class="bi bi-trash"></i>
            </button>
          </div>
          ${service.observation ? `<div class="mt-1" style="font-size:0.85rem; color:#475569;">📝 ${service.observation}</div>` : ''}
        </div>
      `;
      listContainer.insertAdjacentHTML('beforeend', itemHtml);

      // Usar índice baseado no tamanho atual + posição na lista de novos
      const baseIndex = parseInt(document.getElementById('services-hidden-inputs')?.dataset.reservaServicesCount || '0');
      const realIndex = baseIndex + index;

      // Criar hidden inputs
      const hiddenInputsHtml = `
        <input type="hidden" name="reserva[reserva_services_attributes][${realIndex}][service_id]" value="${service.serviceId}">
        <input type="hidden" name="reserva[reserva_services_attributes][${realIndex}][service_date]" value="${service.date}">
        <input type="hidden" name="reserva[reserva_services_attributes][${realIndex}][quantity]" value="${service.quantity}">
        <input type="hidden" name="reserva[reserva_services_attributes][${realIndex}][observation]" value="${service.observation || ''}">
      `;
      hiddenInputsContainer.insertAdjacentHTML('beforeend', hiddenInputsHtml);
    });
  }
</script>

<script>
  document.addEventListener("turbo:load", function() {
    const cabanaSelect = document.getElementById('reserva_cabana_id');
    const dateRangeInput = document.getElementById("reservation_date_range");
    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");
    
    // Ler datas do DOM (evita cache do Turbo entre reservas diferentes)
    const currentStartDate = dateRangeInput ? dateRangeInput.dataset.startDate : '';
    const currentEndDate = dateRangeInput ? dateRangeInput.dataset.endDate : '';
    const currentReservaId = dateRangeInput ? dateRangeInput.dataset.reservaId : '';

    function initializeFlatpickr(cabanaId) {
      if (!cabanaId) return;

      // Passa o ID da reserva para excluir suas próprias datas
      fetch(`/cabanas/${cabanaId}/unavailable_dates?exclude_reserva_id=${currentReservaId}`)
        .then(response => response.json())
        .then(disabledDates => {
          if (dateRangeInput._flatpickr) {
            dateRangeInput._flatpickr.destroy();
          }
          
          // Configura datas padrão se existirem
          let defaultDates = [];
          if (currentStartDate && currentEndDate) {
            defaultDates = [currentStartDate, currentEndDate];
            // Preenche os hidden fields também
            startDateInput.value = currentStartDate;
            endDateInput.value = currentEndDate;
          }
          
          flatpickr("#reservation_date_range", {
            mode: "range",
            minDate: null, // Permite selecionar datas passadas na edição
            dateFormat: "Y-m-d",
            defaultDate: defaultDates,
            disable: disabledDates,
            onChange: function(selectedDates, dateStr, instance) {
              if (selectedDates.length === 2) {
                startDateInput.value = instance.formatDate(selectedDates[0], "Y-m-d");
                endDateInput.value = instance.formatDate(selectedDates[1], "Y-m-d");
                dateRangeInput.setCustomValidity('');
              } else {
                startDateInput.value = '';
                endDateInput.value = '';
                dateRangeInput.setCustomValidity('Selecione as datas');
              }
            },
            onDayCreate: function(dObj, dStr, fp, dayElem) {
              dayElem.addEventListener('mouseenter', function() {
                if (fp.selectedDates.length === 1) {
                  dayElem.classList.remove('flatpickr-disabled');
                }
              });
            }
          });
        })
        .catch(err => console.error("Erro:", err));
    }

    cabanaSelect.addEventListener("change", function(e) {
      initializeFlatpickr(e.target.value);
    });

    if (cabanaSelect.value) {
      initializeFlatpickr(cabanaSelect.value);
    }
  });
</script>

<script>
  document.addEventListener('turbo:load', function () {
    const form = document.querySelector('form');
    const dateRangeInput = document.getElementById("reservation_date_range");
    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");
    const partnerCheckbox = document.getElementById('partner_checkbox');
    const userSelect = document.getElementById('user_select');

    function validateDates() {
      if (!startDateInput.value || !endDateInput.value) {
        dateRangeInput.setCustomValidity('Selecione as datas');
        return false;
      }
      dateRangeInput.setCustomValidity('');
      return true;
    }

    if (userSelect && partnerCheckbox) {
      userSelect.addEventListener('change', function() {
        const userId = this.value;
        if (userId) {
          fetch(`/admin/users/${userId}/partner_status`)
            .then(response => response.json())
            .then(data => { partnerCheckbox.checked = data.partner; })
            .catch(err => console.error("Erro:", err));
        }
      });
    }

    if (form) {
      form.addEventListener('submit', function(event) {
        if (!validateDates() || !form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
          if (!startDateInput.value || !endDateInput.value) {
            alert('Selecione as datas de check-in e check-out.');
            return false;
          }
        }
      }, false);
    }

    if (dateRangeInput) {
      dateRangeInput.addEventListener('blur', validateDates);
    }
  });
</script>

