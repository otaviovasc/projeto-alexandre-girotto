<h1 class="mb-4">Serviços</h1>

<div class="mb-3">
  <%= link_to 'Novo Serviço', new_admin_service_path, class: 'btn btn-primary' %>
</div>

<!-- Formulário de Filtro com Ransack -->
<%= search_form_for @q, url: admin_services_path, method: :get, class: "row g-3 mb-4" do |f| %>
  <div class="col-md-4">
    <%= f.label :filial_id_eq, "Filial", class: "form-label" %>
    <%= f.collection_select :filial_id_eq, Filial.all, :id, :name, { prompt: "Selecione uma filial" }, { class: "form-select" } %>
  </div>
  <div class="col-md-4 align-self-end">
    <%= f.submit "Filtrar", class: "btn btn-primary" %>
  </div>
<% end %>

<!-- Listagem de Serviços -->
<div class="row">
  <% @services.each do |service| %>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <% if service.images.attached? %>
          <% if service.images.count > 1 %>
            <div id="carouselService<%= service.id %>" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <% service.images.each_with_index do |image, index| %>
                  <div class="carousel-item <%= 'active' if index.zero? %>">
                    <%= image_tag image.url, class: "d-block w-100", style: "max-height: 200px; object-fit: cover;" %>
                  </div>
                <% end %>
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carouselService<%= service.id %>" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carouselService<%= service.id %>" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Próximo</span>
              </button>
            </div>
          <% else %>
            <%= image_tag service.images.first.url, class: "card-img-top", style: "max-height: 200px; object-fit: cover;" %>
          <% end %>
        <% else %>
          <div class="card-img-top bg-light d-flex justify-content-center align-items-center" style="height: 200px;">
            <span class="text-muted">Sem Imagem</span>
          </div>
        <% end %>

        <div class="card-body">
          <h5 class="card-title"><strong><%= service.name %></strong></h5>
          <p class="card-text"><strong>Descrição:</strong><%= truncate(service.description, length: 100) %></p>
          <p class="card-text"><strong>Preço:</strong> <%= number_to_currency(service.price) %></p>
          <p class="card-text"><strong>Filial:</strong> <%= service.filial ? service.filial.name : "Nenhuma" %></p>
          <p class="card-text"><strong>Mostrar no Mercado?:</strong> <%= service.show_in_marketplace ? "Sim" : "Nao" %></p>
          <p class="card-text"><strong>Responsável:</strong> <%= service.user ? service.user.email : "Nenhum" %></p>
        </div>

        <div class="card-footer d-flex justify-content-between">
          <%= link_to 'Editar', edit_admin_service_path(service), class: 'btn btn-secondary btn-sm' %>
          <%= link_to 'Excluir', admin_service_path(service), data: { turbo_method: :delete, confirm: 'Tem certeza?' }, class: 'btn btn-danger btn-sm' %>
        </div>
      </div>
    </div>
  <% end %>
</div>
