<% content_for :title, "Reserva online - Villaggio Girotto" %>

<main class="vg-public-page">
  <div class="vg-public-shell">
    <div class="vg-topline">
      <span class="vg-brand-name">Villaggio Girotto</span>
      <span class="vg-page-status">Checkout seguro</span>
    </div>

    <header class="vg-hero">
      <div>
        <p class="vg-kicker">Reserva online</p>
        <h1 class="vg-title">Finalize sua estadia.</h1>
        <p class="vg-lead">
          Confirme os dados da reserva, aceite os termos e siga para o pagamento. As datas ficam pré-reservadas por 15 minutos enquanto o pagamento é finalizado.
        </p>
      </div>
      <div class="vg-note">
        Pagamento processado pela Cielo. Após a confirmação, a reserva é registrada automaticamente no sistema do Villaggio Girotto.
      </div>
    </header>

    <% if @errors.present? %>
      <div class="vg-alert error mb-5">
        <p class="font-semibold">Não foi possível iniciar a reserva.</p>
        <ul class="mt-2 list-disc pl-5">
          <% @errors.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: public_bookings_path, scope: :booking, method: :post, local: true, class: "vg-form", id: "public-booking-form" do |form| %>
      <section class="vg-card">
        <h2 class="vg-card-title">Dados da estadia</h2>
        <p class="vg-card-copy">Escolha a cabana, as datas da estadia e os serviços opcionais disponíveis para a sua reserva.</p>
        <div class="vg-field-grid three">
          <div class="sm:col-span-3">
            <%= form.label :cabana_id, "Cabana", class: "vg-label" %>
            <%= form.select :cabana_id,
                options_for_select(@cabanas.map { |cabana| [cabana.name, cabana.id, { data: { filial_id: cabana.filial_id } }] }, @booking_values["cabana_id"]),
                { prompt: "Selecione a cabana" },
                required: true,
                id: "booking-cabana",
                class: "vg-input" %>
          </div>

          <div>
            <%= form.label :start_date, "Entrada", class: "vg-label" %>
            <%= form.date_field :start_date,
                value: @booking_values["start_date"],
                required: true,
                id: "booking-start-date",
                class: "vg-input" %>
          </div>

          <div>
            <%= form.label :end_date, "Saída", class: "vg-label" %>
            <%= form.date_field :end_date,
                value: @booking_values["end_date"],
                required: true,
                id: "booking-end-date",
                class: "vg-input" %>
          </div>
        </div>
      </section>

      <section class="vg-card">
        <h2 class="vg-card-title">Responsável pela reserva</h2>
        <div class="vg-field-grid three">
          <div>
            <%= form.label :guest_name, "Nome e sobrenome", class: "vg-label" %>
            <%= form.text_field :guest_name,
                value: @booking_values["guest_name"],
                required: true,
                autocomplete: "name",
                placeholder: "Ex.: Maria Silva",
                class: "vg-input" %>
          </div>

          <div>
            <%= form.label :guest_email, "E-mail", class: "vg-label" %>
            <%= form.email_field :guest_email,
                value: @booking_values["guest_email"],
                required: true,
                autocomplete: "email",
                placeholder: "voce@email.com",
                class: "vg-input" %>
          </div>

          <div>
            <%= form.label :guest_phone, "WhatsApp", class: "vg-label" %>
            <%= form.telephone_field :guest_phone,
                value: @booking_values["guest_phone"],
                required: true,
                autocomplete: "tel",
                placeholder: "11999999999",
                class: "vg-input" %>
          </div>
        </div>
      </section>

      <section class="vg-card" id="services-section">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="vg-card-title">Serviços opcionais</h2>
            <p class="vg-card-copy">A compra de serviços fica disponível apenas com mais de 10 dias de antecedência.</p>
          </div>
          <p id="services-window-warning" class="vg-alert warning hidden">
            Para datas próximas, os serviços serão validados antes do pagamento.
          </p>
        </div>

        <div class="vg-service-list">
          <% @services.each do |service| %>
            <% service_values = (@booking_values["service_items"] || {})[service.id.to_s] || {} %>
            <% service_selected = ActiveModel::Type::Boolean.new.cast(service_values["selected"]) %>
            <% public_service_price = @service_prices.fetch(service.id, service.price) %>
            <div class="service-row vg-service-row"
                 data-filial-id="<%= service.filial_id %>"
                 data-service-name="<%= service.name %>"
                 data-service-price="<%= public_service_price.to_f %>">
              <label class="flex items-start gap-3">
                <%= check_box_tag "booking[service_items][#{service.id}][selected]", "1", service_selected, class: "service-checkbox vg-checkbox mt-1" %>
                <span>
                  <span class="block font-semibold text-[#1a2e1a]"><%= service.name %></span>
                  <span class="block text-sm text-[#637066]"><%= number_to_currency(public_service_price, unit: 'R$ ', separator: ',', delimiter: '.') %></span>
                </span>
              </label>

              <div>
                <label class="vg-label">Data</label>
                <%= date_field_tag "booking[service_items][#{service.id}][service_date]",
                    service_values["service_date"],
                    class: "service-date vg-input py-2 text-sm" %>
              </div>

              <div>
                <label class="vg-label">Qtd</label>
                <%= number_field_tag "booking[service_items][#{service.id}][quantity]",
                    service_values["quantity"].presence || 1,
                    min: 1,
                    data: { default_quantity: 1 },
                    class: "vg-input py-2 text-sm" %>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <section class="vg-card" id="booking-summary-card">
        <h2 class="vg-card-title">Resumo da pré-reserva</h2>
        <p class="vg-card-copy">Confira a cabana, o período, os serviços e o total estimado antes de seguir para o pagamento.</p>

        <div class="vg-summary-grid">
          <div>
            <p class="vg-summary-label">Cabana</p>
            <p class="vg-summary-value" id="summary-cabana">Selecione a cabana</p>
          </div>
          <div>
            <p class="vg-summary-label">Período</p>
            <p class="vg-summary-value" id="summary-period">Informe entrada e saída</p>
          </div>
          <div>
            <p class="vg-summary-label">Noites</p>
            <p class="vg-summary-value" id="summary-nights">-</p>
          </div>
        </div>

        <div class="vg-items" id="booking-purchase-summary">
          <div class="vg-empty-summary">
            Selecione a cabana e as datas para ver o resumo.
          </div>
        </div>

        <div class="vg-summary-total" id="booking-summary-total-row">
          <span>Total estimado</span>
          <strong id="booking-summary-total">A calcular</strong>
        </div>
      </section>

      <section class="vg-card">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="vg-card-title">Termos de hospedagem</h2>
            <p class="vg-card-copy">Leia os termos antes de confirmar o aceite e seguir para o pagamento.</p>
          </div>
        </div>

        <details class="vg-terms-box">
          <summary>Ler termos e condições</summary>
          <div class="vg-terms-content">
            <%= render 'fnrh_portal/hosting_terms' %>
          </div>
        </details>
      </section>

      <section class="vg-action-card">
        <label class="flex items-start gap-3 text-sm leading-6 text-[#3f4b43]">
          <%= form.check_box :terms_accepted, required: true, class: "vg-checkbox mt-1 shrink-0" %>
          <span>Declaro que li, compreendi e concordo com os termos de hospedagem do Villaggio Girotto.</span>
        </label>

        <button type="submit" class="vg-button w-full">
          Pré-reservar e seguir para pagamento
        </button>
      </section>
    <% end %>

    <div id="service-deadline-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
      <div class="w-full max-w-2xl border border-[#d7d0c1] bg-[#f5efe0] p-6 shadow-xl">
        <p class="vg-kicker">Serviços adicionais</p>
        <h2 class="vg-card-title mt-2">Compra online indisponível para este período.</h2>
        <p class="vg-card-copy mt-3">
          Os serviços adicionais exigem preparo, compra de insumos e confirmação de agenda com prestadores parceiros.
          Como sua estadia está próxima, a compra online de serviços não está disponível para este período.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <button type="button" id="service-deadline-whatsapp" class="vg-button w-full sm:w-auto">
            Falar com atendente
          </button>
          <button type="button" id="service-deadline-continue" class="vg-button secondary w-full sm:w-auto">
            Comprar apenas diárias
          </button>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var form = document.getElementById("public-booking-form");
    var cabanaSelect = document.getElementById("booking-cabana");
    var startInput = document.getElementById("booking-start-date");
    var endInput = document.getElementById("booking-end-date");
    var warning = document.getElementById("services-window-warning");
    var serviceDeadlineModal = document.getElementById("service-deadline-modal");
    var serviceDeadlineWhatsapp = document.getElementById("service-deadline-whatsapp");
    var serviceDeadlineContinue = document.getElementById("service-deadline-continue");
    var serviceRows = Array.prototype.slice.call(document.querySelectorAll(".service-row"));
    var purchaseSummary = document.getElementById("booking-purchase-summary");
    var summaryCabana = document.getElementById("summary-cabana");
    var summaryPeriod = document.getElementById("summary-period");
    var summaryNights = document.getElementById("summary-nights");
    var summaryTotal = document.getElementById("booking-summary-total");
    var quoteUrl = <%= raw public_booking_quote_path.to_json %>;
    var whatsappByCabana = <%= raw (@public_booking_whatsapp_by_cabana || {}).to_json %>;
    var quoteRequestId = 0;
    var continueWithoutServices = false;
    var bookingQuote = { loading: false, error: null, dailyTotal: null, nights: null };
    var today = new Date();
    today.setHours(0, 0, 0, 0);

    function formatCurrency(value) {
      return value.toLocaleString("pt-BR", {
        style: "currency",
        currency: "BRL"
      });
    }

    function selectedFilialId() {
      var option = cabanaSelect.options[cabanaSelect.selectedIndex];
      return option ? option.dataset.filialId : "";
    }

    function selectedCabanaName() {
      var option = cabanaSelect.options[cabanaSelect.selectedIndex];
      return option && option.value ? option.textContent : "";
    }

    function formatDateLabel(value) {
      if (!value) return "";
      return value.split("-").reverse().join("/");
    }

    function nightsBetween() {
      if (!startInput.value || !endInput.value) return null;

      var start = new Date(startInput.value + "T00:00:00");
      var end = new Date(endInput.value + "T00:00:00");
      var nights = Math.round((end - start) / 86400000);
      return nights > 0 ? nights : null;
    }

    function selectedServiceRows() {
      return serviceRows.filter(function(row) {
        var checkbox = row.querySelector(".service-checkbox");
        return checkbox && checkbox.checked && !checkbox.disabled;
      });
    }

    function serviceSummaryLines() {
      return selectedServiceRows().map(function(row) {
        var name = row.dataset.serviceName || "Serviço";
        var quantityInput = row.querySelector('input[type="number"]');
        var dateInput = row.querySelector(".service-date");
        var quantity = Math.max(parseInt(quantityInput && quantityInput.value || "1", 10), 1);
        var dateText = dateInput && dateInput.value ? " em " + formatDateLabel(dateInput.value) : "";

        return "- " + name + dateText + " (" + quantity + "x)";
      });
    }

    function serviceDeadlineWhatsappUrl() {
      var number = whatsappByCabana[cabanaSelect.value] || "";
      var guestNameInput = document.querySelector('[name="booking[guest_name]"]');
      var guestName = guestNameInput && guestNameInput.value ? guestNameInput.value.trim() : "";
      var lines = [
        "Olá! Quero verificar a disponibilidade de serviços para uma reserva próxima pelo site oficial.",
        "",
        guestName ? "Nome: " + guestName : null,
        "Cabana: " + (selectedCabanaName() || "Não informada"),
        "Entrada: " + (startInput.value ? formatDateLabel(startInput.value) : "Não informada"),
        "Saída: " + (endInput.value ? formatDateLabel(endInput.value) : "Não informada")
      ];
      var services = serviceSummaryLines();

      if (services.length > 0) {
        lines.push("");
        lines.push("Serviços desejados:");
        services.forEach(function(line) { lines.push(line); });
      }

      var text = encodeURIComponent(lines.filter(function(line) {
        return line !== null;
      }).join("\n"));

      return number ? "https://wa.me/" + number + "?text=" + text : "https://wa.me/?text=" + text;
    }

    function openServiceDeadlineModal() {
      if (!serviceDeadlineModal) return;

      serviceDeadlineModal.classList.remove("hidden");
      serviceDeadlineModal.classList.add("flex");
    }

    function closeServiceDeadlineModal() {
      if (!serviceDeadlineModal) return;

      serviceDeadlineModal.classList.add("hidden");
      serviceDeadlineModal.classList.remove("flex");
    }

    function servicesAllowed() {
      if (!startInput.value) return true;

      var start = new Date(startInput.value + "T00:00:00");
      var diffDays = Math.floor((start - today) / 86400000);
      return diffDays > 10;
    }

    function syncServiceRows() {
      var filialId = selectedFilialId();
      var startDate = startInput.value;
      var endDate = endInput.value;

      if (warning) warning.classList.add("hidden");

      serviceRows.forEach(function(row) {
        var sameFilial = !!filialId && row.dataset.filialId === filialId;
        var visible = sameFilial;
        row.classList.toggle("hidden", !visible);

        row.querySelectorAll("input").forEach(function(input) {
          input.disabled = !visible;
        });

        var dateInput = row.querySelector(".service-date");
        if (dateInput) {
          dateInput.min = startDate || "";
          dateInput.max = endDate || "";
          if (startDate && !dateInput.value) dateInput.value = startDate;
        }

        if (!visible) {
          var checkbox = row.querySelector(".service-checkbox");
          if (checkbox) checkbox.checked = false;
        }
      });

      renderBookingSummary();
    }

    function addSummaryItem(name, detail, amountText) {
      var item = document.createElement("div");
      item.className = "vg-item";

      var left = document.createElement("div");
      var title = document.createElement("p");
      title.className = "font-semibold text-[#1a2e1a]";
      title.textContent = name;

      var detailElement = document.createElement("p");
      detailElement.className = "mt-1 text-sm text-[#637066]";
      detailElement.textContent = detail;

      var right = document.createElement("p");
      right.className = "shrink-0 font-semibold text-[#1a2e1a]";
      right.textContent = amountText;

      left.appendChild(title);
      left.appendChild(detailElement);
      item.appendChild(left);
      item.appendChild(right);
      purchaseSummary.appendChild(item);
    }

    function renderBookingSummary() {
      if (!purchaseSummary) return;

      var cabanaName = selectedCabanaName();
      var nights = bookingQuote.nights || nightsBetween();
      var selectedRows = selectedServiceRows();
      var periodText = startInput.value && endInput.value
        ? formatDateLabel(startInput.value) + " a " + formatDateLabel(endInput.value)
        : "";
      var servicesValue = 0;

      if (summaryCabana) summaryCabana.textContent = cabanaName || "Selecione a cabana";
      if (summaryPeriod) summaryPeriod.textContent = periodText || "Informe entrada e saída";
      if (summaryNights) {
        summaryNights.textContent = nights ? nights + (nights === 1 ? " noite" : " noites") : "-";
      }

      purchaseSummary.innerHTML = "";

      if (cabanaName && periodText) {
        var lodgingText = "A calcular";

        if (bookingQuote.loading) {
          lodgingText = "Calculando...";
        } else if (bookingQuote.dailyTotal !== null && !bookingQuote.error) {
          lodgingText = formatCurrency(bookingQuote.dailyTotal);
        } else if (bookingQuote.error) {
          lodgingText = "Indisponível";
        }

        addSummaryItem(
          "Hospedagem",
          bookingQuote.error || (periodText + (nights ? " · " + nights + (nights === 1 ? " noite" : " noites") : "")),
          lodgingText
        );
      }

      selectedRows.forEach(function(row) {
        var name = row.dataset.serviceName || "Serviço";
        var price = parseFloat(row.dataset.servicePrice || "0");
        var quantityInput = row.querySelector('input[type="number"]');
        var dateInput = row.querySelector(".service-date");
        var quantity = Math.max(parseInt(quantityInput && quantityInput.value || "1", 10), 1);
        var lineTotal = price * quantity;
        servicesValue += lineTotal;

        addSummaryItem(
          name,
          (dateInput && dateInput.value ? formatDateLabel(dateInput.value) : "Data a definir") + " · " + quantity + "x",
          formatCurrency(lineTotal)
        );
      });

      if (!cabanaName && !periodText && selectedRows.length === 0) {
        purchaseSummary.innerHTML = '<div class="vg-empty-summary">Selecione a cabana e as datas para ver o resumo.</div>';
      } else if (selectedRows.length === 0) {
        addSummaryItem("Serviços opcionais", "Nenhum serviço opcional selecionado", formatCurrency(0));
      }

      if (summaryTotal) {
        if (bookingQuote.dailyTotal !== null && !bookingQuote.error) {
          summaryTotal.textContent = formatCurrency(bookingQuote.dailyTotal + servicesValue);
        } else {
          summaryTotal.textContent = "A calcular";
        }
      }
    }

    function fetchBookingQuote() {
      var cabanaId = cabanaSelect.value;

      if (!cabanaId || !startInput.value || !endInput.value || !nightsBetween()) {
        bookingQuote = { loading: false, error: null, dailyTotal: null, nights: null };
        renderBookingSummary();
        return;
      }

      var requestId = ++quoteRequestId;
      var params = new URLSearchParams({
        cabana_id: cabanaId,
        start_date: startInput.value,
        end_date: endInput.value
      });

      bookingQuote = { loading: true, error: null, dailyTotal: null, nights: nightsBetween() };
      renderBookingSummary();

      fetch(quoteUrl + "?" + params.toString(), {
        headers: { "Accept": "application/json" }
      })
        .then(function(response) {
          return response.json().then(function(data) {
            if (!response.ok) throw data;
            return data;
          });
        })
        .then(function(data) {
          if (requestId !== quoteRequestId) return;

          bookingQuote = {
            loading: false,
            error: null,
            dailyTotal: parseFloat(data.daily_total || "0"),
            nights: parseInt(data.nights || nightsBetween() || "0", 10)
          };
          renderBookingSummary();
        })
        .catch(function(error) {
          if (requestId !== quoteRequestId) return;

          bookingQuote = {
            loading: false,
            error: error && error.error ? error.error : "Não foi possível calcular a hospedagem.",
            dailyTotal: null,
            nights: nightsBetween()
          };
          renderBookingSummary();
        });
    }

    [cabanaSelect, startInput, endInput].forEach(function(element) {
      if (element) {
        element.addEventListener("change", function() {
          syncServiceRows();
          fetchBookingQuote();
        });
      }
    });

    serviceRows.forEach(function(row) {
      row.querySelectorAll("input").forEach(function(input) {
        input.addEventListener("change", renderBookingSummary);
        input.addEventListener("input", renderBookingSummary);
      });
    });

    if (form) {
      form.addEventListener("submit", function(event) {
        if (continueWithoutServices) return;

        if (!servicesAllowed() && selectedServiceRows().length > 0) {
          event.preventDefault();
          openServiceDeadlineModal();
        }
      });
    }

    if (serviceDeadlineWhatsapp) {
      serviceDeadlineWhatsapp.addEventListener("click", function() {
        window.open(serviceDeadlineWhatsappUrl(), "_blank", "noopener");
      });
    }

    if (serviceDeadlineContinue) {
      serviceDeadlineContinue.addEventListener("click", function() {
        selectedServiceRows().forEach(function(row) {
          var checkbox = row.querySelector(".service-checkbox");
          if (checkbox) checkbox.checked = false;
        });

        continueWithoutServices = true;
        closeServiceDeadlineModal();
        renderBookingSummary();

        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.submit();
        }
      });
    }

    if (serviceDeadlineModal) {
      serviceDeadlineModal.addEventListener("click", function(event) {
        if (event.target === serviceDeadlineModal) closeServiceDeadlineModal();
      });
    }

    syncServiceRows();
    fetchBookingQuote();
  });
</script>
