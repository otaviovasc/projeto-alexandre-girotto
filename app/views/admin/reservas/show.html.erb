<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4">Detalhes da Reserva</h1>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <p class="mb-2"><strong>Cabana:</strong> <%= @reserva.cabana.name %></p>
      <p class="mb-2"><strong>Usuário:</strong> <%= @reserva.user.email  %></p>
      <p class="mb-2"><strong>Data de Início:</strong> <%= @reserva.start_date %></p>
      <p class="mb-2"><strong>Data de Término:</strong> <%= @reserva.end_date %></p>
      <p class="mb-2"><strong>Preço Total:</strong> <%= number_to_currency(@reserva.total_price) %></p>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= link_to 'Editar', edit_admin_reserva_path(@reserva), class: 'btn btn-primary' %>
    <%= link_to 'Voltar', admin_reservas_path, class: 'btn btn-secondary' %>
  </div>
</div>
