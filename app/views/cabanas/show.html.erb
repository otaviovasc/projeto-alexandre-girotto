<div class="mt-4 pt-16">
  <div class="bg-white rounded-md flex flex-col w-full mx-auto p-2">
    <!-- Ícone de voltar (sem texto) -->
      <%= link_to cabanas_path,
                  class: "absolute left-4 inline-flex items-center justify-center w-10 h-10
                          rounded-full border border-verde-escuro text-verde-escuro
                          hover:bg-verde-escuro hover:text-white transition-colors duration-300
                          focus:outline-none focus:ring-2 focus:ring-verde-escuro" do %>
        <i class="fa-solid fa-arrow-left"></i>
      <% end %>

      <!-- Título da Cabana (centralizado) -->
      <p class="text-center text-4xl font-alice text-verde-escuro">
        <%= @cabana.name %>
      </p>
    </div>
    <!-- Informações da Cabana -->
    <div class="flex flex-col gap-6 px-8 m-8">

      <!-- Slider de Imagens da Cabana (USANDO A PARTIAL) -->
      <div class="flex flex-col items-center">
        <%= render partial: "shared/cabana_show_slider",
                   locals: { cabana: @cabana, images: @cabana.images } %>
      </div>

      <!-- Demais Informações -->
      <div class="flex flex-col gap-4">

        <% @infos_da_cabana.each do |info| %>
          <% if info.info_type == "description" %>
            <p class="text-xl font-bold font-dm text-verde-escuro">
              A <%= @cabana.name %>
            </p>
            <p class="text-lg font-alice text-verde-escuro">
              <%= info.content %>
            </p>
          <% end %>
        <% end %>

        <% @infos_da_cabana.each do |info| %>
          <% if info.info_type == "comodidades" %>
            <p class="text-xl font-bold font-dm text-verde-escuro">Comodidades:</p>
            <p class="text-lg font-dm text-verde-escuro max-w-6/10">
              <%= info.content %>
            </p>
          <% end %>
          <% if info.info_type == "other" %>
            <p class="text-xl font-bold font-dm text-verde-escuro">Fatores Chave:</p>
            <p class="text-lg font-dm max-w-8/10 text-verde-escuro">
              <%= info.content %>
            </p>
          <% end %>
        <% end %>

        <!-- Botão para Reservar -->
        <div class="font-dm bg-botao-verde rounded-3xl flex justify-center items-center gap-4 p-3 mt-6">
          <%= link_to 'Quero reservar!', new_cabana_reserva_path(@cabana), class: "uppercase font-light text-creme" %>
        </div>

      </div>
    </div>
  </div>

  <!-- Funil Form e Footer -->
  <%= render 'shared/funilform' %>
  <%= render 'shared/footer' %>
  <%= render 'shared/wppButton' %>
</div>
