<div class="container mt-4">
  <style>
    .edit-observation-btn {
      font-size: 0.8rem;
      opacity: 0.6;
    }
    .edit-observation-btn:hover {
      opacity: 1;
    }
    td:hover .edit-observation-btn {
      opacity: 1;
    }
    .observation-text {
      word-break: break-word;
    }
    .highlight-new {
      animation: highlight-fade 5s;
    }
    @keyframes highlight-fade {
      from { background-color: rgba(255, 251, 130, 0.5); }
      to { background-color: transparent; }
    }
    /* Estilo para linha de usuário parceiro */
    .partner-row {
      background: linear-gradient(90deg, 
        rgba(255, 192, 203, 0.1) 0%, 
        rgba(255, 192, 203, 0.2) 100%
      ) !important;
      border: 2px dashed #ff69b4 !important;
      border-left: 4px solid #ff1493 !important;
    }
    .partner-row td {
      border-color: rgba(255, 105, 180, 0.3) !important;
    }
    .partner-row:hover {
      background: linear-gradient(90deg, 
        rgba(255, 192, 203, 0.2) 0%, 
        rgba(255, 192, 203, 0.3) 100%
      ) !important;
    }
  </style>

  <div class="container my-8 p-4 bg-light shadow-sm">
    <%= month_calendar(
          events: @reservas_calendar,
          attribute: :start_date,
          end_attribute: :end_date,
          previous_link: "<i class='bi bi-arrow-left'></i>".html_safe,
          next_link:     "<i class='bi bi-arrow-right'></i>".html_safe,
          title: ->(start_date){ start_date.strftime('%B %Y') }
        ) do |date, reservas_for_date| %>

      <div class="day-content">
        <span class="day-number"><%= date.day %></span>

        <% reservas_for_date.each_with_index do |reserva, index| %>
          <% is_start = (reserva.start_date == date) %>
          <% is_end   = (reserva.end_date   == date) %>
          <% same_day = (reserva.start_date == reserva.end_date && reserva.start_date == date) %>

          <% color_style = "background-color: #{reserva.cabana.color};" %>

          <% css_class =
            if same_day
              'start-end'
            elsif is_start
              'start'
            elsif is_end
              'end'
            else
              'middle'
            end
          %>

          <% top_offset_value = @top_offset[reserva.cabana_id] || 0 %>

          <div class="reserva-line <%= css_class %>"
               style="<%= color_style %> top: <%= top_offset_value %>px;"
               data-reserva-id="<%= reserva.id %>">
          </div>
        <% end %>
      </div>

    <% end %>

    <hr>

    <%= render 'legend' %>
  </div>

  <div class="d-flex gap-2 mb-4">
    <%= link_to 'Nova Reserva', new_admin_reserva_path, class: 'btn btn-primary d-flex align-items-center' %>
  </div>

  <div class="card p-3 mb-4 shadow-sm">
    <h4>Importar Reservas por Cabana</h4>
    <div class="d-flex flex-wrap gap-2">
      <% Cabana.all.each do |cabana| %>
        <% begin %>
          <% links = cabana.import_links.present? ? JSON.parse(cabana.import_links) : {} %>
          <% next if links.blank? %>
          <%= link_to cabana.name, select_cabana_import_admin_reservas_path(cabana_id: cabana.id), class: "btn btn-outline-success" %>
        <% rescue JSON::ParserError %>
          <%# Ignora cabanas com JSON inválido %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Filtros -->
  <div class="card p-3 mb-4 shadow-sm">
    <h4 class="card-title mb-4">Filtrar Reservas</h4>
    <%= search_form_for @q, url: admin_reservas_summary_path, method: :get, html: { class: "row g-3 align-items-end" } do |f| %>
      <div class="col-md-3">
        <%= f.label :start_date_gteq, "Data Inicial", class: "form-label mb-1" %>
        <%= f.date_field :start_date_gteq, class: "form-control", value: params.dig(:q, :start_date_gteq) %>
      </div>
      <div class="col-md-3">
        <%= f.label :end_date_lteq, "Data Final", class: "form-label mb-1" %>
        <%= f.date_field :end_date_lteq, class: "form-control", value: params.dig(:q, :end_date_lteq) %>
      </div>
      <div class="col-md-3">
        <%= f.label :payment_status_eq, "Status do Pagamento", class: "form-label mb-1" %>
        <%= f.select :payment_status_eq, 
            options_for_select([
              ['Todos', ''],
              ['Pendente', 'pending'],
              ['Aguardando Pagamento', 'waiting_payment'],
              ['Pago', 'paid'],
              ['Recusado', 'refused'],
              ['Cancelado', 'canceled']
            ], selected: params.dig(:q, :payment_status_eq)), 
            {}, 
            { class: "form-select" } %>
      </div>
      <div class="col-md-3">
        <%= f.submit "Filtrar", class: "btn btn-primary w-100" %>
        <%= link_to "Limpar", admin_reservas_summary_path, class: "btn btn-outline-secondary w-100 mt-2" %>
      </div>
    <% end %>
  </div>


  <!-- Estatísticas -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card text-white bg-primary shadow-sm">
        <div class="card-body">
          <h5>Total de Reservas</h5>
          <h3><%= @total_reservas %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-white bg-success shadow-sm">
        <div class="card-body">
          <h5>Receita Total</h5>
          <h3><%= number_to_currency(@total_receita, unit: "R$") %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-white bg-info shadow-sm">
        <div class="card-body">
          <h5>Reservas por Status</h5>
          <ul class="list-unstyled">
            <% @reservas_por_status.each do |status, count| %>
              <li>
                <span class="badge <%= badge_class(status) %>">
                  <%= status_translate(status) %>
                </span>
                <strong><%= count %></strong>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Lista de Reservas -->
  <div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0">Lista de Reservas</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Última atualização</th>
            <th>Data Início</th>
            <th>Data Fim</th>
            <th>Cabana</th>
            <th>Status</th>
            <th>Preço Total</th>
            <th>Observações</th>
            <th>Usuário</th>
            <th>Telefone</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @reservas.each do |reserva| %>
            <tr id="reserva-<%= reserva.id %>" data-updated-at="<%= reserva.updated_at.to_i %>" class="<%= 'partner-row' if reserva.user.partner? %>">
              <td><%= reserva.id %></td>
              <td><%= reserva.updated_at.strftime("%d/%m/%Y - %H:%Mh") %></td>
              <td><%= reserva.start_date.strftime("%d/%m/%y") %></td>
              <td><%= reserva.end_date.strftime("%d/%m/%y") %></td>
              <td>
                <div class="legend-color me-2" style="background-color: <%= reserva.cabana.color %>"></div>
                <%= reserva.cabana.name %>
              </td>
              <td>
                <span class="badge <%= badge_class(reserva.payment_status) %>">
                  <%= status_translate(reserva.payment_status) %>
                </span>
              </td>
              <td><%= number_to_currency(reserva.total_price, unit: "R$") %></td>
              <td>
                <span class="observation-text"><%= reserva.observation.present? ? reserva.observation : '-' %></span>
                <a href="#" class="edit-observation-btn ms-2" data-reserva-id="<%= reserva.id %>">
                  <i class="bi bi-pencil-square text-primary"></i>
                </a>
                <div class="edit-observation-form d-none">
                  <%= form_with url: update_observation_admin_reserva_path(reserva), method: :patch, class: "d-flex" do |f| %>
                    <%= f.text_field :observation, value: reserva.observation, class: "form-control form-control-sm me-1" %>
                    <%= f.submit "Salvar", class: "btn btn-sm btn-success" %>
                    <button type="button" class="btn btn-sm btn-secondary ms-1 cancel-edit-btn">Cancelar</button>
                  <% end %>
                </div>
              </td>
              <td>
                <span title="<%= reserva.user.email %>"><%= reserva.user.name %></span>
              </td>
              <td>
                <span title="<%= reserva.user.email %>"><%= reserva.user.telephone %></span>
              </td>
              <td>
                <%= link_to admin_reserva_path(reserva), class: 'btn btn-sm btn-outline-primary me-1', title: 'Visualizar' do %>
                  <i class="bi bi-eye"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  document.addEventListener("turbo:load", function() {
    // Listen for clicks on any calendar reserva line
    document.querySelectorAll(".reserva-line").forEach(function(element) {
      element.style.cursor = "pointer"; // Change cursor to pointer on hover
      element.addEventListener("click", function() {
        console.log("Clicked on reserva line");

        // Get the reserva id from the data attribute
        var reservaId = this.getAttribute("data-reserva-id");
        if (reservaId) {
          // Find the corresponding table row by ID
          var targetRow = document.getElementById("reserva-" + reservaId);
          if (targetRow) {
            // Scroll the target row into view smoothly
            targetRow.scrollIntoView({ behavior: "smooth", block: "center" });
            // Add a highlight class
            targetRow.classList.add("highlight");
            // Remove the highlight after 3 seconds
            setTimeout(function() {
              targetRow.classList.remove("highlight");
            }, 3000);
          }
        }
      });
    });
  });
</script>

<script>
document.addEventListener('turbo:load', function() {
  // Recupera o timestamp da última visualização (se não existir, assume 0)
  var lastSeen = parseInt(localStorage.getItem('lastSeenReservations')) || 0;

  // Timestamp atual em segundos
  var now = Math.floor(Date.now() / 1000);

  // Seleciona todas as linhas de reserva
  var rows = document.querySelectorAll('tr[id^="reserva-"]');
  rows.forEach(function(row) {
    var updatedAt = parseInt(row.getAttribute('data-updated-at'));
    // Se a reserva foi criada após a última visualização, adiciona o highlight
    if (updatedAt > lastSeen) {
      row.classList.add('highlight-new');
    }

    // Remove o destaque quando o usuário passa o mouse ou clica
    row.addEventListener('mouseover', function() {
      row.classList.remove('highlight-new');
    });
    row.addEventListener('click', function() {
      row.classList.remove('highlight-new');
    });
  });

  // Atualiza o timestamp da última visualização para o momento atual
  localStorage.setItem('lastSeenReservations', now);
});
</script>

<script>
// Código para edição inline das observações
document.addEventListener('turbo:load', function() {
  // Manipulador para o botão de editar observação
  document.querySelectorAll('.edit-observation-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      // Oculta o texto da observação e o botão de editar
      const td = this.closest('td');
      td.querySelector('.observation-text').classList.add('d-none');
      this.classList.add('d-none');
      // Mostra o formulário de edição
      td.querySelector('.edit-observation-form').classList.remove('d-none');
    });
  });

  // Manipulador para o botão de cancelar edição
  document.querySelectorAll('.cancel-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const td = this.closest('td');
      // Mostra o texto da observação e o botão de editar
      td.querySelector('.observation-text').classList.remove('d-none');
      td.querySelector('.edit-observation-btn').classList.remove('d-none');
      // Oculta o formulário de edição
      td.querySelector('.edit-observation-form').classList.add('d-none');
    });
  });
});
</script>