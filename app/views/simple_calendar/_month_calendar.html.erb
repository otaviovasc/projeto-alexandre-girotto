<div class="simple-calendar">
  <!-- Custom header with a large number on the left, month/year + nav on the right -->
  <div class="calendar-heading d-flex mb-3 align-items-end">
    <!-- Big number on the left -->
    <div class="display-1 fw-light me-4 mb-0" style="line-height: 1;">
      <!-- If current month/year, show today's day; otherwise show the month number -->
      <% if start_date.month == Date.today.month && start_date.year == Date.today.year %>
        <%= "%02d" % Date.today.day %>
      <% end %>
    </div>

    <!-- Month/Year + Nav on the right -->
    <div class="flex-grow-1 text-end">
      <!-- Uppercase month name + year -->
      <h3 class="calendar-title fw-light mb-1">
        <%= t('date.month_names')[start_date.month].upcase %> <%= start_date.year %>
      </h3>
      <nav>
        <%= link_to raw("<i class='bi bi-chevron-left'></i>"), calendar.url_for_previous_view,
              class: "btn btn-sm btn-light me-1" %>
        <%= link_to t('simple_calendar.today', default: 'Hoje'), calendar.url_for_today_view,
              class: "btn btn-sm btn-primary me-1" %>
        <%= link_to raw("<i class='bi bi-chevron-right'></i>"), calendar.url_for_next_view,
              class: "btn btn-sm btn-light" %>
      </nav>
    </div>
  </div>

  <!-- Keep your existing table structure -->
  <table class="table table-striped calendar">
    <thead>
      <tr>
        <% date_range.slice(0, 7).each do |day| %>
          <th><%= t('date.abbr_day_names')[day.wday] %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% date_range.each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <% td_classes = Array(calendar.td_classes_for(day)) %>
            <% td_classes << "today" if day == Date.today %>
            <%= content_tag :td, class: td_classes.join(" ") do %>
              <% instance_exec(day, calendar.sorted_events_for(day), &passed_block) %>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
