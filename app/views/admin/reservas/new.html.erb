<% partnership_form = @partnership_form.present? %>
<% creating_new_guest = @creating_new_guest.present? %>
<% form_url = partnership_form ? partnership_reservas_path : admin_reservas_path %>
<% user_collection = partnership_form ? (@existing_users || User.clients.order(:name, :email)) : User.all %>
<% user_prompt = partnership_form ? 'Selecione um hóspede existente' : 'Selecione um usuário' %>
<% user_options = user_collection.map { |user| [[user.name.presence, user.email.presence].compact.join(' - '), user.id, { 'data-partner': user.partner? }] } %>
<% selected_user_id = @reserva&.user_id || params.dig(:reserva, :user_id) %>
<% initial_services = @reserva.reserva_services.each_with_index.map do |reserva_service, index|
     service = reserva_service.service || Service.find_by(id: reserva_service.service_id)
     next unless service
     unit_price = reserva_service.unit_price_paid || service.price_for(@reserva)
     {
       id: index,
       serviceId: service.id.to_s,
       name: service.name,
       price: unit_price.to_f,
       date: reserva_service.service_date&.iso8601,
       quantity: reserva_service.quantity.to_i,
       total: unit_price.to_f * reserva_service.quantity.to_i,
       observation: reserva_service.visible_observation.to_s
     }
   end.compact %>

<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4"><%= partnership_form ? 'Nova Reserva de Parceria' : 'Nova Reserva' %></h1>

  <%= form_with model: @reserva, url: form_url, local: true, html: { class: 'needs-validation' } do |form| %>
    <%= hidden_field_tag :service_holiday_block_override, '0', id: 'service_holiday_block_override' %>
    
    <!-- Toggle para criar novo usuário -->
    <div class="form-check mb-3">
      <%= check_box_tag 'create_user', 'true', creating_new_guest, id: 'create_user_toggle', class: 'form-check-input' %>
      <%= label_tag 'create_user_toggle', partnership_form ? 'Criar novo hóspede?' : 'Criar Novo Usuário?', class: 'form-check-label' %>
    </div>

    <!-- Campos para novo usuário -->
    <div id="new_user_fields" style="<%= creating_new_guest ? '' : 'display:none;' %>" class="border rounded p-3 mb-4">
      <h5 class="mb-3"><%= partnership_form ? 'Dados do Hóspede' : 'Detalhes do Novo Usuário' %></h5>
      
      <div class="mb-3">
        <%= label_tag :name, 'Nome *', class: 'form-label' %>
        <%= text_field_tag 'user[name]', params.dig(:user, :name), class: 'form-control', required: creating_new_guest %>
      </div>

      <div class="mb-3">
        <%= label_tag :email, 'E-mail *', class: 'form-label' %>
        <%= text_field_tag 'user[email]', params.dig(:user, :email), class: 'form-control', type: 'email', required: creating_new_guest %>
      </div>

      <div class="mb-3">
        <%= label_tag :telephone, 'Telefone', class: 'form-label' %>
        <small class="text-muted">(opcional)</small>
        <%= text_field_tag 'user[telephone]', params.dig(:user, :telephone), class: 'form-control', id: 'telephone_field' %>
      </div>

      <% if partnership_form %>
        <%= hidden_field_tag 'user[partner]', 'true' %>
      <% else %>
        <div class="form-check mb-3">
          <%= check_box_tag 'user[partner]', 'true', params.dig(:user, :partner) == 'true', id: 'partner_checkbox', class: 'form-check-input' %>
          <%= label_tag 'partner_checkbox', 'É Parceiro?', class: 'form-check-label' %>
        </div>
      <% end %>
    </div>

    <!-- Seleção de usuário existente -->
    <div id="existing_user_fields" class="mb-3" style="<%= creating_new_guest ? 'display:none;' : '' %>">
      <%= form.label :user_id, partnership_form ? 'Selecionar Hóspede Existente *' : 'Selecionar Usuário *', class: 'form-label' %>
      <%= form.select :user_id, options_for_select(user_options, selected_user_id), { prompt: user_prompt }, { class: 'form-select', required: !creating_new_guest, id: 'user_select' } %>
    </div>

    <!-- Seleção de cabana -->
    <div class="mb-3">
      <%= form.label :cabana_id, 'Cabana *', class: 'form-label' %>
      <% cabana_options = Cabana.all.map { |cabana| [cabana.name, cabana.id, { 'data-filial-id': cabana.filial_id }] } %>
      <%= form.select :cabana_id, options_for_select(cabana_options, @reserva&.cabana_id), { prompt: 'Selecione uma cabana' }, { class: 'form-select', id: 'reserva_cabana_id', required: true } %>
    </div>

    <!-- Seleção de datas -->
    <div class="mb-3" id="date-selection">
      <label for="reservation_date_range" class="form-label">Selecione as datas *</label>
      <input type="text" id="reservation_date_range" placeholder="Selecione as datas" class="form-control" required />
      <%= form.hidden_field :start_date, id: "start_date", required: true %>
      <%= form.hidden_field :end_date, id: "end_date", required: true %>
      <div class="operational-calendar-legend">
        <span><i class="operational-calendar-swatch"></i> Early check-in</span>
        <span><i class="operational-calendar-swatch late"></i> Late checkout</span>
      </div>
    </div>

    <div class="row mb-3">
      <div class="col-md-6">
        <div class="form-check">
          <%= form.check_box :early_checkin, class: 'form-check-input' %>
          <%= form.label :early_checkin, 'Early check-in', class: 'form-check-label fw-bold' %>
        </div>
        <small class="text-muted">Bloqueia também a diária anterior, sem alterar as datas da FNRH.</small>
      </div>
      <div class="col-md-6">
        <div class="form-check">
          <%= form.check_box :late_checkout, class: 'form-check-input' %>
          <%= form.label :late_checkout, 'Late checkout', class: 'form-check-label fw-bold' %>
        </div>
        <small class="text-muted">Bloqueia também a diária seguinte, sem alterar as datas da FNRH.</small>
      </div>
    </div>

    <!-- Preço das diárias -->
    <div class="mb-3">
      <%= form.label :total_price, 'Preço das diárias', class: 'form-label' %>
      <span class="text-muted d-block" style="font-size: smaller;">
        Somente hospedagem. Os serviços são somados abaixo. Se deixar VAZIO, o preço das diárias é calculado normalmente.
      </span>
      <%= form.number_field :total_price, class: 'form-control', step: '0.01', min: '0' %>
    </div>

    <!-- Observation -->
    <% if partnership_form %>
      <%= form.hidden_field :observation, value: 'Parceria' %>
    <% else %>
      <div class="mb-3">
        <%= form.label :observation, 'Observação (origem da reserva)', class: 'form-label' %>
        <%= form.text_area :observation, class: 'form-control', rows: 2, placeholder: 'Ex: Airbnb, Booking, Indicação...' %>
      </div>
    <% end %>

    <!-- Serviços -->
    <div class="mb-4" id="services-section">
      <h5 class="mb-3">Serviços</h5>
      
      <!-- Adicionar Serviço -->
      <div class="add-service-box border rounded p-3 mb-3" style="background: #f8fafc;">
        <div class="row align-items-end">
          <div class="col-md-4 mb-2 mb-md-0">
            <label class="form-label fw-bold">Serviço</label>
            <select id="service-select" class="form-control">
              <option value="">Selecione ou digite para buscar...</option>
              <% @services.each do |service| %>
                <% displayed_price = partnership_form ? service.partner_price : service.price %>
                <option value="<%= service.id %>" 
                        data-name="<%= service.name %>" 
                        data-price="<%= displayed_price %>"
                        data-guest-price="<%= service.price %>"
                        data-partner-price="<%= service.partner_price %>"
                        data-filial-id="<%= service.filial_id %>"
                        data-free-date="<%= ReservaService.free_date_service?(service) %>"
                        data-region="<%= service.region %>">
                  <%= service.name %> - R$ <%= number_with_precision(displayed_price, precision: 2) %> (<%= service.region %>)
                </option>
              <% end %>
            </select>
          </div>
          <div class="col-md-2 mb-2 mb-md-0">
            <label class="form-label fw-bold">Data *</label>
            <input type="date" id="service-date-input" class="form-control" disabled>
          </div>
          <div class="col-md-1 mb-2 mb-md-0">
            <label class="form-label fw-bold">Qtd</label>
            <input type="number" id="service-quantity-input" class="form-control" value="1" min="1">
          </div>
          <div class="col-md-3">
            <button type="button" id="add-service-btn" class="btn btn-success w-100" onclick="addServiceToList()">
              <i class="bi bi-plus-lg"></i> Adicionar
            </button>
          </div>
        </div>
        <div class="row mt-2">
          <div class="col-12">
            <label class="form-label fw-bold">📝 Observação <small class="text-muted fw-normal">(opcional)</small></label>
            <textarea id="service-observation-input" class="form-control" rows="2" placeholder="Ex: sem lactose, capricho na decoração..."></textarea>
          </div>
        </div>
      </div>
      
      <!-- Lista de Serviços Adicionados -->
      <div id="services-list-container" class="border rounded p-3" style="min-height: 100px; background: #fff;">
        <h6 class="text-muted mb-3">📋 Serviços Adicionados <small>(ordenados por data)</small></h6>
        <div id="services-list">
          <p id="no-services-msg" class="text-center text-muted py-3">Nenhum serviço adicionado ainda.</p>
        </div>
      </div>

      <div class="border rounded p-3 mt-3" style="background: #f8fafc;">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="fw-bold">Total dos serviços</span>
          <strong id="services-total-value" class="text-success">R$ 0,00</strong>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <span class="fw-bold">Total geral</span>
          <strong id="checkout-total-value" class="text-primary">R$ 0,00</strong>
        </div>
        <small class="text-muted d-block mt-2">Total geral = diárias + serviços adicionados.</small>
      </div>
      
      <!-- Container para hidden inputs dos serviços -->
      <div id="services-hidden-inputs"></div>
    </div>

    <% unless partnership_form %>
      <div class="mb-4 border rounded p-3" style="background: #fff8e1; border-color: #facc15;">
        <h5 class="mb-2">Pagamento para reserva pendente</h5>
        <p class="text-muted mb-3">
          Use estes campos quando salvar como pendente. A primeira parcela pré-trava a data até o prazo informado; quando ela for paga, a reserva vira confirmada.
        </p>

        <div class="row g-3 mb-3">
          <div class="col-md-3">
            <%= label_tag :pending_payment_hold_hours, 'Pré-travar por', class: 'form-label' %>
            <div class="input-group">
              <%= number_field_tag :pending_payment_hold_hours,
                  params[:pending_payment_hold_hours].presence || 3,
                  min: 0.5,
                  step: 0.5,
                  class: 'form-control' %>
              <span class="input-group-text">h</span>
            </div>
          </div>
          <div class="col-md-4">
            <%= label_tag :pending_payment_max_credit_card_installments, 'Parcelamento no cartão', class: 'form-label' %>
            <%= select_tag :pending_payment_max_credit_card_installments,
                options_for_select(
                  [['Padrão: até 6x sem juros', '']] + (1..12).map { |number| ["Até #{number}x", number] },
                  params[:pending_payment_max_credit_card_installments].presence
                ),
                class: 'form-select' %>
            <small class="text-muted">Pix continua disponível no Checkout Cielo. Em branco usa até 6x.</small>
          </div>
        </div>

        <% (1..3).each do |installment_number| %>
          <% payment_params = params.dig(:pending_payments, installment_number.to_s) || {} %>
          <div class="row g-3 align-items-end mb-2">
            <div class="col-md-2">
              <strong><%= installment_number %>ª parcela</strong>
            </div>
            <div class="col-md-4">
              <%= label_tag "pending_payments_#{installment_number}_amount", 'Valor', class: 'form-label' %>
              <%= hidden_field_tag "pending_payments[#{installment_number}][installment_number]", installment_number %>
              <%= number_field_tag "pending_payments[#{installment_number}][amount]",
                  payment_params[:amount] || payment_params['amount'],
                  step: '0.01',
                  min: '0',
                  placeholder: installment_number == 1 ? 'Em branco usa diárias + serviços' : 'Opcional',
                  class: 'form-control' %>
            </div>
            <div class="col-md-4">
              <%= label_tag "pending_payments_#{installment_number}_due_at", 'Vencimento', class: 'form-label' %>
              <%= datetime_local_field_tag "pending_payments[#{installment_number}][due_at]",
                  payment_params[:due_at] || payment_params['due_at'],
                  class: 'form-control' %>
              <% if installment_number == 1 %>
                <small class="text-muted">Em branco usa o prazo da pré-trava.</small>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Botões -->
    <div class="d-flex gap-2 mt-4">
      <% if partnership_form %>
        <%= form.button 'Reservado', name: 'reservation_state', value: 'confirmed', class: 'btn btn-primary', id: 'submit_btn' %>
        <%= form.button 'Salvar como pendente', name: 'reservation_state', value: 'pending', class: 'btn btn-outline-warning' %>
      <% else %>
        <%= form.button 'Reservado', name: 'reservation_state', value: 'confirmed', class: 'btn btn-primary', id: 'submit_btn' %>
        <%= form.button 'Salvar como pendente', name: 'reservation_state', value: 'pending', class: 'btn btn-outline-warning' %>
      <% end %>
      <% if partnership_form %>
        <%= link_to 'Limpar', new_partnership_reserva_path, class: 'btn btn-secondary' %>
        <%= link_to 'Painel de Parcerias', partnership_dashboard_path, class: 'btn btn-outline-secondary' %>
      <% else %>
        <%= link_to 'Cancelar', :back, class: 'btn btn-secondary' %>
      <% end %>
    </div>

  <% end %>
</div>

<!-- Script para gerenciar lista de serviços -->
<script>
  // Array para armazenar os serviços adicionados
  var addedServices = <%= raw(json_escape(initial_services.to_json)) %>;
  var serviceIndex = addedServices.length;

  function normalizeServiceSearch(value) {
    return (value || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  }

  document.addEventListener("turbo:load", function() {
    // Inicializar Select2 para o select de serviços
    $('#service-select').select2({
      theme: 'bootstrap-5',
      width: '100%',
      placeholder: 'Selecione ou digite para buscar...',
      allowClear: true,
      matcher: function(params, data) {
        if (data.element?.disabled) return null;
        if (!params.term || normalizeServiceSearch(data.text).includes(normalizeServiceSearch(params.term))) return data;
        return null;
      }
    });

    const serviceSelect = document.getElementById('service-select');
    const cabanaSelect = document.getElementById('reserva_cabana_id');
    const partnershipForm = <%= partnership_form.to_json %>;
    const createUserToggle = document.getElementById('create_user_toggle');
    const partnerCheckbox = document.getElementById('partner_checkbox');
    const userSelect = document.getElementById('user_select');

    function usePartnerPrice() {
      if (partnershipForm) return true;
      if (createUserToggle?.checked) return partnerCheckbox?.checked === true;

      return userSelect?.selectedOptions[0]?.dataset.partner === 'true';
    }

    function updateServicePrices() {
      const partnerPrice = usePartnerPrice();

      serviceSelect.querySelectorAll('option').forEach(option => {
        if (!option.value) return;

        const requestedPrice = partnerPrice ? option.dataset.partnerPrice : option.dataset.guestPrice;
        const fallbackPrice = option.dataset.guestPrice;
        const numericPrice = Number(requestedPrice);
        const price = Number.isFinite(numericPrice) ? numericPrice : Number(fallbackPrice) || 0;
        option.dataset.price = String(price);
        option.textContent = `${option.dataset.name} - R$ ${price.toFixed(2).replace('.', ',')} (${option.dataset.region})`;
      });

      $('#service-select').trigger('change.select2');
    }

    createUserToggle?.addEventListener('change', updateServicePrices);
    partnerCheckbox?.addEventListener('change', updateServicePrices);
    userSelect?.addEventListener('change', updateServicePrices);
    const totalPriceInput = document.getElementById('reserva_total_price');
    totalPriceInput?.addEventListener('input', updatePaymentTotals);
    updateServicePrices();

    function applyServiceFilial(filialId) {
      serviceSelect.querySelectorAll('option').forEach(option => {
        if (!option.value) return;

        const matches = filialId && option.dataset.filialId === String(filialId);
        option.style.display = matches ? '' : 'none';
        option.disabled = !matches;
      });

      $('#service-select').prop('disabled', !filialId).val('').trigger('change');
    }

    function filterServicesForCabana() {
      const filialId = cabanaSelect?.selectedOptions[0]?.dataset.filialId;
      applyServiceFilial(filialId);
    }

    cabanaSelect?.addEventListener('change', function() {
      addedServices = [];
      renderServicesList();
      filterServicesForCabana();
    });
    filterServicesForCabana();
    renderServicesList();
    updatePaymentTotals();
  });

  const SERVICE_HOLIDAY_BLOCK_MESSAGE = 'Para as datas selecionadas, fale diretamente com um atendente no WhatsApp para consultar a possibilidade da entrega de serviços.';

  function isHolidayServiceDate(value) {
    if (!value) return false;

    const parts = value.split('-').map(Number);
    const month = parts[1];
    const day = parts[2];

    return (month === 12 && day >= 24) || (month === 1 && day <= 2);
  }

  function updateServiceDateBounds() {
    const dateInput = document.getElementById('service-date-input');
    const serviceSelect = document.getElementById('service-select');
    const freeDate = serviceSelect?.selectedOptions[0]?.dataset.freeDate === 'true';
    const startDate = document.getElementById('start_date')?.value;
    const endDate = document.getElementById('end_date')?.value;
    if (!dateInput) return;

    if (freeDate) {
      dateInput.disabled = false;
      dateInput.removeAttribute('min');
      dateInput.removeAttribute('max');
      return;
    }

    if (!startDate || !endDate) {
      dateInput.value = '';
      dateInput.disabled = true;
      dateInput.removeAttribute('min');
      dateInput.removeAttribute('max');
      return;
    }

    dateInput.disabled = false;
    dateInput.min = startDate;
    dateInput.max = endDate;
    if (!dateInput.value || dateInput.value < startDate || dateInput.value > endDate) {
      dateInput.value = startDate;
    }
  }

  function addServiceToList() {
    const selectEl = document.getElementById('service-select');
    const dateInput = document.getElementById('service-date-input');
    const quantityInput = document.getElementById('service-quantity-input');
    const observationInput = document.getElementById('service-observation-input');
    
    const serviceId = selectEl.value;
    const selectedOption = selectEl.options[selectEl.selectedIndex];
    const serviceName = selectedOption.dataset.name;
    const servicePrice = Number(String(selectedOption?.dataset.price || '').replace(',', '.'));
    const serviceDate = dateInput.value;
    const freeDate = selectedOption?.dataset.freeDate === 'true';
    const quantity = parseInt(quantityInput.value) || 1;
    const observation = observationInput ? observationInput.value.trim() : '';

    // Validações
    if (!serviceId) {
      alert('Por favor, selecione um serviço.');
      return;
    }
    if (!Number.isFinite(servicePrice)) {
      alert('Não foi possível identificar o preço deste serviço. Atualize a página e tente novamente.');
      return;
    }
    if (!serviceDate) {
      alert('Por favor, selecione a data do serviço.');
      return;
    }
    const startDate = document.getElementById('start_date')?.value;
    const endDate = document.getElementById('end_date')?.value;
    if (!freeDate && (serviceDate < startDate || serviceDate > endDate)) {
      alert('A data do serviço deve estar entre o check-in e o check-out da reserva.');
      return;
    }
    if (!freeDate && isHolidayServiceDate(serviceDate)) {
      const confirmed = confirm(`${SERVICE_HOLIDAY_BLOCK_MESSAGE}\n\nClique em OK para adicionar mesmo assim.`);
      if (!confirmed) return;

      const overrideInput = document.getElementById('service_holiday_block_override');
      if (overrideInput) overrideInput.value = '1';
    }

    // Criar objeto do serviço
    const service = {
      id: serviceIndex++,
      serviceId: serviceId,
      name: serviceName,
      price: servicePrice,
      date: serviceDate,
      quantity: quantity,
      total: servicePrice * quantity,
      observation: observation
    };

    // Adicionar ao array
    addedServices.push(service);

    // Ordenar por data
    addedServices.sort((a, b) => new Date(a.date) - new Date(b.date));

    // Renderizar lista
    renderServicesList();

    // Limpar inputs
    $('#service-select').val('').trigger('change');
    dateInput.value = document.getElementById('start_date')?.value || '';
    quantityInput.value = '1';
    if (observationInput) observationInput.value = '';
  }

  function removeService(id) {
    addedServices = addedServices.filter(s => s.id !== id);
    renderServicesList();
  }

  function formatCurrency(value) {
    return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value || 0);
  }

  function parseCurrencyInput(value) {
    const raw = String(value || '').trim();
    if (!raw) return 0;

    const normalized = raw.includes(',')
      ? raw.replace(/\./g, '').replace(',', '.')
      : raw;
    const parsed = Number(normalized);

    return Number.isFinite(parsed) ? parsed : 0;
  }

  function updatePaymentTotals() {
    const servicesTotal = addedServices.reduce((sum, service) => sum + (Number(service.total) || 0), 0);
    const dailyTotal = parseCurrencyInput(document.getElementById('reserva_total_price')?.value);
    const servicesTotalElement = document.getElementById('services-total-value');
    const checkoutTotalElement = document.getElementById('checkout-total-value');

    if (servicesTotalElement) servicesTotalElement.textContent = formatCurrency(servicesTotal);
    if (checkoutTotalElement) checkoutTotalElement.textContent = formatCurrency(dailyTotal + servicesTotal);
  }

  function renderServicesList() {
    const listContainer = document.getElementById('services-list');
    const hiddenInputsContainer = document.getElementById('services-hidden-inputs');
    const noServicesMsg = document.getElementById('no-services-msg');

    // Limpar containers
    listContainer.innerHTML = '';
    hiddenInputsContainer.innerHTML = '';

    if (addedServices.length === 0) {
      listContainer.innerHTML = '<p id="no-services-msg" class="text-center text-muted py-3">Nenhum serviço adicionado ainda.</p>';
      updatePaymentTotals();
      return;
    }

    // Renderizar cada serviço
    addedServices.forEach((service, index) => {
      // Formatar data para exibição
      const dateObj = new Date(service.date + 'T00:00:00');
      const formattedDate = dateObj.toLocaleDateString('pt-BR');

      // Criar item visual
      const itemHtml = `
        <div class="service-list-item border rounded p-2 mb-2" style="background: #f8fafc;">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
              <span class="badge bg-primary">📅 ${formattedDate}</span>
              <strong>${service.name}</strong>
              <span class="text-muted">Qtd: ${service.quantity}</span>
              <span class="text-success fw-bold">R$ ${service.total.toFixed(2).replace('.', ',')}</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeService(${service.id})">
              <i class="bi bi-trash"></i>
            </button>
          </div>
          ${service.observation ? `<div class="mt-1" style="font-size:0.85rem; color:#475569;">📝 ${service.observation}</div>` : ''}
        </div>
      `;
      listContainer.insertAdjacentHTML('beforeend', itemHtml);

      // Criar hidden inputs
      const hiddenInputsHtml = `
        <input type="hidden" name="reserva[reserva_services_attributes][${index}][service_id]" value="${service.serviceId}">
        <input type="hidden" name="reserva[reserva_services_attributes][${index}][service_date]" value="${service.date}">
        <input type="hidden" name="reserva[reserva_services_attributes][${index}][quantity]" value="${service.quantity}">
        <input type="hidden" name="reserva[reserva_services_attributes][${index}][observation]" value="${service.observation || ''}">
      `;
      hiddenInputsContainer.insertAdjacentHTML('beforeend', hiddenInputsHtml);
    });

    updatePaymentTotals();
  }
</script>

<!-- Script para datas -->
<script>
  document.addEventListener("turbo:load", function () {
    const cabanaSelect = document.getElementById('reserva_cabana_id');
    const dateRangeInput = document.getElementById("reservation_date_range");
    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");
    const serviceSelect = document.getElementById('service-select');

    serviceSelect?.addEventListener('change', updateServiceDateBounds);

    function initializeFlatpickr(cabanaId) {
      if (!cabanaId) return;

      fetch(`/cabanas/${cabanaId}/unavailable_dates?details=true`)
        .then(response => response.json())
        .then(payload => {
          const disabledDates = Array.isArray(payload) ? payload : payload.disabled_dates;
          const operationalBlocks = Array.isArray(payload) ? [] : payload.operational_blocks;
          const blocksByDate = new Map(operationalBlocks.map(block => [block.date, block]));

          if (dateRangeInput._flatpickr) {
            dateRangeInput._flatpickr.destroy();
          }

          flatpickr("#reservation_date_range", {
            mode: "range",
            minDate: "today",
            dateFormat: "Y-m-d",
            disable: disabledDates,
            defaultDate: startDateInput.value && endDateInput.value ? [startDateInput.value, endDateInput.value] : [],
            onChange: function (selectedDates, dateStr, instance) {
              if (selectedDates.length === 2) {
                startDateInput.value = instance.formatDate(selectedDates[0], "Y-m-d");
                endDateInput.value = instance.formatDate(selectedDates[1], "Y-m-d");
                updateServiceDateBounds();
                
                // Marcar o campo como válido quando as datas são selecionadas
                dateRangeInput.setCustomValidity('');
              } else {
                // Limpar os campos hidden se não há seleção completa
                startDateInput.value = '';
                endDateInput.value = '';
                updateServiceDateBounds();
                dateRangeInput.setCustomValidity('Por favor, selecione as datas de início e fim');
              }
            },
            onDayCreate: function (dObj, dStr, fp, dayElem) {
              const dateKey = fp.formatDate(dayElem.dateObj, 'Y-m-d');
              const operationalBlock = blocksByDate.get(dateKey);

              if (operationalBlock) {
                const className = operationalBlock.type === 'early_checkin'
                  ? 'early-checkin-blocked'
                  : 'late-checkout-blocked';
                const label = operationalBlock.type === 'early_checkin'
                  ? 'Early check-in: diária anterior bloqueada'
                  : 'Late checkout: diária seguinte bloqueada';

                dayElem.classList.add(className);
                dayElem.style.setProperty('--operational-color', operationalBlock.color || '#334155');
                dayElem.title = label;
              }

              dayElem.addEventListener('mouseenter', function () {
                if (fp.selectedDates.length === 1) {
                  dayElem.classList.remove('flatpickr-disabled');
                }
              });
            }
          });
        })
        .catch(err => {
          console.error("Erro ao buscar datas indisponíveis:", err);
        });
    }

    cabanaSelect.addEventListener("change", function (e) {
      const selectedCabanaId = e.target.value;
      initializeFlatpickr(selectedCabanaId);
    });

    if (cabanaSelect.value) {
      initializeFlatpickr(cabanaSelect.value);
    }
    updateServiceDateBounds();
  });
</script>

<!-- Script para toggle de criação de usuário -->
<script>
  function initializeReservationUserToggle() {
    // Script para toggle de criação de usuário
    const toggle = document.getElementById('create_user_toggle');
    const userFields = document.getElementById('new_user_fields');
    const existingUserFields = document.getElementById('existing_user_fields');
    const userSelect = document.getElementById('user_select');
    
    // Inicializar Select2
    if (userSelect && window.jQuery && $.fn.select2 && !$(userSelect).hasClass('select2-hidden-accessible')) {
      $('#user_select').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Selecione um usuário',
        allowClear: true
      });
    }

    // Campos obrigatórios para novo usuário
    const nameField = document.querySelector('input[name="user[name]"]');
    const emailField = document.querySelector('input[name="user[email]"]');

    if (!toggle) {
      if (nameField) nameField.setAttribute("required", "true");
      if (emailField) emailField.setAttribute("required", "true");
      return;
    }

    function updateRequiredFields() {
      if (toggle.checked) {
        // Criando novo usuário
        userFields.style.display = 'block';
        existingUserFields.style.display = 'none';
        
        // Tornar campos obrigatórios
        if (nameField) nameField.setAttribute("required", "true");
        if (emailField) emailField.setAttribute("required", "true");
        
        // Remover obrigatoriedade da seleção de usuário e limpar Select2
        userSelect.removeAttribute("required");
        if (window.jQuery && $.fn.select2) {
          $('#user_select').val(null).trigger('change');
        } else {
          userSelect.value = "";
        }
        
      } else {
        // Usando usuário existente
        userFields.style.display = 'none';
        existingUserFields.style.display = 'block';
        
        // Remover obrigatoriedade dos campos de novo usuário
        if (nameField) nameField.removeAttribute("required");
        if (emailField) emailField.removeAttribute("required");
        
        // Tornar seleção de usuário obrigatória
        userSelect.setAttribute("required", "true");
        
        // Limpar campos de novo usuário
        if (nameField) nameField.value = "";
        if (emailField) emailField.value = "";
        const telephoneField = document.getElementById('telephone_field');
        const partnerCheckbox = document.getElementById('partner_checkbox');
        if (telephoneField) telephoneField.value = "";
        if (partnerCheckbox) partnerCheckbox.checked = false;
      }
    }

    if (toggle.dataset.userToggleInitialized !== 'true') {
      toggle.addEventListener('change', updateRequiredFields);
      toggle.dataset.userToggleInitialized = 'true';
    }
    
    // Inicializar estado correto
    updateRequiredFields();
  }

  document.addEventListener('DOMContentLoaded', initializeReservationUserToggle);
  document.addEventListener('turbo:load', initializeReservationUserToggle);
  document.addEventListener('turbo:render', initializeReservationUserToggle);
  window.addEventListener('pageshow', initializeReservationUserToggle);
</script>

