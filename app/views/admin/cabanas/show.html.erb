<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4"><%= @cabana.name %></h1>

  <% if can_manage_reservations? %>
    <div class="d-flex gap-2 mb-4">
      <%= link_to 'Gerenciar Informações desta Cabana', admin_cabana_info_da_cabanas_path(@cabana), class: 'btn btn-primary d-flex align-items-center' %>
      <%= link_to 'Gerenciar Regras de Preço desta Cabana', price_rules_and_holidays_admin_cabana_path(@cabana), class: 'btn btn-primary d-flex align-items-center' %>
    </div>
  <% end %>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <% unless hide_financials? %>
        <p class="mb-2"><strong>Preço:</strong> <%= number_to_currency(@cabana.price) %></p>
      <% end %>
      <p class="mb-2"><strong>Filial:</strong> <%= @cabana.filial.name %></p>
    </div>
  </div>

  <div class="d-flex gap-2">
    <% if can_manage_reservations? %>
      <%= link_to 'Editar esta Cabana', edit_admin_cabana_path(@cabana), class: 'btn btn-warning' %>
    <% end %>
    <%= link_to 'Voltar', admin_cabanas_path, class: 'btn btn-secondary' %>
  </div>
</div>
