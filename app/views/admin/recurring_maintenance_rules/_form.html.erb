<%= form_with model: [:admin, rule], local: true do |form| %>
  <% if rule.errors.any? %>
    <div class="alert alert-danger">
      <strong>Não foi possível salvar.</strong>
      <ul class="mb-0">
        <% rule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <div class="form-check form-switch mb-3">
        <%= form.check_box :active, class: 'form-check-input' %>
        <%= form.label :active, 'Ativa', class: 'form-check-label' %>
      </div>

      <div class="mb-3">
        <%= form.label :title, 'Título enviado na programação', class: 'form-label fw-bold' %>
        <%= form.text_field :title, class: 'form-control', placeholder: 'Ex.: Olhar estrada' %>
      </div>

      <div class="mb-3">
        <%= form.label :recipients_text, 'Destinatários da mensagem da Flávia', class: 'form-label fw-bold' %>
        <%= form.text_area :recipients_text,
                           class: 'form-control',
                           rows: 4,
                           placeholder: "Bruna | 35999999999\nRubinho | 35999999998" %>
        <div class="form-text">Use uma pessoa por linha no formato: Nome | telefone.</div>
      </div>

      <div class="row g-3">
        <div class="col-12 col-md-3">
          <%= form.label :frequency_interval, 'Repetir a cada', class: 'form-label fw-bold' %>
          <%= form.number_field :frequency_interval, min: 1, class: 'form-control' %>
        </div>
        <div class="col-12 col-md-4">
          <%= form.label :frequency_unit, 'Período', class: 'form-label fw-bold' %>
          <%= form.select :frequency_unit,
                          RecurringMaintenanceRule::FREQUENCY_UNITS.map { |key, label| [label, key] },
                          {},
                          class: 'form-select' %>
        </div>
        <div class="col-12 col-md-5">
          <%= form.label :first_due_on, 'Data Alvo', class: 'form-label fw-bold' %>
          <%= form.date_field :first_due_on, class: 'form-control' %>
          <div class="form-text">
            Se houver limpeza na mesma cabana até 7 dias antes ou depois, a manutenção será alinhada para o dia da limpeza.
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <h2 class="h5 mb-3">Cabanas</h2>

      <div class="form-check mb-3">
        <%= form.check_box :all_cabanas, class: 'form-check-input', id: 'recurring-maintenance-all-cabanas' %>
        <%= form.label :all_cabanas, 'Todas as cabanas', class: 'form-check-label', for: 'recurring-maintenance-all-cabanas' %>
      </div>

      <div class="row g-2">
        <% @cabanas.each do |cabana| %>
          <div class="col-12 col-md-6">
            <label class="form-check border rounded p-3 h-100">
              <%= check_box_tag 'recurring_maintenance_rule[cabana_ids][]',
                                cabana.id,
                                rule.cabana_ids.include?(cabana.id),
                                class: 'form-check-input me-2' %>
              <span class="form-check-label">
                <strong><%= cabana.guest_display_name.presence || cabana.name %></strong>
                <span class="d-block small text-muted"><%= cabana.filial&.name %></span>
              </span>
            </label>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <%= form.label :message_body, 'Mensagem para a Flávia copiar no WhatsApp', class: 'form-label fw-bold' %>
      <%= form.text_area :message_body,
                         class: 'form-control',
                         rows: 8,
                         placeholder: "Oi {{nome}}, tudo bem?\n\nPode fazer {{titulo}} na {{cabana}} dia {{data_curta}}?" %>
      <div class="form-text">
        Variáveis disponíveis: {{nome}}, {{titulo}}, {{cabana}}, {{filial}}, {{data}}, {{data_curta}}.
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit 'Salvar manutenção', class: 'btn btn-success' %>
    <%= link_to 'Cancelar', admin_recurring_maintenance_rules_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>
