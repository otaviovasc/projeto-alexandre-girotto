<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4">Nova Cabana</h1>

  <div class="d-flex gap-2 mb-4">
    <%= link_to 'Voltar para Cabanas', admin_cabanas_path, class: 'btn btn-secondary d-flex align-items-center' %>
    <%= link_to 'Painel Administrativo', authenticated_root_path, class: 'btn btn-secondary d-flex align-items-center' %>
  </div>

  <%= form_with model: [:admin, @cabana], local: true, html: { class: 'needs-validation' } do |form| %>
    <div class="mb-3">
      <%= form.label :name, 'Nome', class: 'form-label' %>
      <%= form.text_field :name, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :price, 'Preço por dia (R$)', class: 'form-label' %>
      <%= form.number_field :price, step: 0.01, class: 'form-control' %>
    </div>

    <div class="mb-3">
      <%= form.label :filial_id, 'Filial', class: 'form-label' %>
      <%= form.collection_select :filial_id, Filial.all, :id, :name, {}, { class: 'form-select' } %>
    </div>

    <h3>Adicione imagens após a criação no botão de editar.</h3>

    <div class="d-flex gap-2 mt-4">
      <%= form.submit 'Salvar', class: 'btn btn-primary' %>
      <%= link_to 'Cancelar', admin_cabanas_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
