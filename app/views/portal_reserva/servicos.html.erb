<%# Portal da Reserva - Seleção de Serviços %>
<% content_for :title, "Meus serviços - Villaggio Girotto" %>

<div class="min-h-screen bg-[#f7f5f0]">
  <div class="bg-[#1a2e1a] text-white px-4 py-5 shadow-lg">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <div>
        <p class="text-white/50 text-xs uppercase tracking-widest">Meus serviços</p>
        <h1 class="text-xl font-bold leading-tight"><%= @reserva.cabana.name %></h1>
      </div>

      <%= button_to portal_reserva_sair_path, method: :delete, class: "flex items-center gap-1.5 text-white/60 hover:text-white text-xs transition shrink-0", form_class: "inline" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        Sair
      <% end %>
    </div>
  </div>

  <% if flash[:notice].present? || flash[:alert].present? %>
    <div class="max-w-7xl mx-auto px-4 pt-4">
      <% if flash[:notice].present? %>
        <div class="bg-green-50 border border-green-200 text-green-800 text-sm rounded-lg px-4 py-3">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="bg-red-50 border border-red-200 text-red-800 text-sm rounded-lg px-4 py-3">
          <%= flash[:alert] %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col lg:flex-row gap-6">
    <div class="flex-1">
      <h2 class="text-lg font-bold text-[#1a2e1a] mb-4">Serviços disponíveis</h2>

      <% if @services.any? %>
        <div class="space-y-3">
          <% meses = %w[Janeiro Fevereiro Março Abril Maio Junho Julho Agosto Setembro Outubro Novembro Dezembro] %>
          <% dias_semana = %w[Dom Seg Ter Qua Qui Sex Sáb] %>

          <% @services.each do |service| %>
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden hover:border-[#c8a96e]/70 transition">
              <div class="p-4">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="font-semibold text-[#1a2e1a] text-base leading-tight"><%= service.name %></h3>
                    <% if service.description.present? %>
                      <p class="text-gray-500 text-xs mt-1 leading-relaxed line-clamp-2"><%= service.description %></p>
                    <% end %>
                  </div>
                  <span class="text-[#1a2e1a] font-bold text-base whitespace-nowrap"><%= number_to_currency(service.price) %></span>
                </div>
              </div>

              <div class="border-t border-gray-100 bg-[#faf9f6] px-4 py-4">
                <%= form_with url: portal_reserva_adicionar_path, method: :post, local: true, class: "space-y-3" do |f| %>
                  <%= f.hidden_field :service_id, value: service.id %>
                  <%= f.hidden_field :quantity, value: 1 %>

                  <div>
                    <label class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider mb-2 block">Data do serviço</label>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                      <% @available_dates.each do |d| %>
                        <label class="flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs text-gray-700 cursor-pointer hover:border-[#c8a96e] hover:bg-[#fffdf8]">
                          <%= check_box_tag "service_dates[]", d.to_s, false,
                              class: "rounded border-gray-300 text-[#1a2e1a] focus:ring-[#c8a96e] w-4 h-4 cursor-pointer" %>
                          <span><%= "#{dias_semana[d.wday]}, #{d.day}/#{d.month}" %></span>
                        </label>
                      <% end %>
                    </div>
                  </div>

                  <% if food_service_for_observation?(service) %>
                    <div>
                      <label class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider mb-2 block">Restrição alimentar ou alergia (opcional)</label>
                      <%= f.text_area :observation,
                          rows: 2,
                          maxlength: 500,
                          id: "service_#{service.id}_observation",
                          placeholder: "Ex: intolerância à lactose, alergia a castanhas, sem cebola...",
                          class: "w-full bg-white border border-gray-200 text-gray-700 placeholder-gray-300 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] transition resize-none" %>
                      <p class="text-gray-400 text-[11px] mt-1">Essa observação será enviada junto com o serviço.</p>
                    </div>
                  <% end %>

                  <button type="submit" class="w-full sm:w-auto bg-[#1a2e1a] hover:bg-[#2d4a2d] text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition flex justify-center items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    Adicionar 1 unidade
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded-xl border border-dashed border-gray-200 py-14 text-center text-gray-400">
          <p class="text-sm">Nenhum serviço disponível no momento.</p>
        </div>
      <% end %>
    </div>

    <div class="lg:w-80 shrink-0">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 sticky top-4 overflow-hidden">
        <div class="bg-[#1a2e1a] px-5 py-4 flex items-center justify-between">
          <h2 class="text-white font-bold text-sm">Serviços selecionados</h2>
          <span class="bg-[#c8a96e] text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">
            <%= @portal_cart_items.count %>
          </span>
        </div>

        <div class="divide-y divide-gray-50">
          <% if @portal_cart_items.any? %>
            <% total = 0 %>
            <% grouped_cart_items = @portal_cart_items.group_by { |rs| [rs.service_id, rs.service_date, rs.observation.to_s.strip] } %>
            <% grouped_cart_items.each_value do |items| %>
              <% first_item = items.first %>
              <% quantity = items.sum { |item| item.quantity.to_i } %>
              <% subtotal = first_item.service.price * quantity %>
              <% total += subtotal %>
              <div class="px-5 py-4 flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-[#1a2e1a] leading-tight truncate"><%= first_item.service.name %></p>
                  <p class="text-xs text-gray-400 mt-0.5">
                    <%= quantity %> <%= quantity == 1 ? "unidade" : "unidades" %>
                    <% if first_item.service_date.present? %>
                      · <%= first_item.service_date.strftime("%d/%m") %>
                    <% end %>
                  </p>
                  <% if first_item.observation.present? %>
                    <p class="text-xs text-gray-500 mt-1 leading-snug">Obs: <%= first_item.observation %></p>
                  <% end %>
                </div>
                <div class="flex flex-col items-end gap-1 shrink-0">
                  <span class="text-sm font-semibold text-[#1a2e1a]"><%= number_to_currency(subtotal) %></span>
                  <%= button_to portal_reserva_remover_path(first_item), method: :delete, class: "text-gray-300 hover:text-red-400 transition", title: "Remover uma unidade" do %>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="px-5 py-4 bg-[#f7f5f0]">
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">Total</span>
                <span class="text-lg font-bold text-[#1a2e1a]"><%= number_to_currency(total) %></span>
              </div>
            </div>

            <div class="p-5 bg-white border-t border-gray-100">
              <%= button_to portal_reserva_pagar_path, method: :post, data: { turbo: false }, class: "w-full bg-[#c8a96e] hover:bg-[#b09258] text-white font-bold py-3 px-4 rounded-lg shadow-sm transition flex justify-center items-center gap-2", form_class: "w-full" do %>
                Pagar agora
              <% end %>
            </div>
          <% else %>
            <div class="px-5 py-10 text-center text-gray-400">
              <p class="text-sm">Nenhum serviço adicionado ainda.</p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-4 bg-white rounded-xl border border-gray-100 shadow-sm p-5 text-sm text-gray-600">
        <p class="font-semibold text-[#1a2e1a] text-xs uppercase tracking-wider mb-3">Cabana</p>
        <p class="font-medium text-[#1a2e1a]"><%= @reserva.cabana.name %></p>
      </div>
    </div>
  </div>
</div>
