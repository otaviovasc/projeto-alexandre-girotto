<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4">Nova Reserva</h1>

  <%= form_with model: @reserva, url: admin_reservas_path, local: true, html: { class: 'needs-validation' } do |form| %>
    <div class="form-check mb-3">
      <%= check_box_tag 'create_user', 'true', false, id: 'create_user_toggle', class: 'form-check-input' %>
      <%= label_tag 'create_user_toggle', 'Criar Novo Usuário?', class: 'form-check-label' %>
    </div>

    <div id="new_user_fields" style="display:none;" class="border rounded p-3 mb-4">
      <h5 class="mb-3">Detalhes do Novo Usuário</h5>
      <div class="mb-3">
        <%= label_tag :name, 'Nome', class: 'form-label' %>
        <%= text_field_tag 'user[name]', nil, class: 'form-control' %>
      </div>
      <div class="mb-3">
        <%= label_tag :email, 'E-mail', class: 'form-label' %>
        <%= text_field_tag 'user[email]', nil, class: 'form-control' %>
      </div>
      <!-- Campo Telefone (Novo) -->
      <div class="mb-3">
        <%= label_tag :telephone, 'Telefone', class: 'form-label' %>
        <%= text_field_tag 'user[telephone]', nil, class: 'form-control', id: 'telephone_field', required: true %>
      </div>
    </div>

    <div id="existing_user_fields" class="mb-3">
      <%= form.label :user_id, 'Selecionar Usuário', class: 'form-label' %>
      <%= form.collection_select :user_id, User.all, :id, :email, { prompt: 'Selecione um usuário' }, { class: 'form-select' } %>
    </div>

    <div class="mb-3">
      <%= form.label :cabana_id, 'Cabana', class: 'form-label' %>
      <%= form.collection_select :cabana_id, Cabana.all, :id, :name, { prompt: 'Selecione uma cabana' }, { class: 'form-select', id: 'reserva_cabana_id' } %>
    </div>

    <div class="mb-3" id="date-selection">
      <label for="reservation_date_range" class="form-label">Selecione as datas</label>
      <input type="text" id="reservation_date_range" placeholder="Selecione as datas" class="form-control" />
      <%= form.hidden_field :start_date, id: "start_date" %>
      <%= form.hidden_field :end_date, id: "end_date" %>
    </div>

    <div class="mb-3">
      <%= form.label :total_price, 'Preço Total', class: 'form-label' %>
      <span class="text-muted" style="font-size: smaller;">*obs: se deixar VAZIO, o preço é calculado normalmente.</span>
      <%= form.number_field :total_price, class: 'form-control', step: '0.01' %>
    </div>

    <div class="d-flex gap-2 mt-4">
      <%= form.submit 'Salvar', class: 'btn btn-primary' %>
      <%= link_to 'Cancelar', :back, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const cabanaSelect = document.getElementById('reserva_cabana_id');
    const dateRangeInput = document.getElementById("reservation_date_range");
    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");

    // Função para inicializar o flatpickr com as datas indisponíveis
    function initializeFlatpickr(cabanaId) {
      if (!cabanaId) return;

      fetch(`/cabanas/${cabanaId}/unavailable_dates`)
        .then(response => response.json())
        .then(disabledDates => {
          // Se já houver um flatpickr inicializado, destrua-o antes
          if (dateRangeInput._flatpickr) {
            dateRangeInput._flatpickr.destroy();
          }
          flatpickr("#reservation_date_range", {
            mode: "range",
            minDate: "today",
            dateFormat: "Y-m-d",
            disable: disabledDates,
            onChange: function(selectedDates, dateStr, instance) {
              // Se tiver duas datas selecionadas, atualize os hidden fields
              if (selectedDates.length === 2) {
                startDateInput.value = instance.formatDate(selectedDates[0], "Y-m-d");
                endDateInput.value = instance.formatDate(selectedDates[1], "Y-m-d");
              }
            }
          });
        })
        .catch(err => {
          console.error("Erro ao buscar datas indisponíveis:", err);
        });
    }

    // Quando o select de cabana mudar, reinicialize o flatpicker
    cabanaSelect.addEventListener("change", function(e) {
      const selectedCabanaId = e.target.value;
      initializeFlatpickr(selectedCabanaId);
    });

    // Se já houver um valor selecionado ao carregar a página, inicialize
    if (cabanaSelect.value) {
      initializeFlatpickr(cabanaSelect.value);
    }
  });
</script>

<script>
  document.addEventListener('turbo:load', function () {
    const toggle = document.getElementById('create_user_toggle');
    const userFields = document.getElementById('new_user_fields');
    const existingUserFields = document.getElementById('existing_user_fields');
    const telephoneField = document.getElementById("telephone_field");

    toggle.addEventListener('change', function () {
      if (toggle.checked) {
        userFields.style.display = 'block';
        existingUserFields.style.display = 'none';
        telephoneField.setAttribute("required", "true");

      } else {
        userFields.style.display = 'none';
        existingUserFields.style.display = 'block';
        telephoneField.removeAttribute("required");
      }
    });
  });
</script>
