<div class="bg-white rounded-md w-full max-w-4xl mx-auto p-6 flex flex-col gap-6">
  <!-- Status de pagamento -->
  <div class="flex flex-col items-center">
    <% if @reserva.payment_status == "paid" %>
      <h1 class="text-xl font-alice text-verde-escuro">Pagamento confirmado. Obrigado!</h1>
    <% else %>
      <h1 class="text-xl font-alice text-verde-escuro">Detalhes da Reserva</h1>
      <p class="text-gray-600 font-dm">Status do pagamento: <strong><%= @reserva.payment_status.present? ? @reserva.payment_status.humanize : 'Indefinido' %></strong></p>
    <% end %>
  </div>

  <!-- Botão de Pagamento -->
  <div class="flex justify-center">
    <% if @reserva.payment_status.in?(["pending", "refused", "waiting_payment"]) %>
      <%= link_to 'Pagar Reserva', pay_reserva_path(@reserva),
          class: 'bg-verde-escuro text-white px-4 py-2 rounded-md text-sm font-dm hover:bg-verde-escuro-hover transition' %>
    <% end %>
  </div>

  <!-- Detalhes da Reserva -->
  <div class="flex flex-col gap-4 border-t border-gray-300 pt-4">
    <h2 class="font-alice text-lg text-verde-escuro">Detalhes da Reserva</h2>
    <p><strong>Cabana:</strong> <%= @reserva.cabana.name %></p>
    <p><strong>Data de Início:</strong> <%= @reserva.start_date.strftime("%d/%m/%Y") %></p>
    <p><strong>Data de Fim:</strong> <%= @reserva.end_date.strftime("%d/%m/%Y") %></p>
    <p><strong>Preço Total:</strong> <%= number_to_currency(@reserva.total_price) %></p>
  </div>

  <!-- Serviços da Reserva -->
  <div class="flex flex-col gap-4 border-t border-gray-300 pt-4">
    <h2 class="font-alice text-lg text-verde-escuro">Serviços Adicionais</h2>
    <% if @reserva_services.any? %>
      <ul class="list-disc ml-6 text-gray-600">
        <% @reserva_services.each do |reserva_service| %>
          <li>
            <strong>Serviço:</strong> <%= reserva_service.service.name %>,
            <strong>Preço:</strong> <%= number_to_currency(reserva_service.service.price) %>,
            <strong>Quantidade:</strong> <%= reserva_service.quantity %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-600">Nenhum serviço adicional adquirido.</p>
    <% end %>
  </div>

  <!-- Itens da Reserva -->
  <div class="flex flex-col gap-4 border-t border-gray-300 pt-4">
    <h2 class="font-alice text-lg text-verde-escuro">Itens Adquiridos</h2>
    <% if @reserva_items.any? %>
      <ul class="list-disc ml-6 text-gray-600">
        <% @reserva_items.each do |reserva_item| %>
          <li>
            <strong>Item:</strong> <%= reserva_item.item.name %>,
            <strong>Preço:</strong> <%= number_to_currency(reserva_item.item.price) %>,
            <strong>Quantidade:</strong> <%= reserva_item.quantity %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-600">Nenhum item adquirido para esta reserva.</p>
    <% end %>
  </div>
  <div class="flex justify-start">
    <%= link_to 'Voltar para Reservas', reservas_path, class: 'text-verde-escuro underline hover:text-verde-escuro-hover font-dm text-sm' %>
  </div>
</div>
