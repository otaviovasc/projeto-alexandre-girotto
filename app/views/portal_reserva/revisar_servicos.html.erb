<% content_for :title, "Confirmar serviços - Villaggio Girotto" %>

<% grouped_cart_items = @portal_cart_items.group_by { |item| [item.service_id, item.service_date, item.observation.to_s.strip] } %>
<% services_total = grouped_cart_items.sum do |_key, items|
     first_item = items.first
     quantity = items.sum { |item| item.quantity.to_i }
     service_price_for(first_item.service) * quantity
   end %>
<% late_fee_amount = @service_purchase_late_fee_amount || 0 %>
<% total = services_total + late_fee_amount %>

<div class="min-h-screen bg-[#f7f5f0]">
  <div class="bg-[#1a2e1a] text-white px-4 py-5 shadow-lg">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      <div>
        <p class="text-white/50 text-xs uppercase tracking-widest">Meus serviços</p>
        <h1 class="text-xl font-bold leading-tight">Confirmar compra</h1>
      </div>

      <%= link_to "Voltar", portal_reserva_servicos_path, class: "text-white/70 hover:text-white text-sm font-medium transition" %>
    </div>
  </div>

  <main class="max-w-4xl mx-auto px-4 py-6">
    <section class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
      <div class="px-5 py-6 sm:px-7 border-b border-gray-100">
        <p class="text-xs font-semibold text-[#b09258] uppercase tracking-wider mb-2">Antes do pagamento</p>
        <h2 class="text-2xl font-bold text-[#1a2e1a] leading-tight">Revise os serviços selecionados</h2>
        <p class="text-sm text-gray-500 mt-2">
          Confira datas, quantidades e valores antes de seguir para o checkout seguro da Cielo.
        </p>
      </div>

      <div class="px-5 py-5 sm:px-7 bg-[#faf9f6] border-b border-gray-100">
        <div class="grid sm:grid-cols-3 gap-3 text-sm">
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider">Responsável</p>
            <p class="font-semibold text-[#1a2e1a] mt-1"><%= @reserva.user.name %></p>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider">Reserva</p>
            <p class="font-semibold text-[#1a2e1a] mt-1">#<%= @reserva.id %></p>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider">Cabana</p>
            <p class="font-semibold text-[#1a2e1a] mt-1"><%= @reserva.cabana.name %></p>
          </div>
        </div>
      </div>

      <div class="divide-y divide-gray-100">
        <% grouped_cart_items.each_value do |items| %>
          <% first_item = items.first %>
          <% quantity = items.sum { |item| item.quantity.to_i } %>
          <% subtotal = service_price_for(first_item.service) * quantity %>

          <div class="px-5 py-4 sm:px-7 flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="font-semibold text-[#1a2e1a] leading-tight"><%= first_item.service.name %></p>
              <p class="text-sm text-gray-500 mt-1">
                <%= quantity %> <%= quantity == 1 ? "unidade" : "unidades" %>
                <% if first_item.service_date.present? %>
                  - <%= first_item.service_date.strftime("%d/%m/%Y") %>
                <% end %>
              </p>
              <% if first_item.observation.present? %>
                <p class="text-sm text-gray-600 mt-1">Observação: <%= first_item.observation %></p>
              <% end %>
            </div>
            <p class="font-bold text-[#1a2e1a] whitespace-nowrap"><%= number_to_currency(subtotal) %></p>
          </div>
        <% end %>

        <% if late_fee_amount.positive? %>
          <div class="px-5 py-4 sm:px-7 flex items-start justify-between gap-4 bg-[#fffaf0]">
            <div class="min-w-0">
              <p class="font-semibold text-[#1a2e1a] leading-tight">Taxa administrativa para compra fora do prazo</p>
              <p class="text-sm text-gray-500 mt-1">Aplicada porque esta compra está fora do prazo normal.</p>
            </div>
            <p class="font-bold text-[#1a2e1a] whitespace-nowrap"><%= number_to_currency(late_fee_amount) %></p>
          </div>
        <% end %>
      </div>

      <div class="px-5 py-5 sm:px-7 bg-[#f7f5f0] flex items-center justify-between gap-4">
        <span class="text-sm text-gray-500">Total a pagar</span>
        <span class="text-xl font-bold text-[#1a2e1a]"><%= number_to_currency(total) %></span>
      </div>
    </section>

    <section class="mt-4 bg-white rounded-xl border border-gray-100 shadow-sm p-5 sm:p-7">
      <div class="rounded-lg border border-[#ead9b7] bg-[#fffaf0] p-4 text-sm leading-6 text-[#6f5523]">
        <p class="font-bold text-[#1a2e1a]">Atenção às regras dos serviços adicionais</p>
        <p class="mt-2">
          Os serviços são preparados e agendados com antecedência com prestadores parceiros. Depois da confirmação do pagamento, não poderão ser cancelados nem reembolsados por desistência do hóspede.
        </p>
      </div>

      <details class="mt-4 rounded-lg border border-gray-200 bg-[#faf9f6]">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3 text-sm font-bold text-[#1a2e1a]">
          <span>Ler regras dos serviços</span>
          <span class="text-xl leading-none">+</span>
        </summary>
        <div class="border-t border-gray-200 p-4 text-sm leading-6">
          <%= render 'fnrh_portal/service_terms' %>
        </div>
      </details>

      <%= form_with url: portal_reserva_pagar_path, method: :post, local: true, data: { turbo: false }, class: "mt-5 space-y-4" do |form| %>
        <label class="flex items-start gap-3 rounded-lg border border-gray-200 bg-[#faf9f6] p-4 text-sm leading-6 text-gray-600">
          <%= form.check_box :service_terms_accepted,
              { required: true, class: "mt-1 h-5 w-5 shrink-0 accent-[#1a2e1a]" },
              "1",
              "0" %>
          <span>Declaro que li, compreendi e concordo com as regras dos serviços adicionais.</span>
        </label>

        <div class="flex flex-col gap-3 sm:flex-row">
          <%= link_to "Cancelar",
              portal_reserva_servicos_path,
              class: "inline-flex min-h-[52px] w-full items-center justify-center rounded-lg border border-gray-200 bg-white px-5 py-3 text-center text-sm font-bold text-[#1a2e1a] transition hover:border-[#1a2e1a]" %>

          <button type="submit" class="inline-flex min-h-[52px] w-full items-center justify-center rounded-lg bg-[#1a2e1a] px-5 py-3 text-center text-sm font-bold text-white transition hover:bg-[#2d4a2d]">
            Concordo e seguir para pagamento
          </button>
        </div>
      <% end %>
    </section>
  </main>
</div>
