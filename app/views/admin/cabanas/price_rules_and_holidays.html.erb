<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4">Gerenciar Regras de Preço, Feriados e Promoções para <%= @cabana.name %></h1>

  <!-- Seção de Regras de Preço -->
  <h2 class="h4 mb-3">Regras de Preço</h2>
  <%= form_with model: @price_rule, url: admin_cabana_price_rules_path(@cabana), local: true, html: { class: 'needs-validation' } do |form| %>
    <div class="mb-3">
      <%= form.label :day_type, 'Tipo de Dia', class: 'form-label' %>
      <%= form.select :day_type, [['Dia de Semana', 'weekday'], ['Fim de Semana', 'weekend'], ['Feriado', 'holiday']], {}, { class: 'form-select' } %>
    </div>
    <div class="mb-3">
      <%= form.label :price, 'Preço', class: 'form-label' %>
      <%= form.number_field :price, step: 0.01, class: 'form-control' %>
    </div>
    <%= form.submit 'Salvar Regra de Preço', class: 'btn btn-primary mt-2' %>
  <% end %>

  <h3 class="h5 mt-4">Regras de Preço Existentes</h3>
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead class="table-light">
        <tr>
          <th>Tipo de Dia</th>
          <th>Preço</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @cabana.price_rules.each do |rule| %>
          <tr>
            <td><%= rule.day_type.capitalize %></td>
            <td><%= number_to_currency(rule.price) %></td>
            <td>
              <%= link_to 'Excluir', admin_cabana_price_rule_path(@cabana, rule), data: { turbo_method: :delete, confirm: 'Você tem certeza?' }, class: 'btn btn-sm btn-danger' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Seção de Feriados (global) -->
  <h2 class="h4 mt-5">Feriados</h2>
  <%= form_with model: @holiday, url: admin_holidays_path, local: true, html: { class: 'needs-validation' } do |form| %>
    <div class="mb-3">
      <%= form.label :name, 'Nome do Feriado', class: 'form-label' %>
      <%= form.text_field :name, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= form.label :date, 'Data do Feriado', class: 'form-label' %>
      <%= form.date_field :date, class: 'form-control' %>
    </div>
    <%= form.submit 'Salvar Feriado', class: 'btn btn-primary mt-2' %>
  <% end %>

  <h3 class="h5 mt-4">Feriados Existentes</h3>
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead class="table-light">
        <tr>
          <th>Data</th>
          <th>Nome do Feriado</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @holidays.each do |holiday| %>
          <tr>
            <td><%= holiday.date.strftime("%d/%m/%Y") %></td>
            <td><%= holiday.name %></td>
            <td>
              <%= link_to 'Excluir', admin_holiday_path(holiday), data: { turbo_method: :delete, confirm: 'Você tem certeza?' }, class: 'btn btn-sm btn-danger' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Seção de Promoções (exclusiva para cada cabana) -->
  <h2 class="h4 mt-5">Promoções</h2>
  <%= form_with model: @promotion, url: admin_cabana_promotions_path(@cabana), local: true, html: { class: 'needs-validation' } do |form| %>
    <div class="mb-3">
      <%= form.label :date, 'Data da Promoção', class: 'form-label' %>
      <%= form.date_field :date, class: 'form-control' %>
    </div>
    <div class="mb-3">
      <%= form.label :price, 'Preço Promocional', class: 'form-label' %>
      <%= form.number_field :price, step: 0.01, class: 'form-control' %>
    </div>
    <%= form.submit 'Salvar Promoção', class: 'btn btn-primary mt-2' %>
  <% end %>

  <h3 class="h5 mt-4">Promoções Existentes</h3>
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead class="table-light">
        <tr>
          <th>Data</th>
          <th>Preço Promocional</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @cabana.promotions.order(:date).each do |promo| %>
          <tr>
            <td><%= promo.date.strftime("%d/%m/%Y") %></td>
            <td><%= number_to_currency(promo.price) %></td>
            <td>
              <%= link_to 'Excluir', admin_cabana_promotion_path(@cabana, promo), data: { turbo_method: :delete, confirm: 'Você tem certeza?' }, class: 'btn btn-sm btn-danger' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= link_to 'Voltar para Cabana', admin_cabana_path(@cabana), class: 'btn btn-secondary' %>
  </div>
</div>
