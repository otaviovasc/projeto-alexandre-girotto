<style>
  .reserva-show-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .reserva-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .reserva-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .reserva-id {
    background: #e2e8f0;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.9rem;
    color: #64748b;
  }

  .status-badge {
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .status-paid { background: #dcfce7; color: #166534; }
  .status-pending { background: #fef3c7; color: #92400e; }
  .status-waiting_payment { background: #dbeafe; color: #1e40af; }
  .status-canceled { background: #fee2e2; color: #991b1b; }
  .status-refused { background: #fecaca; color: #b91c1c; }

  .info-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-label {
    font-size: 0.8rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .info-value {
    font-size: 1rem;
    color: #1e293b;
    font-weight: 500;
  }

  .info-value.highlight {
    font-size: 1.25rem;
    color: #059669;
    font-weight: 700;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }

  .service-item.cancelled {
    opacity: 0.6;
    background: #fef2f2;
    border-color: #fecaca;
  }

  .service-item.payment-canceled {
    background: #fef2f2;
    border-color: #ef4444;
    color: #991b1b;
  }

  .service-item.payment-canceled .service-date,
  .service-item.payment-canceled .service-name {
    color: #991b1b;
  }

  .service-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .service-name {
    font-weight: 500;
    color: #1e293b;
  }

  .service-date {
    font-size: 0.85rem;
    color: #64748b;
  }

  .service-quantity {
    background: #e2e8f0;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #475569;
  }

  .service-status-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .empty-state {
    text-align: center;
    padding: 1.5rem;
    color: #94a3b8;
  }

  .action-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-primary {
    background: #3b82f6;
    color: white;
  }

  .btn-primary:hover {
    background: #2563eb;
    transform: translateY(-1px);
  }

  .btn-danger {
    background: #ef4444;
    color: white;
  }

  .btn-danger:hover {
    background: #dc2626;
  }

  .btn-secondary {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
  }

  .btn-secondary:hover {
    background: #e2e8f0;
  }

  .observation-text {
    background: #f8fafc;
    padding: 0.75rem;
    border-radius: 6px;
    font-size: 0.95rem;
    color: #475569;
    border-left: 3px solid #3b82f6;
  }

  .purchase-access-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .purchase-access-copy {
    color: #475569;
    font-size: 0.9rem;
    margin: 0;
  }

  .purchase-access-status {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .purchase-access-status.open { background: #dcfce7; color: #166534; }
  .purchase-access-status.closed { background: #fee2e2; color: #991b1b; }
  .purchase-access-status.normal { background: #dbeafe; color: #1e40af; }

  .ical-history-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ical-history-item {
    border-left: 4px solid #f97316;
    padding: 0.9rem 1rem;
    background: #fff7ed;
  }

  .ical-history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .ical-history-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem 1rem;
  }

  .ical-history-value {
    color: #1e293b;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .ical-history-status {
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .ical-history-status.pending { background: #ffedd5; color: #c2410c; }
  .ical-history-status.done { background: #dcfce7; color: #166534; }
</style>

<div class="reserva-show-container">
  <!-- Header -->
  <div class="reserva-header">
    <h1 class="reserva-title">
      🏨 Reserva
      <span class="reserva-id">#<%= @reserva.id %></span>
    </h1>
    <span class="status-badge status-<%= @reserva.payment_status %>">
      <%= @reserva.payment_status.humanize %>
    </span>
    <% unless @reserva.blocks_availability? %>
      <span class="status-badge status-pending">Não bloqueia datas</span>
    <% end %>
    <% if @reserva.waiting_payment? && @reserva.payment_expires_at.present? %>
      <span class="status-badge status-pending">
        Pré-travada até <%= @reserva.payment_expires_at.in_time_zone("America/Sao_Paulo").strftime("%d/%m %H:%M") %>
      </span>
    <% end %>
  </div>

  <!-- Informações Principais -->
  <div class="info-card">
    <h3 class="info-card-title">📋 Informações da Reserva</h3>
    <div class="info-grid">
      <div class="info-item">
        <span class="info-label">Cabana</span>
        <span class="info-value"><%= @reserva.cabana.name %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Hóspede</span>
        <span class="info-value"><%= @reserva.user.name || @reserva.user.email %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Email</span>
        <span class="info-value"><%= @reserva.user.email %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Telefone</span>
        <span class="info-value"><%= @reserva.user.telephone || '—' %></span>
      </div>
      <% if @reserva.imported? %>
        <div class="info-item">
          <span class="info-label">Nome real do hóspede</span>
          <span class="info-value"><%= @reserva.guest_name.presence || 'Ainda não informado' %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Telefone real do hóspede</span>
          <span class="info-value"><%= @reserva.guest_phone.presence || 'Ainda não informado' %></span>
        </div>
      <% end %>
      <div class="info-item">
        <span class="info-label">Check-in</span>
        <span class="info-value"><%= l @reserva.start_date, format: :long rescue @reserva.start_date %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Check-out</span>
        <span class="info-value"><%= l @reserva.end_date, format: :long rescue @reserva.end_date %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Early check-in</span>
        <span class="info-value"><%= @reserva.early_checkin? ? 'Sim - diária anterior bloqueada' : 'Não' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Late checkout</span>
        <span class="info-value"><%= @reserva.late_checkout? ? 'Sim - diária seguinte bloqueada' : 'Não' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Noites</span>
        <span class="info-value"><%= (@reserva.end_date - @reserva.start_date).to_i %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Preço Total</span>
        <span class="info-value highlight"><%= number_to_currency(@reserva.total_price, unit: 'R$ ', separator: ',', delimiter: '.') %></span>
      </div>
    </div>

    <% if @reserva.observation.present? %>
      <div class="info-item" style="margin-top: 1rem;">
        <span class="info-label">Observação / Origem</span>
        <div class="observation-text"><%= @reserva.observation %></div>
      </div>
    <% end %>
  </div>

  <% if @reserva.reserva_payments.any? %>
    <% reservation_payments = @reserva.reserva_payments.order(:installment_number) %>
    <% message_payments = reservation_payments.select { |payment| payment.paid? || payment.waiting_payment? } %>
    <% first_payment = message_payments.find(&:confirmation_installment?) || message_payments.first %>
    <% active_payment_count = reservation_payments.reject(&:canceled?).size %>
    <% next_extra_due_at = 1.day.from_now.in_time_zone('America/Sao_Paulo').strftime('%Y-%m-%dT%H:%M') %>
    <% if message_payments.one? %>
      <% payment = message_payments.first %>
      <% due_at_text = payment.due_at.in_time_zone('America/Sao_Paulo').strftime('%d/%m/%Y, às %Hh%M') %>
      <% message_lines = ["Segue abaixo o link para realizar a reserva:", ""] %>
      <% if payment.waiting_payment? %>
        <% message_lines << "A data e o link ficarão pré-reservados até **#{due_at_text}**. Após a confirmação do pagamento, as datas serão confirmadas." %>
        <% message_lines << "" %>
      <% end %>
      <% message_lines << "**Pagamento até #{due_at_text}:**" %>
      <% message_lines << "" %>
      <% message_lines << payment.public_payment_url %>
      <% message_lines << "" %>
      <% message_lines << "⚠️ A data e o link ficam pré-reservados por até 3 horas. Após a confirmação do pagamento, as datas serão confirmadas." %>
      <% message_lines << "" %>
      <% message_lines << "⚠️ Caso o pagamento não seja realizado dentro do prazo, a reserva poderá ser cancelada automaticamente." %>
    <% else %>
      <% message_lines = ["Segue abaixo os links para realizar a reserva e mantê-la em dia:", ""] %>
      <% if first_payment&.waiting_payment? %>
        <% message_lines << "A data e o link ficam pré-travados até #{first_payment.due_at.in_time_zone('America/Sao_Paulo').strftime('%d/%m/%Y às %H:%M')}. Depois do pagamento da primeira parcela, as datas ficam confirmadas." %>
        <% message_lines << "" %>
      <% end %>
      <% message_payments.each do |payment| %>
        <% message_lines << "#{payment.installment_number}ª parcela até #{payment.due_at.in_time_zone('America/Sao_Paulo').strftime('%d/%m/%Y às %H:%M')}:" %>
        <% message_lines << payment.public_payment_url %>
        <% message_lines << "" %>
      <% end %>
      <% message_lines << "⚠️ A data e o link ficam pré-reservados por até 3h. Após o pagamento da primeira parcela, as datas ficam confirmadas." %>
      <% message_lines << "⚠️ Se uma parcela for atrasada ou não paga, a reserva pode ser cancelada automaticamente." %>
    <% end %>

    <div class="info-card">
      <h3 class="info-card-title">Pagamento da reserva</h3>
      <p class="purchase-access-copy">Links públicos com aceite de termos antes de seguir para a Cielo.</p>

      <div class="services-list" style="margin-top: 1rem;">
        <% reservation_payments.each do |payment| %>
          <% if payment.canceled? %>
            <div class="service-item payment-canceled">
              <div class="service-info">
                <span class="service-date"><%= payment.due_at.in_time_zone('America/Sao_Paulo').strftime('%d/%m/%Y às %H:%M') %></span>
                <span class="service-quantity"><%= payment.payment_status.humanize %></span>
              </div>
              <span style="margin-left: 0.5rem; color: #991b1b; font-weight: 600;">
                <%= number_to_currency(payment.amount, unit: 'R$ ', separator: ',', delimiter: '.') %>
              </span>
            </div>
          <% else %>
            <div class="service-item">
              <div class="service-info">
                <span class="service-name"><%= payment.installment_number %>ª parcela</span>
                <span class="service-date"><%= payment.due_at.in_time_zone('America/Sao_Paulo').strftime('%d/%m/%Y às %H:%M') %></span>
                <span class="service-quantity"><%= payment.payment_status.humanize %></span>
              </div>
              <div>
                <span style="margin-left: 0.5rem; color: #059669; font-weight: 600;">
                  <%= number_to_currency(payment.amount, unit: 'R$ ', separator: ',', delimiter: '.') %>
                </span>
                <%= link_to 'Abrir link',
                    payment.public_payment_url,
                    class: 'btn btn-sm btn-outline-primary ms-2',
                    target: '_blank',
                    rel: 'noopener',
                    data: { turbo: false } %>
                <% unless payment.paid? %>
                  <%= button_to mark_paid_admin_reserva_payment_path(payment),
                      method: :patch,
                      class: 'btn btn-sm btn-success ms-2',
                      form_class: 'd-inline',
                      data: { turbo_confirm: 'Marcar esta parcela como paga manualmente?' } do %>
                    Marcar paga
                  <% end %>
                  <%= button_to cancel_admin_reserva_payment_path(payment),
                      method: :patch,
                      class: 'btn btn-sm btn-danger ms-2',
                      form_class: 'd-inline',
                      data: { turbo_confirm: 'Cancelar este link no sistema?' } do %>
                    Cancelar link
                  <% end %>
                <% end %>
              </div>
              <% unless payment.paid? %>
                <%= form_with url: regenerate_admin_reserva_payment_path(payment),
                    method: :patch,
                    local: true,
                    class: 'mt-2 d-flex flex-wrap gap-2 align-items-end' do |form| %>
                  <div>
                    <%= form.label :amount, 'Novo valor', class: 'form-label mb-1' %>
                    <%= form.text_field :amount,
                        value: number_with_precision(payment.amount, precision: 2, separator: ',', delimiter: ''),
                        class: 'form-control form-control-sm',
                        style: 'max-width: 120px;' %>
                  </div>
                  <div>
                    <%= form.label :due_at, 'Novo prazo', class: 'form-label mb-1' %>
                    <%= form.datetime_local_field :due_at,
                        value: payment.due_at.in_time_zone('America/Sao_Paulo').strftime('%Y-%m-%dT%H:%M'),
                        class: 'form-control form-control-sm' %>
                  </div>
                  <%= form.submit 'Gerar novo link para esta parcela',
                      class: 'btn btn-sm btn-outline-primary',
                      data: { turbo_confirm: 'Cancelar o link antigo e gerar um novo?' } %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <% if active_payment_count < 3 %>
        <div class="info-item" style="margin-top: 1rem;">
          <span class="info-label">Adicionar parcela</span>
          <%= form_with url: admin_reserva_payments_path,
              method: :post,
              local: true,
              class: 'mt-2 d-flex flex-wrap gap-2 align-items-end' do |form| %>
            <%= hidden_field_tag :reserva_id, @reserva.id %>
            <div>
              <%= form.label :amount, 'Valor', class: 'form-label mb-1' %>
              <%= form.text_field :amount,
                  class: 'form-control form-control-sm',
                  placeholder: 'Ex.: 500,00',
                  style: 'max-width: 120px;' %>
            </div>
            <div>
              <%= form.label :due_at, 'Prazo', class: 'form-label mb-1' %>
              <%= form.datetime_local_field :due_at,
                  value: next_extra_due_at,
                  class: 'form-control form-control-sm' %>
            </div>
            <%= form.submit 'Gerar mais uma parcela',
                class: 'btn btn-sm btn-primary',
                data: { turbo_confirm: 'Gerar mais uma parcela para esta reserva?' } %>
          <% end %>
        </div>
      <% end %>

      <% if message_payments.any? %>
        <div style="margin-top: 1rem;">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <label class="info-label mb-0" for="reservation-payment-message">Mensagem para enviar ao hóspede</label>
            <button type="button" id="copy-reservation-payment-message" class="btn btn-sm btn-primary">
              Copiar mensagem
            </button>
          </div>
          <textarea id="reservation-payment-message" class="form-control" rows="10" readonly><%= message_lines.join("\n") %></textarea>
          <p id="copy-reservation-payment-feedback" style="display: none; color: #166534; font-weight: 600; margin-top: 0.5rem;">
            Mensagem copiada.
          </p>
        </div>
      <% else %>
        <div class="empty-state">Nenhum link ativo para enviar ao hóspede.</div>
      <% end %>
    </div>
  <% end %>

  <%= render 'fnrh_panel', reserva: @reserva %>

  <% if @reserva.ical_reservation_changes.exists? %>
    <div class="info-card">
      <div class="ical-history-header">
        <h3 class="info-card-title" style="margin-bottom: 0; flex: 1;">Histórico de alterações do iCal</h3>
        <% if @reserva.ical_date_changed? %>
          <%= button_to acknowledge_ical_date_change_admin_reserva_path(@reserva),
              method: :patch,
              class: 'btn btn-secondary',
              form_class: 'd-inline' do %>
            <i class="bi bi-check-circle"></i> Concluído
          <% end %>
        <% end %>
      </div>

      <div class="ical-history-list">
        <% @reserva.ical_reservation_changes.recent_first.each do |change| %>
          <div class="ical-history-item">
            <div class="ical-history-header">
              <strong><%= change.platform.capitalize %> · <%= change.created_at.in_time_zone("America/Sao_Paulo").strftime("%d/%m/%Y - %H:%Mh") %></strong>
              <span class="ical-history-status <%= change.acknowledged? ? 'done' : 'pending' %>">
                <%= change.acknowledged? ? 'Concluído' : 'Pendente' %>
              </span>
            </div>

            <div class="ical-history-grid">
              <div>
                <span class="info-label">Datas anteriores</span>
                <div class="ical-history-value"><%= change.old_start_date.strftime("%d/%m/%Y") %> a <%= change.old_end_date.strftime("%d/%m/%Y") %></div>
              </div>
              <div>
                <span class="info-label">Novas datas</span>
                <div class="ical-history-value"><%= change.new_start_date.strftime("%d/%m/%Y") %> a <%= change.new_end_date.strftime("%d/%m/%Y") %></div>
              </div>
              <div>
                <span class="info-label">Identificador anterior</span>
                <div class="ical-history-value"><%= change.old_uid.presence || 'Não informado' %></div>
              </div>
              <div>
                <span class="info-label">Novo identificador</span>
                <div class="ical-history-value"><%= change.new_uid.presence || 'Não informado' %></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% normal_purchase_window_open = @reserva.service_purchase_block_date.present? && Date.current < @reserva.service_purchase_block_date %>
  <% special_purchase_access_open = @reserva.service_purchase_override_open? %>

  <div class="info-card">
    <h3 class="info-card-title">Compra de serviços pelo hóspede</h3>
    <div class="purchase-access-row">
      <div>
        <% if special_purchase_access_open %>
          <span class="purchase-access-status open">Liberação especial ativa</span>
          <p class="purchase-access-copy">Esta reserva pode comprar serviços até o check-in em <%= @reserva.start_date.strftime('%d/%m/%Y') %>.</p>
        <% elsif normal_purchase_window_open %>
          <span class="purchase-access-status normal">Prazo normal aberto</span>
          <p class="purchase-access-copy">As compras ficam abertas normalmente até <%= @reserva.service_purchase_block_date.strftime('%d/%m/%Y') %>.</p>
        <% elsif @reserva.start_date.present? && Date.current <= @reserva.start_date %>
          <span class="purchase-access-status closed">Prazo normal encerrado</span>
          <p class="purchase-access-copy">Você pode liberar uma exceção somente para esta reserva.</p>
        <% else %>
          <span class="purchase-access-status closed">Check-in já iniciado</span>
          <p class="purchase-access-copy">Não é possível liberar novas compras depois do check-in.</p>
        <% end %>
      </div>

      <% if @reserva.service_purchase_override? %>
        <%= button_to 'Revogar liberação',
            update_service_purchase_access_admin_reserva_path(@reserva),
            method: :patch,
            params: { service_purchase_override: false },
            class: 'btn btn-secondary',
            form_class: 'd-inline' %>
      <% elsif !normal_purchase_window_open && @reserva.start_date.present? && Date.current <= @reserva.start_date %>
        <%= button_to 'Liberar até o check-in',
            update_service_purchase_access_admin_reserva_path(@reserva),
            method: :patch,
            params: { service_purchase_override: true },
            class: 'btn btn-primary',
            form_class: 'd-inline' %>
      <% end %>
    </div>

    <div class="purchase-access-row" style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;">
      <div>
        <span class="purchase-access-status normal">Cartão em até <%= @reserva.service_max_installments %>x</span>
        <p class="purchase-access-copy">Vale somente para novas compras de serviços desta reserva. A hospedagem não é alterada.</p>
      </div>

      <%= form_with url: update_service_installments_admin_reserva_path(@reserva), method: :patch, local: true, class: 'd-flex align-items-center gap-2' do %>
        <%= select_tag :service_max_installments,
            options_for_select((1..12).map { |number| ["#{number}x", number] }, @reserva.service_max_installments),
            class: 'form-select',
            style: 'width: auto;' %>
        <%= submit_tag 'Salvar parcelas', class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>

  <div class="info-card">
    <h3 class="info-card-title">E-mails da reserva</h3>
    <% email_setting = EmailAutomationSetting.current %>
    <div class="purchase-access-row">
      <div>
        <% if email_setting.enabled? %>
          <span class="purchase-access-status open">Envio automático ativo</span>
        <% else %>
          <span class="purchase-access-status closed">Envio automático pausado</span>
        <% end %>
        <p class="purchase-access-copy">Os disparos ficam registrados aqui para acompanhamento.</p>
      </div>
      <%= link_to 'Configurar e-mails', admin_reservation_email_templates_path, class: 'btn btn-outline-primary' %>
    </div>

    <% deliveries = @reserva.reservation_email_deliveries.includes(:reservation_email_template).order(:scheduled_at, :id) %>
    <% if deliveries.any? %>
      <div class="services-list" style="margin-top: 1rem;">
        <% deliveries.each do |delivery| %>
          <div class="service-item">
            <div class="service-info">
              <span class="service-name"><%= delivery.reservation_email_template&.name || delivery.trigger_key %></span>
              <span class="service-date"><%= delivery.scheduled_at.in_time_zone('America/Sao_Paulo').strftime('%d/%m/%Y às %H:%M') %></span>
              <span class="service-quantity"><%= delivery.status.humanize %></span>
            </div>
            <div>
              <% badge_color = case delivery.status
                               when 'sent' then '#dcfce7; color: #166534'
                               when 'failed' then '#fee2e2; color: #991b1b'
                               when 'canceled' then '#e2e8f0; color: #475569'
                               else '#fef3c7; color: #92400e'
                               end %>
              <span class="service-status-badge" style="background: <%= badge_color %>;">
                <%= delivery.status.humanize %>
              </span>
            </div>
          </div>
          <% if delivery.error_message.present? %>
            <div style="font-size: 0.85rem; color: #991b1b; padding: 0.25rem 0.5rem 0.5rem; border-left: 3px solid #fecaca; margin-left: 0.25rem;">
              <%= delivery.error_message %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>Nenhum e-mail agendado para esta reserva.</p>
      </div>
    <% end %>
  </div>

  <!-- Serviços -->
  <div class="info-card">
    <h3 class="info-card-title">🛎️ Serviços</h3>
    
    <% if @reserva.reserva_services.any? %>
      <div class="services-list">
        <% @reserva.reserva_services.includes(:service).each do |rs| %>
          <div class="service-item <%= rs.cancelled? ? 'cancelled' : '' %>">
            <div class="service-info">
              <span class="service-name"><%= rs.service.name %></span>
              <span class="service-quantity">x<%= rs.quantity %></span>
              <% if rs.service_date.present? %>
                <span class="service-date">📅 <%= rs.service_date.strftime('%d/%m/%Y') %></span>
              <% end %>
            </div>
            <div>
              <% if rs.cancelled? %>
                <span class="service-status-badge" style="background: #fee2e2; color: #991b1b;">Cancelado</span>
              <% else %>
                <span class="service-status-badge" style="background: #dcfce7; color: #166534;">Ativo</span>
              <% end %>
              <span style="margin-left: 0.5rem; color: #059669; font-weight: 600;">
                <%= number_to_currency((rs.unit_price_paid || rs.service.price_for(@reserva)) * rs.quantity, unit: 'R$ ', separator: ',', delimiter: '.') %>
              </span>
            </div>
          </div>
          <% if rs.observation.present? %>
            <div style="font-size: 0.85rem; color: #475569; padding: 0.25rem 0.5rem 0.5rem; border-left: 3px solid #e2e8f0; margin-left: 0.25rem;">
              📝 <%= rs.observation %>
            </div>
          <% end %>
          <% if rs.photo_print_pdf.attached? %>
            <div style="padding: 0.35rem 0.5rem 0.75rem; margin-left: 0.25rem;">
              <%= link_to '📄 Baixar PDF das fotos',
                  photo_print_pdf_admin_reserva_service_path(rs),
                  class: 'btn btn-sm btn-outline-primary',
                  data: { turbo: false } %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>Nenhum serviço adicional nesta reserva</p>
      </div>
    <% end %>
  </div>

  <!-- Ações -->
  <div class="action-buttons">
    <% if @reserva.canceled? %>
      <%= link_to '← Reservas Canceladas', canceladas_admin_reservas_path, class: 'btn btn-secondary' %>
    <% elsif @reserva.pending? && !@reserva.blocks_availability? %>
      <%= button_to confirm_reservation_admin_reserva_path(@reserva),
          method: :patch,
          class: 'btn btn-success',
          form_class: 'd-inline',
          data: { turbo_confirm: 'Confirmar a reserva e bloquear estas datas?' } do %>
        <i class="bi bi-calendar-check"></i> Reservado
      <% end %>
    <% end %>
    <% unless @reserva.canceled? %>
      <%= link_to '✏️ Editar Reserva', edit_admin_reserva_path(@reserva), class: 'btn btn-primary' %>
      <%= link_to export_sheets_admin_reservas_path(redirect_to: 'show', id: @reserva.id), class: 'btn btn-warning', style: "background: #f59e0b; color: white;", data: { turbo_method: :get } do %>
        <i class="bi bi-cloud-upload"></i> Sincronizar com Sheets
      <% end %>
      <%= button_to cancel_admin_reserva_path(@reserva),
          method: :patch,
          class: 'btn btn-danger',
          form_class: 'd-inline',
          data: { turbo_confirm: 'Cancelar esta reserva? Ela sairá da operação ativa, mas o histórico será preservado.' } do %>
        <i class="bi bi-x-circle"></i> Cancelar reserva
      <% end %>
      <%= link_to '← Voltar', admin_reservas_summary_path, class: 'btn btn-secondary' %>
    <% end %>
  </div>
</div>

<script>
  (function() {
    function setupReservationPaymentCopy() {
      var button = document.getElementById("copy-reservation-payment-message");
      var textarea = document.getElementById("reservation-payment-message");
      var feedback = document.getElementById("copy-reservation-payment-feedback");

      if (!button || !textarea || button.dataset.copyReady === "true") return;
      button.dataset.copyReady = "true";

      button.addEventListener("click", function() {
        var text = textarea.value;

        function showFeedback() {
          feedback.style.display = "block";
          button.textContent = "Mensagem copiada";
        }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(showFeedback).catch(function() {
            textarea.select();
            document.execCommand("copy");
            showFeedback();
          });
        } else {
          textarea.select();
          document.execCommand("copy");
          showFeedback();
        }
      });
    }

    document.addEventListener("DOMContentLoaded", setupReservationPaymentCopy);
    document.addEventListener("turbo:load", setupReservationPaymentCopy);
  })();
</script>
