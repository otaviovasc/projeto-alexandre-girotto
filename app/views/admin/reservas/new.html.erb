<% partnership_form = @partnership_form.present? %>
<% form_url = partnership_form ? partnership_reservas_path : admin_reservas_path %>

<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4"><%= partnership_form ? 'Nova Reserva de Parceria' : 'Nova Reserva' %></h1>

  <%= form_with model: @reserva, url: form_url, local: true, html: { class: 'needs-validation' } do |form| %>
    
    <!-- Toggle para criar novo usuário -->
    <% unless partnership_form %>
      <div class="form-check mb-3">
        <%= check_box_tag 'create_user', 'true', false, id: 'create_user_toggle', class: 'form-check-input' %>
        <%= label_tag 'create_user_toggle', 'Criar Novo Usuário?', class: 'form-check-label' %>
      </div>
    <% end %>

    <!-- Campos para novo usuário -->
    <div id="new_user_fields" style="<%= partnership_form ? '' : 'display:none;' %>" class="border rounded p-3 mb-4">
      <h5 class="mb-3"><%= partnership_form ? 'Dados do Hóspede' : 'Detalhes do Novo Usuário' %></h5>
      
      <div class="mb-3">
        <%= label_tag :name, 'Nome *', class: 'form-label' %>
        <%= text_field_tag 'user[name]', nil, class: 'form-control', required: true %>
      </div>

      <div class="mb-3">
        <%= label_tag :email, 'E-mail *', class: 'form-label' %>
        <%= text_field_tag 'user[email]', nil, class: 'form-control', type: 'email', required: true %>
      </div>

      <div class="mb-3">
        <%= label_tag :telephone, 'Telefone', class: 'form-label' %>
        <small class="text-muted">(opcional)</small>
        <%= text_field_tag 'user[telephone]', nil, class: 'form-control', id: 'telephone_field' %>
      </div>

      <% if partnership_form %>
        <%= hidden_field_tag 'user[partner]', 'true' %>
      <% else %>
        <div class="form-check mb-3">
          <%= check_box_tag 'user[partner]', 'true', false, id: 'partner_checkbox', class: 'form-check-input' %>
          <%= label_tag 'partner_checkbox', 'É Parceiro?', class: 'form-check-label' %>
        </div>
      <% end %>
    </div>

    <!-- Seleção de usuário existente -->
    <% unless partnership_form %>
      <div id="existing_user_fields" class="mb-3">
        <%= form.label :user_id, 'Selecionar Usuário *', class: 'form-label' %>
        <%= form.collection_select :user_id, User.all, :id, :email, { prompt: 'Selecione um usuário' }, { class: 'form-select', required: true, id: 'user_select' } %>
      </div>
    <% end %>

    <!-- Seleção de cabana -->
    <div class="mb-3">
      <%= form.label :cabana_id, 'Cabana *', class: 'form-label' %>
      <%= form.collection_select :cabana_id, Cabana.all, :id, :name, { prompt: 'Selecione uma cabana' }, { class: 'form-select', id: 'reserva_cabana_id', required: true } %>
    </div>

    <!-- Seleção de datas -->
    <div class="mb-3" id="date-selection">
      <label for="reservation_date_range" class="form-label">Selecione as datas *</label>
      <input type="text" id="reservation_date_range" placeholder="Selecione as datas" class="form-control" required />
      <%= form.hidden_field :start_date, id: "start_date", required: true %>
      <%= form.hidden_field :end_date, id: "end_date", required: true %>
    </div>

    <!-- Preço total -->
    <div class="mb-3">
      <%= form.label :total_price, 'Preço Total *', class: 'form-label' %>
      <span class="text-muted" style="font-size: smaller;">*obs: se deixar VAZIO, o preço é calculado normalmente.</span>
      <%= form.number_field :total_price, class: 'form-control', step: '0.01', required: true, min: '0' %>
    </div>

    <!-- Observation -->
    <% if partnership_form %>
      <%= form.hidden_field :observation, value: 'Parceria' %>
    <% else %>
      <div class="mb-3">
        <%= form.label :observation, 'Observação (origem da reserva)', class: 'form-label' %>
        <%= form.text_area :observation, class: 'form-control', rows: 2, placeholder: 'Ex: Airbnb, Booking, Indicação...' %>
      </div>
    <% end %>

    <!-- Serviços -->
    <div class="mb-4" id="services-section">
      <h5 class="mb-3">Serviços</h5>
      
      <!-- Filtro por Região -->
      <div class="row mb-3">
        <div class="col-md-4">
          <label class="form-label fw-bold">Filtrar por Região</label>
          <select id="service-region-filter" class="form-control">
            <option value="">Todas as regiões</option>
            <option value="SP">São Paulo (SP)</option>
            <option value="MG">Minas Gerais (MG)</option>
          </select>
        </div>
      </div>
      
      <!-- Adicionar Serviço -->
      <div class="add-service-box border rounded p-3 mb-3" style="background: #f8fafc;">
        <div class="row align-items-end">
          <div class="col-md-4 mb-2 mb-md-0">
            <label class="form-label fw-bold">Serviço</label>
            <select id="service-select" class="form-control">
              <option value="">Selecione ou digite para buscar...</option>
              <% @services.each do |service| %>
                <option value="<%= service.id %>" 
                        data-name="<%= service.name %>" 
                        data-price="<%= service.price %>"
                        data-region="<%= service.region %>">
                  <%= service.name %> - R$ <%= number_with_precision(service.price, precision: 2) %> (<%= service.region %>)
                </option>
              <% end %>
            </select>
          </div>
          <div class="col-md-2 mb-2 mb-md-0">
            <label class="form-label fw-bold">Data *</label>
            <input type="date" id="service-date-input" class="form-control">
          </div>
          <div class="col-md-1 mb-2 mb-md-0">
            <label class="form-label fw-bold">Qtd</label>
            <input type="number" id="service-quantity-input" class="form-control" value="1" min="1">
          </div>
          <div class="col-md-3">
            <button type="button" id="add-service-btn" class="btn btn-success w-100" onclick="addServiceToList()">
              <i class="bi bi-plus-lg"></i> Adicionar
            </button>
          </div>
        </div>
        <div class="row mt-2">
          <div class="col-12">
            <label class="form-label fw-bold">📝 Observação <small class="text-muted fw-normal">(opcional)</small></label>
            <textarea id="service-observation-input" class="form-control" rows="2" placeholder="Ex: sem lactose, capricho na decoração..."></textarea>
          </div>
        </div>
      </div>
      
      <!-- Lista de Serviços Adicionados -->
      <div id="services-list-container" class="border rounded p-3" style="min-height: 100px; background: #fff;">
        <h6 class="text-muted mb-3">📋 Serviços Adicionados <small>(ordenados por data)</small></h6>
        <div id="services-list">
          <p id="no-services-msg" class="text-center text-muted py-3">Nenhum serviço adicionado ainda.</p>
        </div>
      </div>
      
      <!-- Container para hidden inputs dos serviços -->
      <div id="services-hidden-inputs"></div>
    </div>

    <!-- Botões -->
    <div class="d-flex gap-2 mt-4">
      <%= form.submit partnership_form ? 'Criar Reserva de Parceria' : 'Salvar', class: 'btn btn-primary', id: 'submit_btn' %>
      <%= link_to partnership_form ? 'Limpar' : 'Cancelar', partnership_form ? new_partnership_reserva_path : :back, class: 'btn btn-secondary' %>
    </div>

  <% end %>
</div>

<!-- Script para gerenciar lista de serviços -->
<script>
  // Array para armazenar os serviços adicionados
  let addedServices = [];
  let serviceIndex = 0;

  document.addEventListener("turbo:load", function() {
    // Inicializar Select2 para o select de serviços
    $('#service-select').select2({
      theme: 'bootstrap-5',
      width: '100%',
      placeholder: 'Selecione ou digite para buscar...',
      allowClear: true
    });

    // Filtro por região
    const regionFilter = document.getElementById('service-region-filter');
    const serviceSelect = document.getElementById('service-select');

    if (regionFilter) {
      regionFilter.addEventListener('change', function() {
        const selectedRegion = this.value;
        const options = serviceSelect.querySelectorAll('option');
        
        options.forEach(option => {
          if (option.value === '') return; // Skip placeholder
          const region = option.dataset.region;
          if (selectedRegion === '' || region === selectedRegion) {
            option.style.display = '';
            option.disabled = false;
          } else {
            option.style.display = 'none';
            option.disabled = true;
          }
        });
        
        // Resetar seleção e atualizar Select2
        $('#service-select').val('').trigger('change');
      });
    }
  });

  function addServiceToList() {
    const selectEl = document.getElementById('service-select');
    const dateInput = document.getElementById('service-date-input');
    const quantityInput = document.getElementById('service-quantity-input');
    const observationInput = document.getElementById('service-observation-input');
    
    const serviceId = selectEl.value;
    const selectedOption = selectEl.options[selectEl.selectedIndex];
    const serviceName = selectedOption.dataset.name;
    const servicePrice = parseFloat(selectedOption.dataset.price);
    const serviceDate = dateInput.value;
    const quantity = parseInt(quantityInput.value) || 1;
    const observation = observationInput ? observationInput.value.trim() : '';

    // Validações
    if (!serviceId) {
      alert('Por favor, selecione um serviço.');
      return;
    }
    if (!serviceDate) {
      alert('Por favor, selecione a data do serviço.');
      return;
    }

    // Criar objeto do serviço
    const service = {
      id: serviceIndex++,
      serviceId: serviceId,
      name: serviceName,
      price: servicePrice,
      date: serviceDate,
      quantity: quantity,
      total: servicePrice * quantity,
      observation: observation
    };

    // Adicionar ao array
    addedServices.push(service);

    // Ordenar por data
    addedServices.sort((a, b) => new Date(a.date) - new Date(b.date));

    // Renderizar lista
    renderServicesList();

    // Limpar inputs
    $('#service-select').val('').trigger('change');
    dateInput.value = '';
    quantityInput.value = '1';
    if (observationInput) observationInput.value = '';
  }

  function removeService(id) {
    addedServices = addedServices.filter(s => s.id !== id);
    renderServicesList();
  }

  function renderServicesList() {
    const listContainer = document.getElementById('services-list');
    const hiddenInputsContainer = document.getElementById('services-hidden-inputs');
    const noServicesMsg = document.getElementById('no-services-msg');

    // Limpar containers
    listContainer.innerHTML = '';
    hiddenInputsContainer.innerHTML = '';

    if (addedServices.length === 0) {
      listContainer.innerHTML = '<p id="no-services-msg" class="text-center text-muted py-3">Nenhum serviço adicionado ainda.</p>';
      return;
    }

    // Renderizar cada serviço
    addedServices.forEach((service, index) => {
      // Formatar data para exibição
      const dateObj = new Date(service.date + 'T00:00:00');
      const formattedDate = dateObj.toLocaleDateString('pt-BR');

      // Criar item visual
      const itemHtml = `
        <div class="service-list-item border rounded p-2 mb-2" style="background: #f8fafc;">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
              <span class="badge bg-primary">📅 ${formattedDate}</span>
              <strong>${service.name}</strong>
              <span class="text-muted">Qtd: ${service.quantity}</span>
              <span class="text-success fw-bold">R$ ${service.total.toFixed(2).replace('.', ',')}</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeService(${service.id})">
              <i class="bi bi-trash"></i>
            </button>
          </div>
          ${service.observation ? `<div class="mt-1" style="font-size:0.85rem; color:#475569;">📝 ${service.observation}</div>` : ''}
        </div>
      `;
      listContainer.insertAdjacentHTML('beforeend', itemHtml);

      // Criar hidden inputs
      const hiddenInputsHtml = `
        <input type="hidden" name="reserva[reserva_services_attributes][${index}][service_id]" value="${service.serviceId}">
        <input type="hidden" name="reserva[reserva_services_attributes][${index}][service_date]" value="${service.date}">
        <input type="hidden" name="reserva[reserva_services_attributes][${index}][quantity]" value="${service.quantity}">
        <input type="hidden" name="reserva[reserva_services_attributes][${index}][observation]" value="${service.observation || ''}">
      `;
      hiddenInputsContainer.insertAdjacentHTML('beforeend', hiddenInputsHtml);
    });
  }
</script>

<!-- Script para datas -->
<script>
  document.addEventListener("turbo:load", function () {
    const cabanaSelect = document.getElementById('reserva_cabana_id');
    const dateRangeInput = document.getElementById("reservation_date_range");
    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");

    function initializeFlatpickr(cabanaId) {
      if (!cabanaId) return;

      fetch(`/cabanas/${cabanaId}/unavailable_dates`)
        .then(response => response.json())
        .then(disabledDates => {
          if (dateRangeInput._flatpickr) {
            dateRangeInput._flatpickr.destroy();
          }

          flatpickr("#reservation_date_range", {
            mode: "range",
            minDate: "today",
            dateFormat: "Y-m-d",
            disable: disabledDates,
            onChange: function (selectedDates, dateStr, instance) {
              if (selectedDates.length === 2) {
                startDateInput.value = instance.formatDate(selectedDates[0], "Y-m-d");
                endDateInput.value = instance.formatDate(selectedDates[1], "Y-m-d");
                
                // Marcar o campo como válido quando as datas são selecionadas
                dateRangeInput.setCustomValidity('');
              } else {
                // Limpar os campos hidden se não há seleção completa
                startDateInput.value = '';
                endDateInput.value = '';
                dateRangeInput.setCustomValidity('Por favor, selecione as datas de início e fim');
              }
            },
            onDayCreate: function (dObj, dStr, fp, dayElem) {
              dayElem.addEventListener('mouseenter', function () {
                if (fp.selectedDates.length === 1) {
                  dayElem.classList.remove('flatpickr-disabled');
                }
              });
            }
          });
        })
        .catch(err => {
          console.error("Erro ao buscar datas indisponíveis:", err);
        });
    }

    cabanaSelect.addEventListener("change", function (e) {
      const selectedCabanaId = e.target.value;
      initializeFlatpickr(selectedCabanaId);
    });

    if (cabanaSelect.value) {
      initializeFlatpickr(cabanaSelect.value);
    }
  });
</script>

<!-- Script para toggle de criação de usuário -->
<script>
  document.addEventListener('turbo:load', function () {
    // Script para toggle de criação de usuário
    const toggle = document.getElementById('create_user_toggle');
    const userFields = document.getElementById('new_user_fields');
    const existingUserFields = document.getElementById('existing_user_fields');
    const userSelect = document.getElementById('user_select');
    
    // Inicializar Select2
    if (userSelect) {
      $('#user_select').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Selecione um usuário',
        allowClear: true
      });
    }

    // Campos obrigatórios para novo usuário
    const nameField = document.querySelector('input[name="user[name]"]');
    const emailField = document.querySelector('input[name="user[email]"]');

    if (!toggle) {
      if (nameField) nameField.setAttribute("required", "true");
      if (emailField) emailField.setAttribute("required", "true");
      return;
    }

    function updateRequiredFields() {
      if (toggle.checked) {
        // Criando novo usuário
        userFields.style.display = 'block';
        existingUserFields.style.display = 'none';
        
        // Tornar campos obrigatórios
        if (nameField) nameField.setAttribute("required", "true");
        if (emailField) emailField.setAttribute("required", "true");
        
        // Remover obrigatoriedade da seleção de usuário e limpar Select2
        userSelect.removeAttribute("required");
        $('#user_select').val(null).trigger('change');
        
      } else {
        // Usando usuário existente
        userFields.style.display = 'none';
        existingUserFields.style.display = 'block';
        
        // Remover obrigatoriedade dos campos de novo usuário
        if (nameField) nameField.removeAttribute("required");
        if (emailField) emailField.removeAttribute("required");
        
        // Tornar seleção de usuário obrigatória
        userSelect.setAttribute("required", "true");
        
        // Limpar campos de novo usuário
        if (nameField) nameField.value = "";
        if (emailField) emailField.value = "";
        const telephoneField = document.getElementById('telephone_field');
        const partnerCheckbox = document.getElementById('partner_checkbox');
        if (telephoneField) telephoneField.value = "";
        if (partnerCheckbox) partnerCheckbox.checked = false;
      }
    }

    toggle.addEventListener('change', updateRequiredFields);
    
    // Inicializar estado correto
    updateRequiredFields();
  });
</script>

