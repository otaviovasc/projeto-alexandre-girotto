<% content_for :title, "Reserva online - Villaggio Girotto" %>

<main class="min-h-screen px-4 py-8 sm:py-12">
  <div class="mx-auto max-w-5xl">
    <header class="mb-8">
      <p class="text-sm font-semibold text-[#5f755f]">Villaggio Girotto</p>
      <h1 class="mt-1 text-3xl font-semibold sm:text-5xl">Reserva online</h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-[#637066]">
        Esta é a versão de teste do checkout direto. As datas ficam pré-reservadas por 15 minutos enquanto o pagamento é finalizado.
      </p>
    </header>

    <% if @errors.present? %>
      <div class="mb-6 border-l-4 border-red-500 bg-red-50 px-4 py-3 text-sm text-red-800">
        <p class="font-semibold">Não foi possível iniciar a reserva.</p>
        <ul class="mt-2 list-disc pl-5">
          <% @errors.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: public_bookings_path, scope: :booking, method: :post, local: true, class: "space-y-6", id: "public-booking-form" do |form| %>
      <section class="border border-[#d9dfd7] bg-white p-5 shadow-sm sm:p-7">
        <h2 class="text-xl font-semibold text-[#1a2e1a]">Dados da estadia</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <div class="sm:col-span-3">
            <%= form.label :cabana_id, "Cabana", class: "block text-sm font-medium text-[#1a2e1a]" %>
            <%= form.select :cabana_id,
                options_for_select(@cabanas.map { |cabana| [cabana.name, cabana.id, { data: { filial_id: cabana.filial_id } }] }, @booking_values["cabana_id"]),
                { prompt: "Selecione a cabana" },
                required: true,
                id: "booking-cabana",
                class: "mt-2 w-full border border-[#c9d1c7] bg-white px-3 py-3 text-base focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]" %>
          </div>

          <div>
            <%= form.label :start_date, "Entrada", class: "block text-sm font-medium text-[#1a2e1a]" %>
            <%= form.date_field :start_date,
                value: @booking_values["start_date"],
                required: true,
                id: "booking-start-date",
                class: "mt-2 w-full border border-[#c9d1c7] px-3 py-3 text-base focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]" %>
          </div>

          <div>
            <%= form.label :end_date, "Saída", class: "block text-sm font-medium text-[#1a2e1a]" %>
            <%= form.date_field :end_date,
                value: @booking_values["end_date"],
                required: true,
                id: "booking-end-date",
                class: "mt-2 w-full border border-[#c9d1c7] px-3 py-3 text-base focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]" %>
          </div>
        </div>
      </section>

      <section class="border border-[#d9dfd7] bg-white p-5 shadow-sm sm:p-7">
        <h2 class="text-xl font-semibold text-[#1a2e1a]">Responsável pela reserva</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <div>
            <%= form.label :guest_name, "Nome e sobrenome", class: "block text-sm font-medium text-[#1a2e1a]" %>
            <%= form.text_field :guest_name,
                value: @booking_values["guest_name"],
                required: true,
                autocomplete: "name",
                placeholder: "Ex.: Maria Silva",
                class: "mt-2 w-full border border-[#c9d1c7] px-3 py-3 text-base focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]" %>
          </div>

          <div>
            <%= form.label :guest_email, "E-mail", class: "block text-sm font-medium text-[#1a2e1a]" %>
            <%= form.email_field :guest_email,
                value: @booking_values["guest_email"],
                required: true,
                autocomplete: "email",
                placeholder: "voce@email.com",
                class: "mt-2 w-full border border-[#c9d1c7] px-3 py-3 text-base focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]" %>
          </div>

          <div>
            <%= form.label :guest_phone, "WhatsApp", class: "block text-sm font-medium text-[#1a2e1a]" %>
            <%= form.telephone_field :guest_phone,
                value: @booking_values["guest_phone"],
                required: true,
                autocomplete: "tel",
                placeholder: "11999999999",
                class: "mt-2 w-full border border-[#c9d1c7] px-3 py-3 text-base focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]" %>
          </div>
        </div>
      </section>

      <section class="border border-[#d9dfd7] bg-white p-5 shadow-sm sm:p-7" id="services-section">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-xl font-semibold text-[#1a2e1a]">Serviços opcionais</h2>
            <p class="mt-1 text-sm text-[#637066]">A compra de serviços fica disponível apenas com mais de 10 dias de antecedência.</p>
          </div>
          <p id="services-window-warning" class="hidden border-l-4 border-amber-500 bg-amber-50 px-3 py-2 text-sm text-amber-800">
            Para datas próximas, compre apenas a hospedagem e fale pelo WhatsApp sobre os serviços.
          </p>
        </div>

        <div class="mt-5 grid gap-3">
          <% @services.each do |service| %>
            <div class="service-row grid gap-3 border border-[#e2e7df] bg-[#f9faf8] p-4 sm:grid-cols-[1fr_150px_90px] sm:items-end"
                 data-filial-id="<%= service.filial_id %>">
              <label class="flex items-start gap-3">
                <%= check_box_tag "booking[service_items][#{service.id}][selected]", "1", false, class: "service-checkbox mt-1 h-5 w-5 accent-[#315b3a]" %>
                <span>
                  <span class="block font-semibold text-[#1a2e1a]"><%= service.name %></span>
                  <span class="block text-sm text-[#637066]"><%= number_to_currency(service.price, unit: 'R$ ', separator: ',', delimiter: '.') %></span>
                </span>
              </label>

              <div>
                <label class="block text-xs uppercase tracking-wide text-[#7a857d]">Data</label>
                <%= date_field_tag "booking[service_items][#{service.id}][service_date]",
                    nil,
                    class: "service-date mt-1 w-full border border-[#c9d1c7] bg-white px-3 py-2 text-sm focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]" %>
              </div>

              <div>
                <label class="block text-xs uppercase tracking-wide text-[#7a857d]">Qtd</label>
                <%= number_field_tag "booking[service_items][#{service.id}][quantity]",
                    1,
                    min: 1,
                    class: "mt-1 w-full border border-[#c9d1c7] bg-white px-3 py-2 text-sm focus:border-[#3f6747] focus:outline-none focus:ring-1 focus:ring-[#3f6747]" %>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <section class="border border-[#d9dfd7] bg-white p-5 shadow-sm sm:p-7">
        <label class="flex items-start gap-3 text-sm leading-6 text-[#3f4b43]">
          <%= form.check_box :terms_accepted, required: true, class: "mt-1 h-5 w-5 shrink-0 accent-[#315b3a]" %>
          <span>Declaro que li, compreendi e concordo com os termos de hospedagem do Villaggio Girotto.</span>
        </label>

        <button type="submit" class="mt-6 w-full bg-[#315b3a] px-4 py-4 text-base font-semibold text-white hover:bg-[#264a2e]">
          Pré-reservar e seguir para pagamento
        </button>
      </section>
    <% end %>
  </div>
</main>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var cabanaSelect = document.getElementById("booking-cabana");
    var startInput = document.getElementById("booking-start-date");
    var endInput = document.getElementById("booking-end-date");
    var warning = document.getElementById("services-window-warning");
    var serviceRows = Array.prototype.slice.call(document.querySelectorAll(".service-row"));
    var today = new Date();
    today.setHours(0, 0, 0, 0);

    function selectedFilialId() {
      var option = cabanaSelect.options[cabanaSelect.selectedIndex];
      return option ? option.dataset.filialId : "";
    }

    function servicesAllowed() {
      if (!startInput.value) return true;

      var start = new Date(startInput.value + "T00:00:00");
      var diffDays = Math.floor((start - today) / 86400000);
      return diffDays > 10;
    }

    function syncServiceRows() {
      var filialId = selectedFilialId();
      var startDate = startInput.value;
      var endDate = endInput.value;
      var allowed = servicesAllowed();

      if (warning) warning.classList.toggle("hidden", allowed);

      serviceRows.forEach(function(row) {
        var sameFilial = !!filialId && row.dataset.filialId === filialId;
        var visible = sameFilial && allowed;
        row.classList.toggle("hidden", !visible);

        row.querySelectorAll("input").forEach(function(input) {
          input.disabled = !visible;
        });

        var dateInput = row.querySelector(".service-date");
        if (dateInput) {
          dateInput.min = startDate || "";
          dateInput.max = endDate || "";
          if (startDate && !dateInput.value) dateInput.value = startDate;
        }

        if (!visible) {
          var checkbox = row.querySelector(".service-checkbox");
          if (checkbox) checkbox.checked = false;
        }
      });
    }

    [cabanaSelect, startInput, endInput].forEach(function(element) {
      if (element) element.addEventListener("change", syncServiceRows);
    });

    syncServiceRows();
  });
</script>
