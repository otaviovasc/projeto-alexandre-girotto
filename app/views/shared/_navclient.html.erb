<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <style>
        .shadow-on-scroll {
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        }

        .menu-desktop-open {
            transform: translateX(0);
        }

        .menu-desktop-close {
            transform: translateX(-100%);
        }
    </style>
</head>

<div id="navbar" class="fixed w-full z-20 bg-white shadow-on-scroll">
    <div class="container mx-auto px-4 py-4 flex justify-between items-center">

        <!-- Hamburger Button -->
        <button id="open-menu" class="text-terracota text-3xl">
            <i class="bi bi-list-nested"></i>
        </button>

        <!-- Central Redirect Button (Flex item centered) -->
        <div class="flex-1 text-center">
            <%= link_to root_path, class: "text-xl font-bold text-black" do %>
                Villaggio Girotto
            <% end %>
        </div>

        <!-- Cart Button -->
        <div>
          <button id="cart-button" class="text-terracota text-2xl">
            <%= link_to checkout_cart_path, class: "text-xl font-bold text-black" do %>
                <i class="bi bi-cart"></i>
            <% end %>
          </button>
        </div>
    </div>
</div>

<div id="menu-overlay"
    class="fixed inset-0 z-10 bg-black opacity-0 pointer-events-none transition-opacity duration-1000">
</div>

<div id="menu-container"
    class="h-screen px-8 pt-32 pb-8 font-dm font-normal text-gray-500 fixed top-0 left-0 w-full bg-white z-50 transform -translate-x-full menu-desktop-close transition-transform duration-700 ease-in-out flex flex-col justify-between">
    <div class="fixed top-4 right-4">
        <button id="close-menu"><i class="bi bi-x text-preto-fill text-5xl"></i></button>
    </div>
    <div class="text-lg flex flex-col gap-4 leading-8">
        <a href="#"><p class="hover:text-terracota"><%= link_to "Ver Cabanas", cabanas_path %></p></a>
        <a href="#"><p class="hover:text-terracota"><%= link_to "Sustentabilidade", "/sustentabilidade" %></p></a>
        <a href="#"><p class="hover:text-terracota"><%= link_to "Experiências", "/experiencias" %></p></a>
        <a href="#"><p class="hover:text-terracota"><%= link_to "Sobre Nós", "/about" %></p></a>
        <a href="#"><p class="hover:text-terracota"><%= link_to "Logout", destroy_user_session_path, data:{ turbo_method: :delete} %></p></a>
    </div>
    <div class="flex items-center gap-4">
        <a href="/reservas"><p class="font-alice text-lg hover:text-terracota font-bold">Minhas Reservas</p></a>
    </div>
</div>

<script>
  document.addEventListener('turbo:load', function () {
    const openMenuButton = document.getElementById('open-menu');
    const closeMenuButton = document.getElementById('close-menu');
    const menuContainer = document.getElementById('menu-container');
    const menuOverlay = document.getElementById('menu-overlay');

    const isMobile = () => window.innerWidth < 768;

    // Função para abrir o menu
    function openMenu() {
      menuContainer.classList.remove('-translate-x-full', 'menu-desktop-close');
      menuContainer.classList.add('menu-desktop-open');
      menuOverlay.classList.remove('opacity-0', 'pointer-events-none');
      menuOverlay.classList.add('opacity-50');
      document.body.classList.add('overflow-hidden');
    }

    // Função para fechar o menu
    function closeMenu() {
      menuContainer.classList.add('-translate-x-full', 'menu-desktop-close');
      menuContainer.classList.remove('menu-desktop-open');
      menuOverlay.classList.add('opacity-0', 'pointer-events-none');
      menuOverlay.classList.remove('opacity-50');
      document.body.classList.remove('overflow-hidden');
    }

    // Evento para abrir o menu
    openMenuButton.addEventListener('click', function () {
      openMenu();
    });

    // Evento para fechar o menu
    closeMenuButton.addEventListener('click', function () {
      closeMenu();
    });

    // Evento ao redimensionar para garantir estado correto
    window.addEventListener('resize', function () {
      if (!isMobile()) {
        // Fecha o menu e remove overlay no desktop
        closeMenu();
      }
    });

    // Fechar menu ao clicar fora (em overlay)
    menuOverlay.addEventListener('click', function () {
      closeMenu();
    });
  });
</script>
