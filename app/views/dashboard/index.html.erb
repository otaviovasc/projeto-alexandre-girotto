<div class="container py-4">
  <h1 class="text-2xl font-bold mb-4 text-center">Painel Administrativo</h1>

  <div class="row g-4">
    <div class="col-md-3">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <i class="bi bi-people-fill fs-1 mb-3"></i>
          <h5 class="card-title">Gerenciar Usuários</h5>
          <p class="card-text">Controle e gerencie os usuários do sistema.</p>
          <%= link_to 'Acessar', admin_users_path, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <i class="bi bi-house-door-fill fs-1 mb-3"></i>
          <h5 class="card-title">Gerenciar Cabanas</h5>
          <p class="card-text">Adicione, edite ou remova cabanas.</p>
          <%= link_to 'Acessar', admin_cabanas_path, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <i class="bi bi-calendar-check-fill fs-1 mb-3"></i>
          <h5 class="card-title">Gerenciar Reservas</h5>
          <p class="card-text">Monitore e ajuste reservas ativas.</p>
          <%= link_to 'Acessar', admin_reservas_path, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <i class="bi bi-tools fs-1 mb-3"></i>
          <h5 class="card-title">Gerenciar Serviços</h5>
          <p class="card-text">Administre serviços disponíveis.</p>
          <%= link_to 'Acessar', admin_services_path, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-5 text-center">
    <p class="text-muted">Bem-vindo ao painel administrativo. Use as opções acima para gerenciar as seções principais do sistema.</p>
  </div>
</div>
