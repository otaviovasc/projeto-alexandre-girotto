<div class="container mt-4">
  <style>
    .edit-observation-btn {
      font-size: 0.8rem;
      opacity: 0.6;
    }
    .edit-observation-btn:hover {
      opacity: 1;
    }
    td:hover .edit-observation-btn {
      opacity: 1;
    }
    .observation-text {
      word-break: break-word;
    }
    .highlight-new {
      animation: highlight-fade 5s;
    }
    @keyframes highlight-fade {
      from { background-color: rgba(255, 251, 130, 0.5); }
      to { background-color: transparent; }
    }
    /* Estilo para linha de usuário parceiro */
    .partner-row {
      background: linear-gradient(90deg, 
        rgba(255, 192, 203, 0.1) 0%, 
        rgba(255, 192, 203, 0.2) 100%
      ) !important;
      border: 2px dashed #ff69b4 !important;
      border-left: 4px solid #ff1493 !important;
    }
    .partner-row td {
      border-color: rgba(255, 105, 180, 0.3) !important;
    }
    .partner-row:hover {
      background: linear-gradient(90deg, 
        rgba(255, 192, 203, 0.2) 0%, 
        rgba(255, 192, 203, 0.3) 100%
      ) !important;
    }
    .partnership-created-row {
      --bs-table-bg: #fff8db;
      --bs-table-striped-bg: #fff8db;
      --bs-table-hover-bg: #ffefad;
      background: #fff8db !important;
      border: 2px dashed #f59e0b !important;
      border-left: 5px solid #f59e0b !important;
    }
    .partnership-created-row td {
      border-color: rgba(245, 158, 11, 0.35) !important;
    }
    .partnership-created-row:hover {
      background: #ffefad !important;
    }
    .ical-date-change-row {
      --bs-table-bg: #fff7ed;
      --bs-table-striped-bg: #fff7ed;
      --bs-table-hover-bg: #ffedd5;
      background: #fff7ed !important;
      border-left: 5px solid #f97316 !important;
    }
    .ical-date-change-row td {
      border-color: #fed7aa !important;
    }
    .ical-date-change-row:hover {
      background: #ffedd5 !important;
    }
    .ical-missing-row {
      --bs-table-bg: #fff1f2;
      --bs-table-striped-bg: #fff1f2;
      --bs-table-hover-bg: #ffe4e6;
      background: #fff1f2 !important;
      border-left: 5px solid #dc3545 !important;
    }
    .ical-missing-row td {
      border-color: #f3b8be !important;
    }
    .ical-missing-row:hover {
      background: #ffe4e6 !important;
    }
    .group-created-checkbox {
      width: 1.2rem;
      height: 1.2rem;
      cursor: pointer;
    }
    .group-created-checkbox:disabled {
      cursor: wait;
      opacity: 0.6;
    }
  </style>

  <div class="container my-8 p-4 bg-light shadow-sm">
    <%= month_calendar(
          events: @reservas_calendar,
          start_date: @calendar_start_date,
          attribute: :availability_start_date,
          end_attribute: :availability_end_date,
          previous_link: "<i class='bi bi-arrow-left'></i>".html_safe,
          next_link:     "<i class='bi bi-arrow-right'></i>".html_safe,
          title: ->(start_date){ start_date.strftime('%B %Y') }
        ) do |date, reservas_for_date| %>

      <div class="day-content">
        <span class="day-number"><%= date.day %></span>

        <% reservas_for_date.each do |reserva| %>
          <% top_offset_value = @top_offset[reserva.cabana_id] || 0 %>
          <% calendar_reservation_segments(reserva, date).each do |segment| %>
            <div class="reserva-line <%= segment[:css_class] %> <%= 'operational-block' if segment[:operational] %> <%= "#{segment[:operational_type]}-block" if segment[:operational_type] %> <%= 'joins-operational' if segment[:joins_operational] %>"
                 style="--reserva-color: <%= reserva.cabana.color %>; top: <%= top_offset_value %>px;"
                 title="<%= segment[:operational_type] == 'early-checkin' ? "Early check-in ##{reserva.id}" : segment[:operational_type] == 'late-checkout' ? "Late checkout ##{reserva.id}" : "Reserva ##{reserva.id} - #{reserva.cabana.name}" %>">
              <% unless segment[:operational] %>
                <span class="reserva-line-code">#<%= reserva.id %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

    <% end %>

    <hr>

    <%= render 'legend' %>
  </div>

  <div class="d-flex gap-2 mb-4">
    <%= link_to 'Nova Reserva', new_admin_reserva_path, class: 'btn btn-primary d-flex align-items-center' %>
    <%= link_to export_csv_admin_reservas_path(request.query_parameters.merge(format: :csv)), class: 'btn btn-success d-flex align-items-center' do %>
      <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
    <% end %>
    <%= link_to export_sheets_admin_reservas_path(request.query_parameters), class: 'btn btn-warning d-flex align-items-center', data: { turbo_method: :get } do %>
      <i class="bi bi-cloud-upload me-1"></i> Enviar p/ Google Sheets
    <% end %>
    <%= link_to canceladas_admin_reservas_path, class: 'btn btn-outline-danger d-flex align-items-center' do %>
      <i class="bi bi-archive me-1"></i> Reservas Canceladas
    <% end %>
  </div>

  <div class="card p-3 mb-4 shadow-sm">
    <h4>Importar Reservas por Cabana</h4>
    <div class="d-flex flex-wrap gap-2">
      <% Cabana.all.each do |cabana| %>
        <% begin %>
          <% links = cabana.import_links.present? ? JSON.parse(cabana.import_links) : {} %>
          <% next if links.blank? %>
          <%= link_to cabana.name, select_cabana_import_admin_reservas_path(cabana_id: cabana.id), class: "btn btn-outline-success" %>
        <% rescue JSON::ParserError %>
          <%# Ignora cabanas com JSON inválido %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Busca e filtro -->
  <div class="card p-3 mb-4 shadow-sm">
    <h4 class="card-title mb-4">Buscar Reservas</h4>
    <%= search_form_for @q, url: admin_reservas_summary_path, method: :get, html: { class: "row g-3 align-items-end" } do |f| %>
      <div class="col-md-6">
        <%= label_tag :search, "Busca", class: "form-label mb-1" %>
        <%= text_field_tag :search,
            params[:search],
            class: "form-control",
            placeholder: "ID, hóspede, telefone, e-mail, cabana ou observação" %>
      </div>
      <div class="col-md-3">
        <%= f.label :payment_status_eq, "Status do Pagamento", class: "form-label mb-1" %>
        <%= f.select :payment_status_eq, 
            options_for_select([
              ['Todos', ''],
              ['Pendente', 'pending'],
              ['Aguardando Pagamento', 'waiting_payment'],
              ['Pago', 'paid'],
              ['Recusado', 'refused']
            ], selected: params.dig(:q, :payment_status_eq)), 
            {}, 
            { class: "form-select" } %>
      </div>
      <div class="col-md-3">
        <%= f.submit "Buscar", class: "btn btn-primary w-100" %>
        <%= link_to "Limpar", admin_reservas_summary_path, class: "btn btn-outline-secondary w-100 mt-2" %>
      </div>
    <% end %>
  </div>


  <!-- Estatísticas -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card text-white bg-primary shadow-sm">
        <div class="card-body">
          <h5>Total de Reservas</h5>
          <h3><%= @total_reservas %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-white bg-success shadow-sm">
        <div class="card-body">
          <h5>Receita Total</h5>
          <h3><%= number_to_currency(@total_receita, unit: "R$") %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-white bg-info shadow-sm">
        <div class="card-body">
          <h5>Reservas por Status</h5>
          <ul class="list-unstyled">
            <% @reservas_por_status.each do |status, count| %>
              <li>
                <span class="badge <%= badge_class(status) %>">
                  <%= status_translate(status) %>
                </span>
                <strong><%= count %></strong>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Lista de Reservas -->
  <div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0">Lista de Reservas</h5>
    </div>
    <% if @summary_list_limited %>
      <div class="alert alert-light border mb-0 rounded-0">
        Mostrando reservas sem grupo, alertas do iCal e as <%= Admin::ReservasController::RESERVAS_SUMMARY_RECENT_LIMIT %> reservas normais mais recentes.
        Para encontrar reservas antigas, use a busca.
      </div>
    <% else %>
      <div class="alert alert-light border mb-0 rounded-0">
        Mostrando <%= @displayed_reservas_count %> de <%= @total_reservas %> reserva(s) encontradas.
      </div>
    <% end %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Grupo</th>
            <th>Última atualização</th>
            <th>Data Início</th>
            <th>Data Fim</th>
            <th>Cabana</th>
            <th>Status</th>
            <th>Preço Total</th>
            <th>Observações</th>
            <th>Usuário</th>
            <th>Telefone</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @reservas.each do |reserva| %>
            <% row_classes = [] %>
            <% row_classes << 'partner-row' if reserva.user.partner? %>
            <% row_classes << 'partnership-created-row' if reserva.partnership_created? %>
            <% row_classes << 'ical-date-change-row' if reserva.ical_date_changed? && !reserva.ical_missing? %>
            <% row_classes << 'ical-missing-row' if reserva.ical_missing? %>
            <tr id="reserva-<%= reserva.id %>" data-updated-at="<%= reserva.updated_at.to_i %>" class="<%= row_classes.join(' ') %>">
              <td><%= reserva.id %></td>
              <td>
                <%= check_box_tag(
                      "reserva_#{reserva.id}_group_created",
                      "1",
                      reserva.group_created?,
                      class: "form-check-input group-created-checkbox",
                      data: {
                        url: update_group_created_admin_reserva_path(reserva),
                        reserva_id: reserva.id
                      },
                      title: "Grupo criado"
                    ) %>
              </td>
              <td><%= reserva.updated_at&.in_time_zone("America/Sao_Paulo")&.strftime("%d/%m/%Y - %H:%Mh") || "—" %></td>
              <td><%= reserva.start_date&.strftime("%d/%m/%y") || "—" %></td>
              <td><%= reserva.end_date&.strftime("%d/%m/%y") || "—" %></td>

              <td>
                <div class="legend-color me-2" style="background-color: <%= reserva.cabana.color %>"></div>
                <%= reserva.cabana.name %>
              </td>
              <td>
                <span class="badge <%= badge_class(reserva.payment_status) %>">
                  <%= status_translate(reserva.payment_status) %>
                </span>
                <% unless reserva.blocks_availability? %>
                  <span class="badge bg-light text-dark border ms-1">Não bloqueia datas</span>
                <% end %>
                <% if reserva.ical_missing? %>
                  <span class="badge bg-danger ms-1">Possível cancelamento iCal</span>
                <% elsif reserva.ical_date_changed? %>
                  <span class="badge bg-warning text-dark ms-1 ical-date-change-badge">Possível troca de datas</span>
                <% end %>
                <% if reserva.fnrh_reservation_id.present? || reserva.fnrh_eligible? %>
                  <span class="badge bg-secondary ms-1"><%= reserva.fnrh_status_label %></span>
                <% end %>
              </td>
              <td><%= number_to_currency(reserva.total_price, unit: "R$") %></td>
              <td>
                <% if reserva.ical_missing? %>
                  <div class="text-danger fw-semibold mb-1">
                    Sumiu do iCal em <%= reserva.ical_missing_since.strftime("%d/%m/%Y - %H:%Mh") %>
                  </div>
                <% elsif reserva.ical_date_changed? %>
                  <div class="fw-semibold mb-1 ical-date-change-message" style="color:#c2410c;">
                    Possível troca de datas no iCal em <%= reserva.ical_date_change_since.strftime("%d/%m/%Y - %H:%Mh") %>
                  </div>
                  <%= button_to acknowledge_ical_date_change_admin_reserva_path(reserva),
                      method: :patch,
                      class: "btn btn-sm btn-outline-success mb-2",
                      form_class: "d-inline" do %>
                    <i class="bi bi-check-circle me-1"></i> Concluído
                  <% end %>
                <% end %>
                <span class="observation-text"><%= reserva.observation.present? ? reserva.observation : '-' %></span>
                <a href="#" class="edit-observation-btn ms-2" data-reserva-id="<%= reserva.id %>">
                  <i class="bi bi-pencil-square text-primary"></i>
                </a>
                <div class="edit-observation-form d-none">
                  <%= form_with url: update_observation_admin_reserva_path(reserva), method: :patch, class: "d-flex" do |f| %>
                    <%= f.text_field :observation, value: reserva.observation, class: "form-control form-control-sm me-1" %>
                    <%= f.submit "Salvar", class: "btn btn-sm btn-success" %>
                    <button type="button" class="btn btn-sm btn-secondary ms-1 cancel-edit-btn">Cancelar</button>
                  <% end %>
                </div>
              </td>
              <td>
                <% if reserva.guest_name.present? %>
                  <span title="Importado via <%= reserva.user.name %>"><%= reserva.guest_name %></span>
                  <small class="d-block text-muted"><%= reserva.user.name %></small>
                <% else %>
                  <span title="<%= reserva.user.email %>"><%= reserva.user.name %></span>
                <% end %>
              </td>
              <td>
                <span title="<%= reserva.user.email %>"><%= reserva.guest_phone.presence || reserva.user.telephone %></span>
              </td>
              <td>
                <%= link_to admin_reserva_path(reserva), class: 'btn btn-sm btn-outline-primary me-1', title: 'Visualizar' do %>
                  <i class="bi bi-eye"></i>
                <% end %>
                <% if reserva.pending? && !reserva.blocks_availability? %>
                  <%= button_to confirm_reservation_admin_reserva_path(reserva),
                      method: :patch,
                      class: 'btn btn-sm btn-success mt-1',
                      form_class: 'd-inline',
                      data: { turbo_confirm: 'Confirmar a reserva e bloquear estas datas?' } do %>
                    <i class="bi bi-calendar-check me-1"></i> Reservado
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
document.addEventListener('turbo:load', function() {
  // Recupera o timestamp da última visualização (se não existir, assume 0)
  var lastSeen = parseInt(localStorage.getItem('lastSeenReservations')) || 0;

  // Timestamp atual em segundos
  var now = Math.floor(Date.now() / 1000);

  // Seleciona todas as linhas de reserva
  var rows = document.querySelectorAll('tr[id^="reserva-"]');
  rows.forEach(function(row) {
    var updatedAt = parseInt(row.getAttribute('data-updated-at'));
    // Se a reserva foi criada após a última visualização, adiciona o highlight
    if (updatedAt > lastSeen) {
      row.classList.add('highlight-new');
    }

    // Remove o destaque quando o usuário passa o mouse ou clica
    row.addEventListener('mouseover', function() {
      row.classList.remove('highlight-new');
    });
    row.addEventListener('click', function() {
      row.classList.remove('highlight-new');
    });
  });

  // Atualiza o timestamp da última visualização para o momento atual
  localStorage.setItem('lastSeenReservations', now);
});
</script>

<script>
// Código para edição inline das observações
document.addEventListener('turbo:load', function() {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  document.querySelectorAll('.group-created-checkbox').forEach(function(checkbox) {
    checkbox.addEventListener('change', function() {
      const checked = this.checked;
      const previousValue = !checked;

      this.disabled = true;

      fetch(this.dataset.url, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ group_created: checked })
      })
        .then(function(response) {
          return response.json().then(function(data) {
            return { ok: response.ok, data: data };
          });
        })
        .then(function(result) {
          if (!result.ok || !result.data.success) {
            throw new Error(result.data.error || 'Não foi possível salvar o grupo.');
          }

          checkbox.checked = result.data.group_created;
          if (result.data.sheets_synced === false) {
            alert('Grupo salvo no sistema, mas o Google Sheets não sincronizou: ' + (result.data.error || 'erro desconhecido'));
          }
          window.location.reload();
        })
        .catch(function(error) {
          checkbox.checked = previousValue;
          alert(error.message || 'Não foi possível salvar o grupo.');
        })
        .finally(function() {
          checkbox.disabled = false;
        });
    });
  });

  // Manipulador para o botão de editar observação
  document.querySelectorAll('.edit-observation-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      // Oculta o texto da observação e o botão de editar
      const td = this.closest('td');
      td.querySelector('.observation-text').classList.add('d-none');
      this.classList.add('d-none');
      // Mostra o formulário de edição
      td.querySelector('.edit-observation-form').classList.remove('d-none');
    });
  });

  // Manipulador para o botão de cancelar edição
  document.querySelectorAll('.cancel-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const td = this.closest('td');
      // Mostra o texto da observação e o botão de editar
      td.querySelector('.observation-text').classList.remove('d-none');
      td.querySelector('.edit-observation-btn').classList.remove('d-none');
      // Oculta o formulário de edição
      td.querySelector('.edit-observation-form').classList.add('d-none');
    });
  });
});
</script>
