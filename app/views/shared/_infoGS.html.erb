<head></head>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
<style>
    .swiper-pagination-bullet {
        background-color: #ccc;
        opacity: 1;
    }

    .swiper-pagination-bullet-active {
        background-color: #ffbd59;
    }

    .swiper-pagination,
    .swiper-horizontal>.swiper-pagination-bullets,
    .swiper-pagination-bullets.swiper-pagination-horizontal,
    .swiper-pagination-custom,
    .swiper-pagination-fraction {
        position: absolute;
        bottom: 1rem;
    }

    .swiper-container {
        width: 100%;
        max-width: 100%;
        overflow: hidden;
    }

    .swiper-wrapper {
        display: flex;
        flex-wrap: nowrap;
        width: 100%;
    }

    .swiper-slide {
        flex: 0 0 100%;
        max-width: 100%;
        box-sizing: border-box;
        overflow: hidden;
    }
</style>
</head>

<body>
    <div class=" py-8 px-4 overflow-hidden relative sm:p-40 mb-8">
        <div class="swiper-container swiper-infos flex flex-col gap-6">
            <div class="swiper-wrapper max-w-full mx-auto font-dm text-preto-fill">
                <div class="swiper-slide px-4">
                    <div class="flex flex-col gap-6">
                        <div class="mb-12"
                            style="background-image: url('<%= asset_path('info1.png') %>'); background-size: 80%; background-position: center; height: 300px; background-repeat:no-repeat;">
                        </div>
                        <p class="text-2xl font-alice font-bold mb-6">INFORMAÇÕES & LOCALIZAÇÃO</p>
                        <div>
                            <p class="text-base sm:max-w-8/10">Conheça o caminho até a sua cabana e como entrar nela.</p>
                            <p class="text-base sm:max-w-8/10">Leia com atenção essas informações, o acesso é simples mas saber mais sempre ajuda.</p>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide px-4">
                    <div class="flex flex-col gap-6">
                        <div class="mb-12"
                            style="background-image: url('<%= asset_path('info2.png') %>'); background-size: cover; background-position: center; height: 300px;">
                        </div>
                        <p class="text-2xl font-alice font-bold mb-6">INSTRUÇÕES DE USO</p>
                        <div>
                            <p class="text-base sm:max-w-8/10">Aprendar a utilizar itens que podem ser mais difíceis.</p>
                            <p class="text-base sm:max-w-8/10">Aqui separamos as principais dúvidas de clientes para facilitar a sua estadia.</p>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide px-4">
                    <div class="flex flex-col gap-6">
                        <div class="mb-12"
                            style="background-image: url('<%= asset_path('info3.png') %>'); background-size: 90%; background-position: center; height: 300px; background-repeat:no-repeat;">
                        </div>
                        <p class="text-2xl font-alice font-bold mb-6">SOBRE A RESERVA</p>
                        <div>
                            <p class="text-base sm:max-w-8/10">Veja informações importantes como a programação da sua estadia.</p>
                            <p class="text-base sm:max-w-8/10">Além disso, você consegue visualizar Memorial Descritivo, Politica de Cancelamento e deixar um Feedback.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </div>

    <script>
        document.addEventListener('turbo:load', function () {
            var swiper = new Swiper('.swiper-infos', {
                loop: true,
                autoplay: {
                    delay: 3000,
                },
                speed: 2000,
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                    dynamicBullets: true, // Ativa as bolinhas dinâmicas
                    dynamicMainBullets: 3, // Define o número máximo de bolinhas visíveis
                },
            });
        });
    </script>
</body>
