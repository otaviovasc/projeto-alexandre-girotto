<%# Portal da Reserva - Seleção de Serviços %>
<% content_for :title, "Meus serviços - Villaggio Girotto" %>

<div class="min-h-screen bg-[#f7f5f0]" data-portal-services-page>
  <div class="bg-[#1a2e1a] text-white px-4 py-5 shadow-lg">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <div>
        <p class="text-white/50 text-xs uppercase tracking-widest">Meus serviços</p>
        <h1 class="text-xl font-bold leading-tight"><%= @reserva.cabana.name %></h1>
      </div>

      <div class="flex items-center gap-4 shrink-0">
        <%= link_to "Início", portal_reserva_inicio_path, class: "text-white/70 hover:text-white text-xs transition" %>
        <%= button_to portal_reserva_sair_path, method: :delete, class: "flex items-center gap-1.5 text-white/60 hover:text-white text-xs transition", form_class: "inline" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        Sair
        <% end %>
      </div>
    </div>
  </div>

  <% if flash[:notice].present? || flash[:alert].present? %>
    <div class="max-w-7xl mx-auto px-4 pt-4">
      <% if flash[:notice].present? %>
        <div class="bg-green-50 border border-green-200 text-green-800 text-sm rounded-lg px-4 py-3">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="bg-red-50 border border-red-200 text-red-800 text-sm rounded-lg px-4 py-3">
          <%= flash[:alert] %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col lg:flex-row gap-6">
    <div class="flex-1 order-2 lg:order-1">
      <h2 class="text-lg font-bold text-[#1a2e1a] mb-4">Serviços disponíveis</h2>

      <% if @services.any? %>
        <div class="space-y-8">
          <% dias_semana = %w[Dom Seg Ter Qua Qui Sex Sáb] %>

          <% ordered_portal_service_groups(@services).each do |category, services| %>
            <section>
              <h3 class="text-sm font-bold text-[#1a2e1a] uppercase tracking-wider mb-3"><%= category %></h3>

              <div class="space-y-3">
                <% services.each do |service| %>
                  <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden hover:border-[#c8a96e]/70 transition">
                    <div class="p-4">
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <h4 class="font-semibold text-[#1a2e1a] text-base leading-tight"><%= service.name %></h4>

                          <% if service.portal_people_label.present? %>
                            <div class="inline-flex items-center gap-1.5 mt-2 text-[11px] font-medium text-[#5f6f61] bg-[#eef2ed] rounded px-2 py-1">
                              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19a6 6 0 00-12 0m18 0a6 6 0 00-4.5-5.81M9 7a3 3 0 11-6 0 3 3 0 016 0zm9 2a3 3 0 100-6" />
                              </svg>
                              <%= service.portal_people_label %>
                            </div>
                          <% end %>

                          <% if service.description.present? %>
                            <p class="<%= printed_photos_service?(service) ? 'text-[#7a571d] bg-[#fff8e8] border border-[#ead8ad] rounded px-3 py-2 font-medium' : 'text-gray-500' %> text-xs mt-2 leading-relaxed"><%= service.description %></p>
                          <% end %>

                          <% if (menu = portal_service_menu(service, @reserva)) %>
                            <details class="mt-3 group">
                              <summary class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1a2e1a] cursor-pointer rounded border border-[#d8c79f] bg-[#fffdf8] px-3 py-2 hover:bg-[#f8f2e5] transition">
                                <span aria-hidden="true">📅</span>
                                Ver cardápio
                              </summary>
                              <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
                                <% menu.each do |day, meal| %>
                                  <div class="border-l-2 border-[#c8a96e] pl-3 py-1">
                                    <p class="text-xs font-semibold text-[#1a2e1a]"><%= day %></p>
                                    <p class="text-xs text-gray-500 mt-0.5 leading-relaxed"><%= meal %></p>
                                  </div>
                                <% end %>
                              </div>
                            </details>
                          <% end %>
                        </div>
                        <span class="text-[#1a2e1a] font-bold text-base whitespace-nowrap"><%= number_to_currency(service_price_for(service)) %></span>
                      </div>
                    </div>

                    <div class="border-t border-gray-100 bg-[#faf9f6] px-4 py-4">
                      <%= form_with url: portal_reserva_adicionar_path, method: :post, local: true, multipart: true, class: "space-y-3", data: { portal_cart_form: true } do |f| %>
                        <%= f.hidden_field :service_id, value: service.id %>
                        <%= f.hidden_field :quantity, value: 1 %>

                        <div>
                          <label class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider mb-2 block">Data do serviço</label>
                          <% service_dates = portal_service_dates(service, @reserva) %>
                          <% if service_dates.any? %>
                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                              <% service_dates.each do |d| %>
                                <label class="flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs text-gray-700 cursor-pointer hover:border-[#c8a96e] hover:bg-[#fffdf8]">
                                  <%= check_box_tag "service_dates[]", d.to_s, false,
                                      class: "rounded border-gray-300 text-[#1a2e1a] focus:ring-[#c8a96e] w-4 h-4 cursor-pointer" %>
                                  <span><%= "#{dias_semana[d.wday]}, #{d.day}/#{d.month}" %></span>
                                </label>
                              <% end %>
                            </div>
                          <% else %>
                            <div class="rounded-lg border border-red-100 bg-red-50 px-3 py-2 text-xs text-red-700">
                              Sem datas disponíveis para este serviço nesta reserva.
                            </div>
                          <% end %>
                        </div>

                        <% if fondue_service?(service) %>
                          <div>
                            <label for="service_<%= service.id %>_fondue_choice" class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider mb-2 block">Qual fondue você deseja?</label>
                            <%= select_tag :fondue_choice,
                                options_for_select([["Selecione uma opção", ""], ["Fondue de queijo", "queijo"], ["Fondue de chocolate", "chocolate"]]),
                                id: "service_#{service.id}_fondue_choice",
                                required: true,
                                class: "w-full bg-white border border-gray-200 text-gray-700 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] transition" %>
                          </div>
                        <% end %>

                        <% if food_service_for_observation?(service) || decoration_service_for_observation?(service) %>
                          <div>
                            <label class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider mb-2 block">
                              <%= food_service_for_observation?(service) ? "Restrição alimentar ou alergia (opcional)" : "Detalhes da decoração ou surpresa (opcional)" %>
                            </label>
                            <%= f.text_area :observation,
                                rows: 2,
                                maxlength: 500,
                                id: "service_#{service.id}_observation",
                                placeholder: food_service_for_observation?(service) ? "Ex: intolerância à lactose, alergia a castanhas, sem cebola..." : "Ex: escrever 'Feliz aniversário' e preparar durante o passeio a cavalo...",
                                class: "w-full bg-white border border-gray-200 text-gray-700 placeholder-gray-300 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] transition resize-none" %>
                            <p class="text-gray-400 text-[11px] mt-1">Essa observação será enviada junto com o serviço.</p>
                          </div>
                        <% end %>

                        <% if photo_print_service?(service) %>
                          <div data-photo-print-field>
                            <label for="service_<%= service.id %>_photo_print_images" class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider mb-2 block">Fotos para impressão</label>
                            <%= file_field_tag "photo_print_images[]",
                                id: "service_#{service.id}_photo_print_images",
                                multiple: true,
                                required: true,
                                accept: "image/jpeg,image/png",
                                data: { photo_print_input: true },
                                class: "w-full bg-white border border-gray-200 text-gray-700 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] transition file:mr-3 file:rounded file:border-0 file:bg-[#eef2ed] file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-[#1a2e1a]" %>
                            <p class="text-gray-400 text-[11px] mt-1" data-photo-print-feedback>Envie de 1 a 3 fotos. Com 3 fotos, a terceira será virada para horizontal no PDF.</p>
                          </div>
                        <% end %>

                        <button type="submit" class="w-full sm:w-auto bg-[#1a2e1a] hover:bg-[#2d4a2d] text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition flex justify-center items-center gap-1.5">
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                          </svg>
                          Adicionar serviço
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded-xl border border-dashed border-gray-200 py-14 text-center text-gray-400">
          <p class="text-sm">Nenhum serviço disponível no momento.</p>
        </div>
      <% end %>
    </div>

    <div class="lg:w-80 shrink-0 order-1 lg:order-2">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 lg:sticky lg:top-4 overflow-hidden">
        <div class="bg-[#1a2e1a] px-5 py-4 flex items-center justify-between">
          <h2 class="text-white font-bold text-sm">Serviços selecionados</h2>
          <span class="bg-[#c8a96e] text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">
            <%= @portal_cart_items.count %>
          </span>
        </div>

        <div class="divide-y divide-gray-50">
          <% if @portal_cart_items.any? %>
            <% total = 0 %>
            <% grouped_cart_items = @portal_cart_items.group_by { |rs| [rs.service_id, rs.service_date, rs.observation.to_s.strip] } %>
            <% late_fee_amount = @service_purchase_late_fee_amount || 0 %>
            <% grouped_cart_items.each_value do |items| %>
              <% first_item = items.first %>
              <% quantity = items.sum { |item| item.quantity.to_i } %>
              <% subtotal = service_price_for(first_item.service) * quantity %>
              <% total += subtotal %>
              <div class="px-5 py-4 flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-[#1a2e1a] leading-tight truncate"><%= first_item.service.name %></p>
                  <p class="text-xs text-gray-400 mt-0.5">
                    <%= quantity %> <%= quantity == 1 ? "unidade" : "unidades" %>
                    <% if first_item.service_date.present? %>
                      · <%= first_item.service_date.strftime("%d/%m") %>
                    <% end %>
                  </p>
                  <% if first_item.observation.present? %>
                    <p class="text-xs text-gray-500 mt-1 leading-snug">Obs: <%= first_item.observation %></p>
                  <% end %>
                  <% if first_item.respond_to?(:photo_print_pdf) && first_item.photo_print_pdf.attached? %>
                    <p class="text-xs text-[#7a571d] mt-1 leading-snug">PDF das fotos anexado</p>
                  <% end %>
                </div>
                <div class="flex flex-col items-end gap-1 shrink-0">
                  <span class="text-sm font-semibold text-[#1a2e1a]"><%= number_to_currency(subtotal) %></span>
                  <%= button_to portal_reserva_remover_path(first_item),
                      method: :delete,
                      class: "text-gray-300 hover:text-red-400 transition",
                      title: "Remover uma unidade",
                      form: { data: { portal_cart_form: true } } do %>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6m-7 4h8m-9 0l.6 12.2A2 2 0 009.6 21h4.8a2 2 0 002-1.8L17 7M10 11v6m4-6v6M5 7h14" />
                    </svg>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if late_fee_amount.positive? %>
              <% total += late_fee_amount %>
              <div class="px-5 py-4 flex items-start justify-between gap-3 bg-[#fffaf0]">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-[#1a2e1a] leading-tight">Taxa administrativa</p>
                  <p class="text-xs text-gray-500 mt-0.5">Compra fora do prazo normal</p>
                </div>
                <span class="text-sm font-semibold text-[#1a2e1a]"><%= number_to_currency(late_fee_amount) %></span>
              </div>
            <% end %>

            <div class="px-5 py-4 bg-[#f7f5f0]">
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">Total</span>
                <span class="text-lg font-bold text-[#1a2e1a]"><%= number_to_currency(total) %></span>
              </div>
            </div>

            <div class="p-5 bg-white border-t border-gray-100">
              <%= link_to portal_reserva_revisar_servicos_path, class: "w-full bg-[#c8a96e] hover:bg-[#b09258] text-white font-bold py-3 px-4 rounded-lg shadow-sm transition flex justify-center items-center gap-2" do %>
                Finalizar compra
              <% end %>
            </div>
          <% else %>
            <div class="px-5 py-10 text-center text-gray-400">
              <p class="text-sm">Nenhum serviço adicionado ainda.</p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-4 bg-white rounded-xl border border-gray-100 shadow-sm p-5 text-sm text-gray-600">
        <p class="font-semibold text-[#1a2e1a] text-xs uppercase tracking-wider mb-3">Cabana</p>
        <p class="font-medium text-[#1a2e1a]"><%= @reserva.cabana.name %></p>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function setupPortalServicesPage() {
      setupPhotoPrintInputs();
      setupPortalCartForms();
    }

    function setupPhotoPrintInputs() {
      document.querySelectorAll("[data-photo-print-input]").forEach(function(input) {
        if (input.dataset.photoPrintReady === "true") return;
        input.dataset.photoPrintReady = "true";

        input.addEventListener("change", function() {
          preparePhotoPrintFiles(input);
        });
      });
    }

    function setupPortalCartForms() {
      document.querySelectorAll("form[data-portal-cart-form]").forEach(function(form) {
        if (form.dataset.portalCartReady === "true") return;
        form.dataset.portalCartReady = "true";

        form.addEventListener("submit", submitPortalCartForm);
      });
    }

    async function submitPortalCartForm(event) {
      event.preventDefault();

      var form = event.currentTarget;
      if (form.dataset.portalCartSubmitting === "true") return;

      var submitter = event.submitter || form.querySelector("button[type='submit'], input[type='submit']");
      var originalButtonText = submitter ? submitter.textContent : null;
      var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;

      form.dataset.portalCartSubmitting = "true";
      if (submitter) {
        submitter.disabled = true;
        submitter.classList.add("opacity-60", "cursor-wait");
        if (submitter.textContent.trim()) submitter.textContent = "Atualizando...";
      }

      try {
        var response = await fetch(form.action, {
          method: form.method || "POST",
          body: new FormData(form),
          credentials: "same-origin",
          headers: {
            "Accept": "text/html",
            "X-Requested-With": "XMLHttpRequest"
          }
        });
        var html = await response.text();
        var parser = new DOMParser();
        var nextDocument = parser.parseFromString(html, "text/html");
        var nextPage = nextDocument.querySelector("[data-portal-services-page]");
        var currentPage = document.querySelector("[data-portal-services-page]");

        if (!response.ok || !nextPage || !currentPage) {
          window.location.href = response.url || form.action;
          return;
        }

        currentPage.replaceWith(nextPage);
        if (nextDocument.title) document.title = nextDocument.title;

        setupPortalServicesPage();
        window.scrollTo({ top: scrollTop, left: 0, behavior: "auto" });
      } catch (_error) {
        if (submitter) {
          submitter.disabled = false;
          submitter.classList.remove("opacity-60", "cursor-wait");
          if (originalButtonText !== null) submitter.textContent = originalButtonText;
        }
        form.dataset.portalCartSubmitting = "false";
        form.submit();
      }
    }

    async function preparePhotoPrintFiles(input) {
      var wrapper = input.closest("[data-photo-print-field]");
      var feedback = wrapper ? wrapper.querySelector("[data-photo-print-feedback]") : null;
      var files = Array.from(input.files || []);

      input.setCustomValidity("");

      if (files.length > 3) {
        input.setCustomValidity("Envie no máximo 3 fotos.");
        if (feedback) feedback.textContent = "Envie no máximo 3 fotos.";
        return;
      }

      if (!files.length || typeof DataTransfer === "undefined") return;

      if (feedback) feedback.textContent = "Preparando fotos...";

      try {
        var compressedFiles = await Promise.all(files.map(function(file, index) {
          return compressPhoto(file, files.length === 3 && index === 2);
        }));
        var dataTransfer = new DataTransfer();
        compressedFiles.forEach(function(file) {
          dataTransfer.items.add(file);
        });
        input.files = dataTransfer.files;
        if (feedback) feedback.textContent = files.length === 3 ? "Fotos prontas. A terceira será impressa na horizontal." : "Fotos prontas para gerar o PDF.";
      } catch (_error) {
        input.setCustomValidity("Não foi possível preparar as fotos. Tente enviar JPG ou PNG.");
        if (feedback) feedback.textContent = "Não foi possível preparar as fotos. Tente enviar JPG ou PNG.";
      }
    }

    function compressPhoto(file, rotate) {
      return new Promise(function(resolve, reject) {
        if (!/^image\/(jpeg|png)$/.test(file.type)) {
          reject(new Error("Formato inválido"));
          return;
        }

        var image = new Image();
        var url = URL.createObjectURL(file);

        image.onload = function() {
          URL.revokeObjectURL(url);

          var maxSide = 1800;
          var width = image.naturalWidth || image.width;
          var height = image.naturalHeight || image.height;
          var scale = Math.min(1, maxSide / Math.max(width, height));
          var drawWidth = Math.round(width * scale);
          var drawHeight = Math.round(height * scale);
          var canvas = document.createElement("canvas");

          canvas.width = rotate ? drawHeight : drawWidth;
          canvas.height = rotate ? drawWidth : drawHeight;

          var context = canvas.getContext("2d");
          context.fillStyle = "#ffffff";
          context.fillRect(0, 0, canvas.width, canvas.height);

          if (rotate) {
            context.translate(canvas.width / 2, canvas.height / 2);
            context.rotate(Math.PI / 2);
            context.drawImage(image, -drawWidth / 2, -drawHeight / 2, drawWidth, drawHeight);
          } else {
            context.drawImage(image, 0, 0, drawWidth, drawHeight);
          }

          canvas.toBlob(function(blob) {
            if (!blob) {
              reject(new Error("Imagem inválida"));
              return;
            }

            var filename = file.name.replace(/\.[^.]+$/, "") + ".jpg";
            resolve(new File([blob], filename, { type: "image/jpeg", lastModified: Date.now() }));
          }, "image/jpeg", 0.82);
        };

        image.onerror = function() {
          URL.revokeObjectURL(url);
          reject(new Error("Imagem inválida"));
        };

        image.src = url;
      });
    }

    window.setupPortalServicesPage = setupPortalServicesPage;
    document.addEventListener("DOMContentLoaded", setupPortalServicesPage);
    document.addEventListener("turbo:load", setupPortalServicesPage);
  })();
</script>
