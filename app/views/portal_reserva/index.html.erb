<% content_for :title, "Acesso atualizado - Villaggio Girotto" %>

<div class="min-h-screen bg-gradient-to-br from-[#1a2e1a] via-[#2d4a2d] to-[#1a2e1a] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white/10 backdrop-blur-sm mb-4 border border-white/20 shadow-xl">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#c8a96e]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-white tracking-tight">Acesso atualizado</h1>
      <p class="text-white/60 mt-2 text-sm">Serviços e material do hóspede agora ficam no mesmo lugar.</p>
    </div>

    <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl shadow-2xl p-8 text-white">
      <h2 class="text-xl font-semibold">Estamos melhorando o sistema.</h2>
      <div class="mt-4 space-y-3 text-sm leading-6 text-white/70">
        <p>
          Para comprar serviços, ver serviços comprados ou acessar o material do hóspede, use o item 2 da primeira mensagem do grupo de estadia.
        </p>
        <p>
          O acesso antigo de serviços foi unificado com a página de termos e condições.
        </p>
      </div>

      <%= link_to "Abrir acesso da hospedagem",
          fnrh_terms_path,
          class: "mt-6 flex w-full items-center justify-center rounded-xl bg-[#c8a96e] px-4 py-3.5 text-sm font-semibold tracking-wide text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#b8975e]" %>
    </div>
  </div>
</div>
